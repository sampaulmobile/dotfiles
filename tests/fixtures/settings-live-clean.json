{
  "model": "opus[1m]",
  "theme": "dark",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "EXTRA": "local-only"
  },
  "voice": {
    "mode": "toggle",
    "enabled": false
  },
  "effortLevel": "medium",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v deck >/dev/null 2>&1 && exec deck hook done; exit 0",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/claude-guard-pipe-truncate",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "command": "~/dotfiles/bin/claude-statusline",
    "type": "command",
    "padding": 0
  },
  "permissions": {
    "allow": [
      "Bash(uv tree:*)",
      "Bash(git push:*)",
      "Bash(git status:*)"
    ],
    "deny": [
      "Bash(tmux kill-server:*)"
    ],
    "defaultMode": "auto"
  }
}
