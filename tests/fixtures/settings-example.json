{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status:*)",
      "Bash(uv tree:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/dotfiles/bin/claude-statusline"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/claude-guard-pipe-truncate",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/tmux-claude-attention flag-done",
            "async": true
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
