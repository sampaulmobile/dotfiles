#!/usr/bin/env bash

# Fuzzy find a project directory and create/switch to a tmux session for it.
# Based on ThePrimeagen's tmux-sessionizer. Which directories are candidates
# and how sessions are named is in bin/project-dirs-lib.
#
# Rows: live sessions first (a repo's hub session above its own worktree
# sessions — see order_sessions_hub_first), then project dirs with no session
# yet.
#   red        session waiting on a permission prompt
#   green      finished-but-unseen agent (a pane whose background subagents
#              are still live defers this — see "blue" below — until they
#              finish too)
#   blue       working, OR live background subagents ("+N" badge, the
#              dashboard's own count); dim blue = idle agent with none
#   dim        dir with no session (~-shortened path)
#   cyan       linked worktree, shown as "<~repo-path>  <origin>  ⎇ <branch>":
#              origin `agent` = harness-made under .claude/worktrees/, `wt` =
#              worktrunk sibling (the tag doubles as a filter word); a sibling
#              shows its repo's path, not its own proj.feat-x dir name.
# Keys: Enter = new session with the default agent (or switch, if the row
#   already has one); ctrl-x / Option+Enter = the other agent (fzf --expect
#   keys); ctrl-/ = lazy preview (pane snapshot for sessions, git status/log
#   for dirs).
#
# Invariant: nothing is scanned at keypress time. Row status comes only from
# caches — the snapshot's sessions and panes sources, published every ~5s by
# bin/tmux-claude-statusbar and ignored when stale, plus the attention layer's
# .done flags — and rows stream into fzf as they are produced, so the picker
# draws immediately. Anything added here that forks per project dir breaks it.

# Splits fzf's --expect output into the globals `fzf_key` (the accepting key,
# empty for a plain Enter) and `selected`. Returns 1 when nothing was
# accepted, which has two shapes: esc/ctrl-c (empty output, fzf exit 130) and
# — the trap — an accept on a query that matched NO row, where fzf prints just
# the key line ("ctrl-x\n") and exits 1. Both must return 1, or a bare key
# name gets taken for a project named `ctrl-x`.
parse_fzf_expect() {
    local out="$1"
    fzf_key=""
    selected=""
    [[ "$out" == *$'\n'* ]] || return 1
    fzf_key="${out%%$'\n'*}"
    selected="${out#*$'\n'}"
}

# Reorders the MRU-ordered session names on stdin so a repo's HUB session
# comes out above that repo's WORKTREE sessions. fzf scores `myapp` and
# `myapp_feat-x` identically for any query that matches the repo name, so
# --tiebreak=index decides, and raw MRU order alone puts whichever worktree you
# last visited above the hub.
#   A session is a worktree of hub H when its name is "H_<rest>" and H is
# itself in the list — derived from the set rather than by splitting on "_",
# or a repo whose own name contains one (web_shop) would read as a
# worktree of a hub that does not exist.
#   Groups keep their MRU position (a group sits where its most recent member
# sat) and worktrees keep MRU order within a group, so nothing but the
# hub-below-its-own-worktrees case moves.
order_sessions_hub_first() {
    awk '
        NF { name[++n] = $0 }
        END {
            # root[i] = the shortest listed name that i hangs off, so a whole
            # chain lands in ONE group; depth[i] = how many listed names i
            # hangs off, which is what orders a group (a name has strictly
            # smaller depth than anything hanging off it, so a hub can never
            # be printed below its own worktree).
            for (i = 1; i <= n; i++) {
                root[i] = name[i]
                depth[i] = 0
                shortest = 0
                for (j = 1; j <= n; j++) {
                    if (name[j] == name[i]) continue
                    if (index(name[i], name[j] "_") != 1) continue
                    depth[i]++
                    if (shortest == 0 || length(name[j]) < shortest) {
                        shortest = length(name[j])
                        root[i] = name[j]
                    }
                    if (depth[i] > maxd) maxd = depth[i]
                }
            }
            for (i = 1; i <= n; i++) {
                g = root[i]
                if (!(g in first)) first[g] = i
            }
            for (i = 1; i <= n; i++) {
                g = root[i]
                if (first[g] != i) continue
                for (d = 0; d <= maxd; d++)
                    for (k = 1; k <= n; k++)
                        if (root[k] == g && depth[k] == d) print name[k]
            }
        }
    '
}

# sessionizer_row_lists <sessions-body> <flag-keys> <panes-body>
#   sessions-body: aggregate_session_status's own line, per session
#   ("<session>\t<status>\t<pane>\t<agents>"); pass "" when the sessions
#   snapshot is stale (the caller decides that, this function does not).
#   flag-keys: newline-separated "<session>@<pane>" (the attention
#   directory's flag filenames, ".done" suffix stripped, pane WITHOUT "%" —
#   bin/tmux-claude-attention's flag_path encoding).
#   panes-body: scan_agent_panes's own 6-field line, for per-pane deferral;
#   pass "" when the panes snapshot is not fresh (every flag then shows
#   green — fail open, same rule as tmux-claude-lib's drop_deferred_flags).
#   Sets PERM_LIST/WORK_LIST/DONE_LIST/IDLE_LIST (session names,
#   leading-newlined) and BADGE_LIST ("<session>\t<agents>", sessions with
#   agents > 0 only).
#   Rules: permission -> red; a flag whose pane has no live agents -> green
#   (one still carrying live agents is dropped, same as
#   bin/tmux-claude-attention's read-time deferral); status working OR
#   agents > 0 -> blue; else idle/unknown -> dim blue.
sessionizer_row_lists() {
    local sessions_body="$1" flag_keys="$2" panes_body="$3"
    PERM_LIST=$'\n'; WORK_LIST=$'\n'; DONE_LIST=$'\n'; IDLE_LIST=$'\n'; BADGE_LIST=$'\n'

    local pane_agents=$'\n'
    local _s p _w _a _st ag
    while IFS=$'\t' read -r _s p _w _a _st ag; do
        [[ -n "$p" ]] || continue
        pane_agents+="${p}"$'\t'"${ag:--}"$'\n'
    done <<< "$panes_body"

    local name status pane agents rest
    while IFS=$'\t' read -r name status pane agents; do
        [[ -n "$name" ]] || continue
        case "$status" in
            permission) PERM_LIST+="${name}"$'\n' ;;
            working)    WORK_LIST+="${name}"$'\n' ;;
            idle|unknown)
                if [[ "$agents" != "-" ]] && (( agents > 0 )); then
                    WORK_LIST+="${name}"$'\n'
                else
                    IDLE_LIST+="${name}"$'\n'
                fi
                ;;
        esac
        if [[ "$agents" != "-" ]] && (( agents > 0 )); then
            BADGE_LIST+="${name}"$'\t'"${agents}"$'\n'
        fi
    done <<< "$sessions_body"

    local key sess pane2
    while IFS= read -r key; do
        [[ -n "$key" ]] || continue
        sess="${key%@*}"
        pane2="${key##*@}"
        rest="${pane_agents#*$'\n'"%${pane2}"$'\t'}"
        if [[ "$rest" != "$pane_agents" ]]; then
            ag="${rest%%$'\n'*}"
            [[ "$ag" != "-" ]] && (( ag > 0 )) && continue
        fi
        DONE_LIST+="${sess}"$'\n'
    done <<< "$flag_keys"
}

# Sourced (tests/test-fzf-expect.sh, tests/test-session-order.sh) rather than
# executed: hand back the helpers above and run none of the picker below.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

# ---- Options ----
SHOW_STATUS_INDICATORS=true
# -----------------

ATTN_DIR="$HOME/.cache/claude-attention"

# Plain ANSI so the terminal theme maps the colors, and so fzf --ansi strips
# them back out of the accepted line — selection parsing stays plain text.
C_RED=$'\033[31m'
C_GRN=$'\033[32m'
C_BLU=$'\033[34m'
C_IBL=$'\033[2;34m'
C_DIM=$'\033[2m'
C_CYN=$'\033[2;36m'
C_RST=$'\033[0m'

# search_dirs, project_dirs, worktree_branch and session_name_for.
source "$HOME/dotfiles/bin/project-dirs-lib"

# ---- Preview mode (invoked by fzf per highlighted row; lazy, read-only) ----
if [[ "$1" == "--preview" ]]; then
    line="$2"
    [[ "$line" == "~/"* ]] && line="$HOME/${line#\~/}"
    if [[ "$line" == /* ]]; then
        if git -C "$line" rev-parse --git-dir >/dev/null 2>&1; then
            git -C "$line" -c color.status=always status -sb 2>/dev/null
            echo
            git -C "$line" -c color.ui=always log --oneline --decorate -10 2>/dev/null
        else
            ls -1 "$line" 2>/dev/null
        fi
    else
        # "=name:" is an exact session match on the active window; bare
        # "=name" is not a valid pane target and comes back empty.
        tmux capture-pane -ep -t "=${line}:" 2>/dev/null
    fi
    exit 0
fi

# Agent helpers + new_hub_session, and the snapshot reader behind the row
# colors. Deliberately sourced BELOW the --preview exit, so the per-row
# preview invocations never pay for them.
source "$HOME/dotfiles/bin/tmux-claude-lib"
source "$HOME/dotfiles/bin/hq-snapshot"

new_agent=""   # non-empty = the override key picked the other agent

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # One tmux round trip. The MRU key falls back to session_created for
    # sessions never attached, or a headless-spawned hub sorts as blank.
    tmux_out=$(tmux display-message -p '#S' \; \
        list-sessions -F '#{?session_last_attached,#{session_last_attached},#{session_created}} #{session_name}' 2>/dev/null)
    current_session="${tmux_out%%$'\n'*}"
    existing=$(printf '%s' "${tmux_out#*$'\n'}" |
        sort -rn |
        awk -v skip="$current_session" '$2 != skip {print $2}' |
        order_sessions_hub_first)

    # The sessions/panes snapshots are ignored when stale (statusbar not
    # ticking); the .done flags are event-driven (Stop hook), so they need
    # no freshness test themselves — only the panes lookup used to defer
    # one needs the snapshot to be fresh.
    perm_list=$'\n'
    work_list=$'\n'
    done_list=$'\n'
    idle_list=$'\n'
    badge_list=$'\n'
    if [[ "$SHOW_STATUS_INDICATORS" == true ]]; then
        local sessions_body="" panes_body="" flag_keys=""
        if [[ "$(snapshot_verdict "$(snapshot_age sessions)" "$(snapshot_cadence sessions)")" == fresh ]]; then
            sessions_body=$(snapshot_read sessions)
        fi
        if [[ "$(snapshot_verdict "$(snapshot_age panes)" "$(snapshot_cadence panes)")" == fresh ]]; then
            panes_body=$(snapshot_read panes)
        fi
        shopt -s nullglob
        for _f in "$ATTN_DIR"/*.done; do
            _name="${_f##*/}"
            flag_keys+="${_name%.done}"$'\n'
        done
        shopt -u nullglob
        sessionizer_row_lists "$sessions_body" "$flag_keys" "$panes_body"
        perm_list="$PERM_LIST"; work_list="$WORK_LIST"; done_list="$DONE_LIST"
        idle_list="$IDLE_LIST"; badge_list="$BADGE_LIST"
    fi

    # Rows are two tab-separated fields, "<key>\t<display>": fzf shows and
    # matches only the display field (--with-nth 2) but returns the whole
    # line, and the key — a session name or a dir's ~-shortened path — is
    # what everything past fzf consumes. Keep colors out of the key field so
    # slicing it back out needs no ANSI stripping.
    emit_rows() {
        # Existing sessions first, in MRU order.
        local sess disp badge
        while IFS= read -r sess; do
            [[ -z "$sess" ]] && continue
            disp="$sess"
            badge="${badge_list#*$'\n'"${sess}"$'\t'}"
            # The badge rides the DISPLAY field only, never the key: fzf
            # returns the whole "key\tdisplay" line, and everything past
            # fzf slices on the key.
            [[ "$badge" != "$badge_list" ]] && disp+=" +${badge%%$'\n'*}"
            if [[ "$perm_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_RED" "$disp" "$C_RST"
            elif [[ "$done_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_GRN" "$disp" "$C_RST"
            elif [[ "$work_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_BLU" "$disp" "$C_RST"
            elif [[ "$idle_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_IBL" "$disp" "$C_RST"
            else
                printf '%s\t%s\n' "$sess" "$disp"
            fi
        done <<< "$existing"

        project_dirs

        # Then the project dirs with no session yet. A linked worktree (.git
        # is a file) renders as "<~repo-path>  <tag>  ⎇ <branch>", where the
        # repo path is padded to the widest path among ALL dir rows — plain
        # ones included — so a long plain repo name never runs through the
        # tag column of the worktree rows around it. Hence two passes: the
        # first measures, the second prints. Both stay fork-free (pattern
        # matches against a delimited string, printf -v, `read`).
        # $existing excludes the current session, so add it back here or the
        # dir you're calling from reappears as a "no session yet" row.
        local nl_existing=$'\n'"$current_session"$'\n'"$existing"$'\n'
        local dir key repo repo_disp i n repo_w padded tag_padded
        local -a row_key row_kind row_repo row_tag row_branch
        n=0
        repo_w=0
        for dir in "${project_dirs_out[@]}"; do
            session_name_for "$dir"
            [[ "$nl_existing" != *$'\n'"$session_name"$'\n'* ]] || continue
            key="$dir"
            [[ "$key" == "$HOME/"* ]] && key="~/${key#"$HOME"/}"
            row_key[n]="$key"
            if [[ -f "$dir/.git" ]]; then
                worktree_branch "$dir"
                row_kind[n]=wt
                row_branch[n]="${worktree_branch_out:-detached}"
                case "$dir" in
                    */.claude/worktrees/*)
                        repo="${dir%%/.claude/worktrees/*}"
                        row_tag[n]=agent
                        ;;
                    *)
                        # worktree_repo_out: the repo's path, not the
                        # sibling's dir name (see header).
                        repo="${worktree_repo_out:-$dir}"
                        row_tag[n]=wt
                        ;;
                esac
                repo_disp="$repo"
                [[ "$repo_disp" == "$HOME/"* ]] && repo_disp="~/${repo_disp#"$HOME"/}"
                row_repo[n]="$repo_disp"
                (( ${#repo_disp} > repo_w )) && repo_w=${#repo_disp}
            else
                row_kind[n]=dir
                (( ${#key} > repo_w )) && repo_w=${#key}
            fi
            n=$(( n + 1 ))
        done
        i=0
        while (( i < n )); do
            if [[ "${row_kind[i]}" == wt ]]; then
                printf -v padded '%-*s' "$repo_w" "${row_repo[i]}"
                printf -v tag_padded '%-5s' "${row_tag[i]}"
                printf '%s\t%s%s  %s%s%s  ⎇ %s%s\n' "${row_key[i]}" \
                    "$C_CYN" "$padded" "$C_DIM" "$tag_padded" "$C_CYN" \
                    "${row_branch[i]}" "$C_RST"
            else
                printf '%s\t%s%s%s\n' "${row_key[i]}" "$C_DIM" "${row_key[i]}" "$C_RST"
            fi
            i=$(( i + 1 ))
        done
    }

    # --tiebreak=index keeps MRU order among equal matches. --expect prints
    # the accepting key on fzf's FIRST output line, which is how the agent
    # override arrives; fzf 0.74 knows alt-enter but neither shift-enter nor
    # ctrl-enter, hence ctrl-x as the always-available twin.
    default_agent=$(agent_default)
    other_agent=$(agent_other "$default_agent")
    fzf_out=$(emit_rows | fzf --ansi --tiebreak=index \
        --delimiter '\t' --with-nth 2 \
        --expect=ctrl-x,alt-enter \
        --preview "$HOME/dotfiles/bin/tmux-sessionizer --preview {1}" \
        --preview-window 'right,55%,hidden' \
        --bind 'ctrl-/:toggle-preview')

    parse_fzf_expect "$fzf_out" || exit 0
    case "$fzf_key" in
        ctrl-x|alt-enter) new_agent="$other_agent" ;;
    esac

    # Take field 1 (the key) — a no-op when there is no tab.
    selected="${selected%%$'\t'*}"

    [[ "$selected" == "~/"* ]] && selected="$HOME/${selected#\~/}"
fi

if [[ -z $selected ]]; then
    exit 0
fi

if tmux has-session -t="$selected" 2>/dev/null; then
    selected_name="$selected"
else
    session_name_for "$selected"
    selected_name="$session_name"
fi

if tmux has-session -t="$selected_name" 2>/dev/null; then
    unpark_session "$selected_name"
else
    # Empty new_agent = the default agent (plain Enter, or the CLI form).
    new_hub_session "$selected_name" "$selected" "$new_agent"
fi

if [[ -n $TMUX ]]; then
    # Scope to the client viewing this session: run-shell/neww contexts have
    # no implicit current client, and unscoped switch-client picks one at
    # random.
    current_session=$(tmux display-message -p '#S')
    this_client=$(tmux list-clients -t "=$current_session" -F '#{client_tty}' 2>/dev/null | head -1)
    if [[ -n $this_client ]]; then
        tmux switch-client -c "$this_client" -t "$selected_name"
    else
        tmux switch-client -t "$selected_name"
    fi
else
    tmux attach-session -t "$selected_name"
fi
