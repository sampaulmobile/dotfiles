#!/usr/bin/env bash

# Fuzzy find a project directory and create/switch to a tmux session for it.
# Based on ThePrimeagen's tmux-sessionizer.
#
# Fast path: NOTHING is scanned at keypress time. Row colors come from
# ~/.cache/claude-attention/status.tsv — published every ~5s by
# tmux-claude-statusbar's already-batched pane scan — plus the attention
# layer's .done flag files (see bin/tmux-claude-attention). Entries stream
# into fzf as they're produced, so the picker draws immediately.
#
# Row colors (--ansi):
#   red       session waiting on a permission/plan prompt
#   green     session finished but unseen (.done flag)
#   blue      session actively working
#   dim blue  session with an idle claude in it
#   dim       project dir with no session yet (cyan tint = linked worktree)
#
# ctrl-/ inside fzf toggles a lazy preview: a live snapshot of the
# highlighted session's pane, or git branch/log/dirty-files for a dir.
#
# Agent choice (see the agent helpers in bin/tmux-claude-lib): Enter builds a
# new session with the default agent; ctrl-x or Option+Enter (fzf's
# alt-enter) builds it with the OTHER one — claude vs codex. Both are
# fzf-scoped keys like ctrl-/ above, not tmux bindings. On a row that already
# HAS a session all three just switch to it (the session keeps the agent it
# was built with).
#
# Worktree support (bin/project-dirs-lib): if a project directory contains a
# .bare/ subdir (the legacy bare+worktree layout — see archive/gwclone), its
# worktree subdirs are enumerated as separate entries. worktrunk-style
# sibling worktrees (~/dev/proj.feat-x, and for depth-0 entries like
# dotfiles, ~/dotfiles.feat-x) are enumerated too, as are agent worktrees
# (<repo>/.claude/worktrees/agent-<id>, made by the Agent tool's worktree
# isolation and by /feature) for every repo the sessionizer already knows
# about. Session names become "<project>_<branch>" (slashes in the branch
# sanitized to "-", matching worktrunk) so two projects with the same branch
# name don't collide, and an agent worktree lands on the same session name
# as a `wt switch -c` sibling for that branch.
#
# Rows for a linked worktree (.git is a file — any of the three kinds above)
# render as two fzf fields, "<key>\t<display>": the picker shows only the
# display field, "<~repo-path>  ⎇ <branch>" (agent worktrees add a dim
# "agent" tag), cyan-tinted like today; the key (what's actually selected)
# is unchanged — the worktree's own ~-shortened path.

# Split fzf's --expect output into the globals `fzf_key` (the accepting key,
# empty for a plain Enter) and `selected` (the chosen row). fzf prints the key
# on line 1 and the selection on line 2, so real output ALWAYS contains a
# newline; `$(...)` then strips the trailing one.
#
# No newline at all means nothing was accepted, in two shapes: esc/ctrl-c
# (empty output, fzf exit 130) and — the trap — an accept on a query that
# matched NO row, where fzf prints just the key line ("ctrl-x\n") and exits 1.
# Returning 1 for both keeps a bare key name from being taken for a project
# named `ctrl-x`, and makes plain Enter on an empty match list a no-op, as it
# was before --expect.
parse_fzf_expect() {
    local out="$1"
    fzf_key=""
    selected=""
    [[ "$out" == *$'\n'* ]] || return 1
    fzf_key="${out%%$'\n'*}"
    selected="${out#*$'\n'}"
}

# Sourced (tests/test-fzf-expect.sh) rather than executed: hand back the
# helpers above and run none of the picker below. Executed normally,
# BASH_SOURCE[0] is $0 and this is a no-op.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

# ---- Options ----
SHOW_STATUS_INDICATORS=true
# -----------------

ATTN_DIR="$HOME/.cache/claude-attention"

# Row colors (plain ANSI so the terminal theme maps them; fzf --ansi strips
# them from the output line, so selection parsing stays plain-text).
C_RED=$'\033[31m'
C_GRN=$'\033[32m'
C_BLU=$'\033[34m'
C_IBL=$'\033[2;34m'
C_DIM=$'\033[2m'
C_CYN=$'\033[2;36m'
C_RST=$'\033[0m'

# ---- Project directories ----
# search_dirs defaults, the .local override, project_dirs, worktree_branch
# and session_name_for all live in bin/project-dirs-lib now — shared with
# bin/worktree-doctor, bin/wt-tmux-jump and bin/wt-tmux-cleanup. See that
# file for the search_dirs "path:depth" contract and the naming rule.
source "$HOME/dotfiles/bin/project-dirs-lib"
# ------------------------------

# ---- Preview mode (invoked by fzf per highlighted row; lazy, read-only) ----
if [[ "$1" == "--preview" ]]; then
    line="$2"
    [[ "$line" == "~/"* ]] && line="$HOME/${line#\~/}"
    if [[ "$line" == /* ]]; then
        # dir row: git overview, plain listing for non-repos
        if git -C "$line" rev-parse --git-dir >/dev/null 2>&1; then
            git -C "$line" -c color.status=always status -sb 2>/dev/null
            echo
            git -C "$line" -c color.ui=always log --oneline --decorate -10 2>/dev/null
        else
            ls -1 "$line" 2>/dev/null
        fi
    else
        # session row: live snapshot of its active pane ("=name:" = exact
        # session match, active window — bare "=name" is not a valid pane
        # target and comes back empty)
        tmux capture-pane -ep -t "=${line}:" 2>/dev/null
    fi
    exit 0
fi
# ----------------------------------------------------------------------------

# Agent helpers + new_hub_session. Sourced past the --preview early exit
# above, so the per-row preview invocations never pay for it; defining
# functions costs no forks, and the picker needs agent_default for its
# header line.
source "$HOME/dotfiles/bin/tmux-claude-lib"

new_agent=""   # non-empty = the override key picked the other agent

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # One tmux round trip: current session name, then every session stamped
    # with its MRU key (last_attached, falling back to created for sessions
    # never attached — headless-spawned hubs would otherwise sort as blank).
    tmux_out=$(tmux display-message -p '#S' \; \
        list-sessions -F '#{?session_last_attached,#{session_last_attached},#{session_created}} #{session_name}' 2>/dev/null)
    current_session="${tmux_out%%$'\n'*}"
    existing=$(printf '%s' "${tmux_out#*$'\n'}" |
        sort -rn |
        awk -v skip="$current_session" '$2 != skip {print $2}')

    # Status lists for row colors — read from caches only, never scanned
    # here. status.tsv is ignored when stale (statusbar not ticking); the
    # .done flags are event-driven (Stop hook) so they're always current.
    perm_list=$'\n'
    work_list=$'\n'
    done_list=$'\n'
    idle_list=$'\n'
    if [[ "$SHOW_STATUS_INDICATORS" == true ]]; then
        status_cache="$ATTN_DIR/status.tsv"
        if [[ -f "$status_cache" ]]; then
            cache_mtime=$(stat -f '%m' "$status_cache" 2>/dev/null || stat -c '%Y' "$status_cache" 2>/dev/null)
            if [[ -n "$cache_mtime" ]] && (( $(date +%s) - cache_mtime <= 15 )); then
                # 3rd field (worst-status pane) is for C-y's jump, not rows
                while IFS=$'\t' read -r _name _status _; do
                    [[ -z "$_name" ]] && continue
                    case "$_status" in
                        permission)   perm_list+="${_name}"$'\n' ;;
                        working)      work_list+="${_name}"$'\n' ;;
                        # unknown = claude pane whose content didn't classify;
                        # still "has a claude in it" for the tint's purposes
                        idle|unknown) idle_list+="${_name}"$'\n' ;;
                    esac
                done < "$status_cache"
            fi
        fi
        shopt -s nullglob
        for _f in "$ATTN_DIR"/*.done; do
            _name="${_f##*/}"
            _name="${_name%.done}"
            # flags are per pane, "<session>@<pane>.done" — rows are per
            # session, so strip the pane suffix (legacy pane-less flags
            # pass through unchanged)
            done_list+="${_name%@*}"$'\n'
        done
        shopt -u nullglob
    fi

    # Rows are two tab-separated fields, "<key>\t<display>": fzf shows only
    # the display field (--with-nth 2) and matches against it, but the FULL
    # line (both fields) is what comes back on selection — see the parse
    # below. Key is exactly what a row's single field was before this
    # split (a session name, or a dir's ~-shortened path) so the mapping
    # code past fzf needs no change; only display differs, and only for
    # linked-worktree dir rows. Key never carries color codes, so slicing
    # it back out after selection needs no ANSI-stripping care.
    #
    # Everything below streams straight into fzf so it draws immediately.
    emit_rows() {
        # Existing sessions first (MRU order), colored by status. Key ==
        # display (both the session name) — unchanged text and colors.
        local sess
        while IFS= read -r sess; do
            [[ -z "$sess" ]] && continue
            if [[ "$perm_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_RED" "$sess" "$C_RST"
            elif [[ "$done_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_GRN" "$sess" "$C_RST"
            elif [[ "$work_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_BLU" "$sess" "$C_RST"
            elif [[ "$idle_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_IBL" "$sess" "$C_RST"
            else
                printf '%s\t%s\n' "$sess" "$sess"
            fi
        done <<< "$existing"

        # Then project dirs not yet opened as sessions (search_dirs +
        # agent/worktrunk worktrees — see bin/project-dirs-lib).
        project_dirs

        # Filter out dirs that already have a session (builtin pattern match
        # against a delimited string — no fork per check), emit ~-shortened
        # and dimmed; a linked worktree (.git is a file) gets a cyan tint,
        # displayed as "<~repo-path>  ⎇ <branch>" (agent worktrees add a dim
        # "agent" tag so the two origins are distinguishable).
        # $existing excludes the current session, so add it back here or the
        # dir you're calling from reappears as a "no session yet" row.
        local nl_existing=$'\n'"$current_session"$'\n'"$existing"$'\n'
        local dir key repo tag branch repo_disp
        for dir in "${project_dirs_out[@]}"; do
            session_name_for "$dir"
            if [[ "$nl_existing" != *$'\n'"$session_name"$'\n'* ]]; then
                key="$dir"
                [[ "$key" == "$HOME/"* ]] && key="~/${key#"$HOME"/}"
                if [[ -f "$dir/.git" ]]; then
                    worktree_branch "$dir"
                    branch="${worktree_branch_out:-detached}"
                    case "$dir" in
                        */.claude/worktrees/*)
                            repo="${dir%%/.claude/worktrees/*}"
                            tag=" ${C_DIM}agent${C_RST}"
                            ;;
                        *)
                            repo="$dir"
                            tag=""
                            ;;
                    esac
                    repo_disp="$repo"
                    [[ "$repo_disp" == "$HOME/"* ]] && repo_disp="~/${repo_disp#"$HOME"/}"
                    printf '%s\t%s%s  ⎇ %s%s%s\n' "$key" "$C_CYN" "$repo_disp" "$branch" "$C_RST" "$tag"
                else
                    printf '%s\t%s%s%s\n' "$key" "$C_DIM" "$key" "$C_RST"
                fi
            fi
        done
    }

    # --tiebreak=index keeps MRU order among equal matches; --ansi renders
    # the row colors and strips them from the selected line's output.
    # --delimiter/--with-nth show only the display field (2); the key (1)
    # still travels with the accepted line, which is what --preview and the
    # selection parse below read.
    # --expect makes fzf print the accepting key on its FIRST output line
    # (empty for a plain Enter), then the selection — that's how the agent
    # override arrives. fzf 0.74 knows alt-enter but neither shift-enter nor
    # ctrl-enter, hence ctrl-x as the always-available twin.
    default_agent=$(agent_default)
    other_agent=$(agent_other "$default_agent")
    fzf_out=$(emit_rows | fzf --ansi --tiebreak=index \
        --delimiter '\t' --with-nth 2 \
        --expect=ctrl-x,alt-enter \
        --header "⏎ new: ${default_agent} · ⌥⏎/^x new: ${other_agent}" \
        --preview "$HOME/dotfiles/bin/tmux-sessionizer --preview {1}" \
        --preview-window 'right,55%,hidden' \
        --bind 'ctrl-/:toggle-preview')

    # Nothing accepted (see parse_fzf_expect): esc/ctrl-c, or an accept on a
    # query that matched no row.
    parse_fzf_expect "$fzf_out" || exit 0
    case "$fzf_key" in
        ctrl-x|alt-enter) new_agent="$other_agent" ;;
    esac

    # Take field 1 (the key) — a no-op when there's no tab, i.e. the
    # one-argument CLI form below that sets $selected directly.
    selected="${selected%%$'\t'*}"

    # Re-expand the ~-shortened display path
    [[ "$selected" == "~/"* ]] && selected="$HOME/${selected#\~/}"
fi

if [[ -z $selected ]]; then
    exit 0
fi

# If the selection is an existing session name (not a path), use it directly
if tmux has-session -t="$selected" 2>/dev/null; then
    selected_name="$selected"
else
    session_name_for "$selected"
    selected_name="$session_name"
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    # standard hub layout (agent, nvim, zsh) — shared with wt-tmux-jump.
    # Empty new_agent = the default agent (plain Enter, or the one-argument
    # CLI form).
    new_hub_session "$selected_name" "$selected" "$new_agent"
fi

if [[ -n $TMUX ]]; then
    # scope to the client viewing this session (run-shell/neww contexts have
    # no implicit current client — unscoped switch-client picks arbitrarily)
    current_session=$(tmux display-message -p '#S')
    this_client=$(tmux list-clients -t "=$current_session" -F '#{client_tty}' 2>/dev/null | head -1)
    if [[ -n $this_client ]]; then
        tmux switch-client -c "$this_client" -t "$selected_name"
    else
        tmux switch-client -t "$selected_name"
    fi
else
    tmux attach-session -t "$selected_name"
fi
