#!/usr/bin/env bash

# Fuzzy find a project directory and create/switch to a tmux session for it.
# Based on ThePrimeagen's tmux-sessionizer. What the rows, colors and keys
# mean is in the repo's CLAUDE.md; which directories are candidates and how
# sessions are named is in bin/project-dirs-lib.
#
# Invariant: nothing is scanned at keypress time. Row status comes only from
# caches — ~/.cache/claude-attention/status.tsv, published every ~5s by
# bin/tmux-claude-statusbar and ignored when stale, plus the attention layer's
# .done flags — and rows stream into fzf as they are produced, so the picker
# draws immediately. Anything added here that forks per project dir breaks it.

# Splits fzf's --expect output into the globals `fzf_key` (the accepting key,
# empty for a plain Enter) and `selected`. Returns 1 when nothing was
# accepted, which has two shapes: esc/ctrl-c (empty output, fzf exit 130) and
# — the trap — an accept on a query that matched NO row, where fzf prints just
# the key line ("ctrl-x\n") and exits 1. Both must return 1, or a bare key
# name gets taken for a project named `ctrl-x`.
parse_fzf_expect() {
    local out="$1"
    fzf_key=""
    selected=""
    [[ "$out" == *$'\n'* ]] || return 1
    fzf_key="${out%%$'\n'*}"
    selected="${out#*$'\n'}"
}

# Sourced (tests/test-fzf-expect.sh) rather than executed: hand back the
# helpers above and run none of the picker below.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

# ---- Options ----
SHOW_STATUS_INDICATORS=true
# -----------------

ATTN_DIR="$HOME/.cache/claude-attention"

# Plain ANSI so the terminal theme maps the colors, and so fzf --ansi strips
# them back out of the accepted line — selection parsing stays plain text.
C_RED=$'\033[31m'
C_GRN=$'\033[32m'
C_BLU=$'\033[34m'
C_IBL=$'\033[2;34m'
C_DIM=$'\033[2m'
C_CYN=$'\033[2;36m'
C_RST=$'\033[0m'

# search_dirs, project_dirs, worktree_branch and session_name_for.
source "$HOME/dotfiles/bin/project-dirs-lib"

# ---- Preview mode (invoked by fzf per highlighted row; lazy, read-only) ----
if [[ "$1" == "--preview" ]]; then
    line="$2"
    [[ "$line" == "~/"* ]] && line="$HOME/${line#\~/}"
    if [[ "$line" == /* ]]; then
        if git -C "$line" rev-parse --git-dir >/dev/null 2>&1; then
            git -C "$line" -c color.status=always status -sb 2>/dev/null
            echo
            git -C "$line" -c color.ui=always log --oneline --decorate -10 2>/dev/null
        else
            ls -1 "$line" 2>/dev/null
        fi
    else
        # "=name:" is an exact session match on the active window; bare
        # "=name" is not a valid pane target and comes back empty.
        tmux capture-pane -ep -t "=${line}:" 2>/dev/null
    fi
    exit 0
fi

# Agent helpers + new_hub_session. Deliberately sourced BELOW the --preview
# exit, so the per-row preview invocations never pay for it.
source "$HOME/dotfiles/bin/tmux-claude-lib"

new_agent=""   # non-empty = the override key picked the other agent

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # One tmux round trip. The MRU key falls back to session_created for
    # sessions never attached, or a headless-spawned hub sorts as blank.
    tmux_out=$(tmux display-message -p '#S' \; \
        list-sessions -F '#{?session_last_attached,#{session_last_attached},#{session_created}} #{session_name}' 2>/dev/null)
    current_session="${tmux_out%%$'\n'*}"
    existing=$(printf '%s' "${tmux_out#*$'\n'}" |
        sort -rn |
        awk -v skip="$current_session" '$2 != skip {print $2}')

    # status.tsv is ignored when stale (statusbar not ticking); the .done
    # flags are event-driven (Stop hook), so they need no freshness test.
    perm_list=$'\n'
    work_list=$'\n'
    done_list=$'\n'
    idle_list=$'\n'
    if [[ "$SHOW_STATUS_INDICATORS" == true ]]; then
        status_cache="$ATTN_DIR/status.tsv"
        if [[ -f "$status_cache" ]]; then
            cache_mtime=$(stat -f '%m' "$status_cache" 2>/dev/null || stat -c '%Y' "$status_cache" 2>/dev/null)
            if [[ -n "$cache_mtime" ]] && (( $(date +%s) - cache_mtime <= 15 )); then
                # 3rd field (worst-status pane) is for C-y's jump, not rows
                while IFS=$'\t' read -r _name _status _; do
                    [[ -z "$_name" ]] && continue
                    case "$_status" in
                        permission)   perm_list+="${_name}"$'\n' ;;
                        working)      work_list+="${_name}"$'\n' ;;
                        # unknown = an agent pane that didn't classify; still
                        # "has an agent in it" as far as the tint cares
                        idle|unknown) idle_list+="${_name}"$'\n' ;;
                    esac
                done < "$status_cache"
            fi
        fi
        shopt -s nullglob
        for _f in "$ATTN_DIR"/*.done; do
            _name="${_f##*/}"
            _name="${_name%.done}"
            # flags are per pane, "<session>@<pane>.done"; rows are per
            # session, so strip the pane suffix
            done_list+="${_name%@*}"$'\n'
        done
        shopt -u nullglob
    fi

    # Rows are two tab-separated fields, "<key>\t<display>": fzf shows and
    # matches only the display field (--with-nth 2) but returns the whole
    # line, and the key — a session name or a dir's ~-shortened path — is
    # what everything past fzf consumes. Keep colors out of the key field so
    # slicing it back out needs no ANSI stripping.
    emit_rows() {
        # Existing sessions first, in MRU order.
        local sess
        while IFS= read -r sess; do
            [[ -z "$sess" ]] && continue
            if [[ "$perm_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_RED" "$sess" "$C_RST"
            elif [[ "$done_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_GRN" "$sess" "$C_RST"
            elif [[ "$work_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_BLU" "$sess" "$C_RST"
            elif [[ "$idle_list" == *$'\n'"$sess"$'\n'* ]]; then
                printf '%s\t%s%s%s\n' "$sess" "$C_IBL" "$sess" "$C_RST"
            else
                printf '%s\t%s\n' "$sess" "$sess"
            fi
        done <<< "$existing"

        project_dirs

        # Then the project dirs with no session yet. A linked worktree (.git
        # is a file) renders as "<~repo-path>  <tag>  ⎇ <branch>", where the
        # repo path is padded to the widest path among ALL dir rows — plain
        # ones included — so a long plain repo name never runs through the
        # tag column of the worktree rows around it. Hence two passes: the
        # first measures, the second prints. Both stay fork-free (pattern
        # matches against a delimited string, printf -v, `read`).
        # $existing excludes the current session, so add it back here or the
        # dir you're calling from reappears as a "no session yet" row.
        local nl_existing=$'\n'"$current_session"$'\n'"$existing"$'\n'
        local dir key repo repo_disp i n repo_w padded tag_padded
        local -a row_key row_kind row_repo row_tag row_branch
        n=0
        repo_w=0
        for dir in "${project_dirs_out[@]}"; do
            session_name_for "$dir"
            [[ "$nl_existing" != *$'\n'"$session_name"$'\n'* ]] || continue
            key="$dir"
            [[ "$key" == "$HOME/"* ]] && key="~/${key#"$HOME"/}"
            row_key[n]="$key"
            if [[ -f "$dir/.git" ]]; then
                worktree_branch "$dir"
                row_kind[n]=wt
                row_branch[n]="${worktree_branch_out:-detached}"
                case "$dir" in
                    */.claude/worktrees/*)
                        repo="${dir%%/.claude/worktrees/*}"
                        row_tag[n]=agent
                        ;;
                    *)
                        # A worktrunk sibling shows its REPO's path (from the
                        # gitdir pointer), not its own proj.feat-x dir name,
                        # so every worktree row reads the same way.
                        repo="${worktree_repo_out:-$dir}"
                        row_tag[n]=wt
                        ;;
                esac
                repo_disp="$repo"
                [[ "$repo_disp" == "$HOME/"* ]] && repo_disp="~/${repo_disp#"$HOME"/}"
                row_repo[n]="$repo_disp"
                (( ${#repo_disp} > repo_w )) && repo_w=${#repo_disp}
            else
                row_kind[n]=dir
                (( ${#key} > repo_w )) && repo_w=${#key}
            fi
            n=$(( n + 1 ))
        done
        i=0
        while (( i < n )); do
            if [[ "${row_kind[i]}" == wt ]]; then
                printf -v padded '%-*s' "$repo_w" "${row_repo[i]}"
                printf -v tag_padded '%-5s' "${row_tag[i]}"
                printf '%s\t%s%s  %s%s%s  ⎇ %s%s\n' "${row_key[i]}" \
                    "$C_CYN" "$padded" "$C_DIM" "$tag_padded" "$C_CYN" \
                    "${row_branch[i]}" "$C_RST"
            else
                printf '%s\t%s%s%s\n' "${row_key[i]}" "$C_DIM" "${row_key[i]}" "$C_RST"
            fi
            i=$(( i + 1 ))
        done
    }

    # --tiebreak=index keeps MRU order among equal matches. --expect prints
    # the accepting key on fzf's FIRST output line, which is how the agent
    # override arrives; fzf 0.74 knows alt-enter but neither shift-enter nor
    # ctrl-enter, hence ctrl-x as the always-available twin.
    default_agent=$(agent_default)
    other_agent=$(agent_other "$default_agent")
    fzf_out=$(emit_rows | fzf --ansi --tiebreak=index \
        --delimiter '\t' --with-nth 2 \
        --expect=ctrl-x,alt-enter \
        --header "⏎ new: ${default_agent} · ⌥⏎/^x new: ${other_agent}" \
        --preview "$HOME/dotfiles/bin/tmux-sessionizer --preview {1}" \
        --preview-window 'right,55%,hidden' \
        --bind 'ctrl-/:toggle-preview')

    parse_fzf_expect "$fzf_out" || exit 0
    case "$fzf_key" in
        ctrl-x|alt-enter) new_agent="$other_agent" ;;
    esac

    # Take field 1 (the key) — a no-op when there is no tab.
    selected="${selected%%$'\t'*}"

    [[ "$selected" == "~/"* ]] && selected="$HOME/${selected#\~/}"
fi

if [[ -z $selected ]]; then
    exit 0
fi

if tmux has-session -t="$selected" 2>/dev/null; then
    selected_name="$selected"
else
    session_name_for "$selected"
    selected_name="$session_name"
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    # Empty new_agent = the default agent (plain Enter, or the CLI form).
    new_hub_session "$selected_name" "$selected" "$new_agent"
fi

if [[ -n $TMUX ]]; then
    # Scope to the client viewing this session: run-shell/neww contexts have
    # no implicit current client, and unscoped switch-client picks one at
    # random.
    current_session=$(tmux display-message -p '#S')
    this_client=$(tmux list-clients -t "=$current_session" -F '#{client_tty}' 2>/dev/null | head -1)
    if [[ -n $this_client ]]; then
        tmux switch-client -c "$this_client" -t "$selected_name"
    else
        tmux switch-client -t "$selected_name"
    fi
else
    tmux attach-session -t "$selected_name"
fi
