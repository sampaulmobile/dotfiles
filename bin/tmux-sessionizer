#!/usr/bin/env bash

# Fuzzy find a project directory and create/switch to a tmux session for it.
# Based on ThePrimeagen's tmux-sessionizer.
#
# Worktree support: if a project directory contains a .bare/ subdir (the
# legacy bare+worktree layout — see archive/gwclone), its worktree subdirs
# are enumerated as separate entries. Session names become "<project>_<branch>"
# so two projects with the same branch name don't collide.

# ---- Options ----
SHOW_PERMISSION_INDICATORS=true
# -----------------

# ---- Project directories ----
# Add entries as "path:depth"
#   depth 0 = the directory itself is a project
#   depth 1 = search one level deep for projects inside it
search_dirs=(
    "$HOME/dev:1"
    "$HOME/research:1"
    "$HOME/dotfiles:0"
)

# Machine-local override (untracked): may redefine search_dirs entirely.
# See other/tmux-sessionizer.local.example.
[[ -f "$HOME/dotfiles/other/tmux-sessionizer.local" ]] && source "$HOME/dotfiles/other/tmux-sessionizer.local"
# ------------------------------

# Compute the tmux session name for a given project/worktree path.
# - For a worktree (parent contains .bare/), uses "<project>_<branch>".
# - Otherwise, uses basename of the path.
# Dots are translated to underscores (tmux session names don't love dots).
# Writes the result to the global `session_name` to avoid a subshell fork
# per call (this runs once per candidate dir in the hot path).
session_name_for() {
    local path="$1"
    local parent="${path%/*}"
    local base="${path##*/}"
    local name
    if [[ -d "$parent/.bare" ]]; then
        name="${parent##*/}_${base}"
    else
        name="$base"
    fi
    session_name="${name//./_}"
}

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # Existing sessions sorted by most recently used (excluding current and claude-* popups)
    current_session=$(tmux display-message -p '#S')
    # If inside a claude popup, filter out the parent session instead
    if [[ "$current_session" == claude-* ]]; then
        filter_session="${current_session#claude-}"
    else
        filter_session="$current_session"
    fi
    # Single awk replaces sort+awk+grep+grep pipeline (fewer forks).
    existing=$(tmux list-sessions -F '#{session_last_attached} #{session_name}' 2>/dev/null |
        sort -rn |
        awk -v skip="$filter_session" '$2 !~ /^claude-/ && $2 != skip {print $2}')

    # Project directories not yet opened as sessions.
    # Use shell globs instead of find — no fork, much faster for shallow depth.
    shopt -s nullglob
    candidates=()
    for entry in "${search_dirs[@]}"; do
        dir="${entry%%:*}"
        depth="${entry##*:}"
        if [[ $depth -eq 0 ]]; then
            raw=("$dir")
        else
            raw=("$dir"/*/)
            raw=("${raw[@]%/}")
        fi
        # Expand worktree-layout projects (parent has .bare/) into individual worktrees.
        for cand in "${raw[@]}"; do
            if [[ -d "$cand/.bare" ]]; then
                for wt in "$cand"/*/; do
                    wt="${wt%/}"
                    [[ "${wt##*/}" == ".bare" ]] && continue
                    candidates+=("$wt")
                done
            else
                candidates+=("$cand")
            fi
        done
    done
    shopt -u nullglob

    # Annotate existing sessions with permission indicators
    if [[ "$SHOW_PERMISSION_INDICATORS" == true ]]; then
        _perm_dir=$(mktemp -d /tmp/sessionizer-perm.XXXXXX)
        while IFS= read -r _cs; do
            (
                _content=$(tmux capture-pane -t "${_cs}:1" -p -S -30 2>/dev/null | grep -v '^$' | tail -10)
                [[ -z "$_content" ]] && exit
                echo "$_content" | grep -q "to interrupt" && exit
                if echo "$_content" | grep -q "Yes" && echo "$_content" | grep -q "No"; then
                    echo "${_cs#claude-}" > "${_perm_dir}/${_cs}"
                fi
            ) &
        done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^claude-')
        wait
        _perm_sessions=$(cat "${_perm_dir}"/* 2>/dev/null)
        rm -rf "$_perm_dir"

        annotated=""
        while IFS= read -r _sess; do
            [[ -z "$_sess" ]] && continue
            if echo "$_perm_sessions" | grep -qx "$_sess"; then
                annotated+="${_sess} 🔴"$'\n'
            else
                annotated+="${_sess}"$'\n'
            fi
        done <<< "$existing"
    else
        annotated="$existing"$'\n'
    fi

    # Filter out dirs that already have a session.
    # Pad existing into a delimited string for O(1)-ish builtin pattern matching
    # (no fork per check, vs the old `echo "$existing" | grep -qx "$name"`).
    nl_existing=$'\n'"$existing"$'\n'
    new_dirs=""
    for dir in "${candidates[@]}"; do
        session_name_for "$dir"
        if [[ "$nl_existing" != *$'\n'"$session_name"$'\n'* ]]; then
            new_dirs+="$dir"$'\n'
        fi
    done

    selected=$( (
        printf '%s' "$annotated"
        printf '%s' "$new_dirs"
    ) | grep -v '^$' | fzf)

    # Strip permission indicator from selection
    [[ "$SHOW_PERMISSION_INDICATORS" == true ]] && selected="${selected% 🔴}"
fi

if [[ -z $selected ]]; then
    exit 0
fi

# If the selection is an existing session name (not a path), use it directly
if tmux has-session -t="$selected" 2>/dev/null; then
    selected_name="$selected"
else
    session_name_for "$selected"
    selected_name="$session_name"
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

# If inside a claude popup, close it and switch the parent client
# Keep the @claude_popup flag set so it auto-restores when switching back
current_session=$(tmux display-message -p '#S')
if [[ "$current_session" == claude-* ]]; then
    # the popup's own client — target it EXPLICITLY (a bare detach-client
    # from a script has no current client and silently does nothing/worse)
    popup_client=$(tmux list-clients -t "=$current_session" -F '#{client_tty}' 2>/dev/null | head -1)
    # the outer client = newest client NOT attached to a popup session
    # (don't assume it sits on this popup's own project session)
    parent_client=$(tmux list-clients -F '#{client_activity} #{client_tty} #{client_session}' 2>/dev/null \
        | awk '$3 !~ /^claude-/ {print $1, $2}' | sort -rn | awk 'NR==1 {print $2}')
    [[ -n $popup_client ]] && tmux detach-client -t "$popup_client"
    sleep 0.1
    if [[ -n $parent_client ]]; then
        tmux switch-client -c "$parent_client" -t "$selected_name"
    fi
elif [[ -n $TMUX ]]; then
    # scope to the client viewing this session (run-shell/neww contexts have
    # no implicit current client — unscoped switch-client picks arbitrarily)
    this_client=$(tmux list-clients -t "=$current_session" -F '#{client_tty}' 2>/dev/null | head -1)
    if [[ -n $this_client ]]; then
        tmux switch-client -c "$this_client" -t "$selected_name"
    else
        tmux switch-client -t "$selected_name"
    fi
else
    tmux attach-session -t "$selected_name"
fi

# Auto-restore claude popup if the target session had one active
popup_flag=$(tmux show -qv -t "$selected_name" @claude_popup 2>/dev/null)
if [[ "$popup_flag" == "1" ]]; then
    popup_session="claude-${selected_name}"
    if tmux has-session -t="$popup_session" 2>/dev/null; then
        tmux display-popup -E -w 80% -h 80% "tmux attach-session -t '$popup_session'"
    fi
fi
