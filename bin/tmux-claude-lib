#!/usr/bin/env bash

# Source, never execute. Everything here runs on the statusbar's ~5s tick, so
# the cost of a function is part of its contract: the noted fork-free and
# one-ps-per-scan rules are not style preferences.

CLAUDE_SESSIONS_DIR="$HOME/.claude/sessions"
CLAUDE_PROJECTS_DIR="$HOME/.claude/projects"

# An agent transcript with mtime within LIVE_AGENT_SECS renders as working
# (●); older renders as done/idle (◯) with its age; older than
# STALE_AGENT_SECS is hidden entirely. Rationale:
# workplans/tmux-claude-dashboard-agent-trees-plan.md.
LIVE_AGENT_SECS=120
STALE_AGENT_SECS=1800

AGENT_DEFAULT_FILE="$HOME/dotfiles/other/tmux-agent-default"

agent_default() {
    local a=""
    # `read` returns 1 on a last line with no newline, which errexit in bash
    # >= 4 would kill a caller with (bash 3.2 would not) — hence the `|| :`.
    # The trim takes trailing whitespace and a CRLF file's CR with it.
    [[ -f "$AGENT_DEFAULT_FILE" ]] && { read -r a < "$AGENT_DEFAULT_FILE" || :; }
    a="${a%%[[:space:]]*}"
    case "$a" in
        claude|codex) printf '%s' "$a" ;;
        *)            printf 'claude' ;;
    esac
}

agent_other() {
    if [[ "$1" == "codex" ]]; then printf 'claude'; else printf 'codex'; fi
}

session_agent() {
    local a
    # Pinned at creation (@agent); never infer the agent from what is running.
    # plain name: the "=" exact-match prefix that most target-session
    # arguments accept makes show-options/set-option come back empty
    a=$(tmux show-options -qv -t "$1" @agent 2>/dev/null)
    case "$a" in
        claude|codex) printf '%s' "$a" ;;
        *)            agent_default ;;
    esac
}

agent_window_name() {
    printf '%s' "$1"
}

# Only the agent window's name is pinned; nvim's stays on automatic-rename
# so it tracks whatever runs there after nvim exits.
# <agent-command> is TYPED into an initialized shell rather than passed as
# the tmux session command: a session command skips the zsh rc files, so
# other/zshrc.local env (ANTHROPIC_MODEL, TLS, ...) would be missing and the
# agent would come up on the wrong model.
# CREATION ONLY — no kill, no switch-client, no source-file, no set-hook.
new_agent_session() {
    local name="$1" dir="$2" agent="$3" cmd="$4"
    local nvim_win

    tmux new-session -ds "$name" -c "$dir" -n "$(agent_window_name "$agent")"
    # plain name, no "=" prefix: set-option's target parser rejects the
    # exact-match form outright ("no such session: =name")
    tmux set-option -t "$name" @agent "$agent"
    tmux set-option -w -t "${name}:1" automatic-rename off
    tmux send-keys -t "${name}:1" "$cmd" Enter

    nvim_win=$(tmux new-window -t "${name}:" -c "$dir" -P -F '#{window_id}')
    tmux send-keys -t "$nvim_win" "nvim" Enter

    # new-window selects what it creates, so come back to the agent
    tmux new-window -t "${name}:" -c "$dir"
    tmux select-window -t "${name}:1"
}

# `claude -n` sets the display name AND the cross-session address
# (ListAgents/SendMessage), stable across --resume. Only this front-door
# window is named; extra claude windows (tmux-claude-window) stay unnamed
# (<dir>-NN) so the session has exactly one peer address. codex: no
# equivalent.
new_hub_session() {
    local name="$1" dir="$2" agent="${3:-}"
    local peer

    [[ "$agent" == "claude" || "$agent" == "codex" ]] || agent=$(agent_default)

    if [[ "$agent" == "claude" ]]; then
        peer="$name"
        [[ -d "$dir/.git" ]] && peer="${name}-hub"
        new_agent_session "$name" "$dir" "$agent" "claude -n '$peer'"
    else
        new_agent_session "$name" "$dir" "$agent" "$agent"
    fi
}

# A non-parked session (the common case, paid on every
# sessionizer/wt-tmux-jump/dashboard visit) costs exactly one display -p and
# returns. CREATION-only per tmux-task-session's rule: display-message,
# send-keys, set-option.
unpark_session() {
    local session="$1" pane cmd tty
    IFS=$'\t' read -r pane cmd < <(tmux display -p -t "$session" $'#{@parked_pane}\t#{@parked_cmd}' 2>/dev/null)
    [[ -n "$pane" || -n "$cmd" ]] || return 0
    if [[ -n "$pane" ]] && tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1; then
        tty=$(tmux display-message -p -t "$pane" '#{pane_tty}' 2>/dev/null)
        tty="${tty#/dev/}"
        if [[ -z "$(agent_ttys | awk -v t="$tty" -F'\t' '$1==t{print; exit}')" ]]; then
            tmux send-keys -t "$pane" "$cmd" Enter
        fi
    fi
    tmux set-option -u -t "$session" @parked 2>/dev/null
    tmux set-option -u -t "$session" @parked_pane 2>/dev/null
    tmux set-option -u -t "$session" @parked_cmd 2>/dev/null
}

# Prints "<tty>\t<agent>" for every live agent process, one line per tty
# (no /dev/ prefix). Panes are identified by TTY, never by
# #{pane_current_command}: every launcher here send-keys into an
# initialized shell, so the pane command reports zsh/sh while the agent
# owns the same tty.
#
# comm matching: /codex/ for the Rust binary, /claude/ or a bare `node` for
# Claude Code (its npm bin is literally claude.exe, and a wrapper/shim shows
# as node). Exactly one ps for the whole machine — this runs on every
# statusbar tick.
#
# TIES: one tty can own both a codex and a node process (a codex running an
# npm tool, or an npm-installed codex whose node wrapper is the parent).
# codex wins — the reverse sort on the agent field puts it first and every
# lookup takes a tty's first match — because a bare `node` is the weakest of
# the three signals.
agent_ttys() {
    ps -A -o tty=,comm= 2>/dev/null | _agent_ttys_filter
}

_agent_ttys_filter() {
    awk '$1 != "??" {
             if ($2 ~ /codex/) { print $1 "\tcodex" }
             else if ($2 ~ /claude/ || $2 ~ /(^|\/)node$/) { print $1 "\tclaude" }
         }' \
        | sort -u -t$'\t' -k1,1 -k2,2r
}

# Every agent tty, agent-agnostic despite the name.
claude_ttys() {
    agent_ttys | cut -f1 | sort -u
}

# agent_ttys as one newline-delimited string with a LEADING newline, ready
# for the fork-free lookup its callers use:
#   rest="${map#*$'\n'"$tty"$'\t'}"
#   [[ "$rest" != "$map" ]] && agent="${rest%%$'\n'*}"
# Prefix stripping, not a subshell per pane: the statusbar scan has a ~200ms
# budget covering every pane on the machine.
# Returns 1 (and prints nothing) when no agent is running.
_agent_tty_map() {
    local m
    m=$(agent_ttys)
    [[ -z "$m" ]] && return 1
    printf '%s' $'\n'"$m"
}

get_claude_sessions() {
    local ttys
    ttys=$(claude_ttys)
    [[ -z "$ttys" ]] && return 0
    tmux list-panes -a -F '#{session_activity} #{session_name} #{pane_tty}' 2>/dev/null \
        | while IFS=' ' read -r act name tty; do
            case $'\n'"$ttys"$'\n' in
                *$'\n'"${tty#/dev/}"$'\n'*) echo "$act $name" ;;
            esac
        done \
        | sort -rn \
        | awk '!seen[$2]++ {print $2}'
}

# Prints one line per agent PANE — any window of any session — tab-separated:
# session_name, pane_id, window_index, agent, cwd (last, so a path holding a
# tab still reads whole). Most recently active session first, window order
# within a session; an agent outside window 1 still gets its own row.
get_claude_panes() {
    local map rest
    map=$(_agent_tty_map) || return 0
    tmux list-panes -a -F $'#{session_activity}\t#{session_name}\t#{pane_id}\t#{window_index}\t#{pane_tty}\t#{pane_current_path}' 2>/dev/null \
        | while IFS=$'\t' read -r act name pid widx tty cwd; do
            rest="${map#*$'\n'"${tty#/dev/}"$'\t'}"
            [[ "$rest" == "$map" ]] && continue
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$act" "$name" "$pid" "$widx" "${rest%%$'\n'*}" "$cwd"
        done \
        | sort -t$'\t' -k1,1rn -k4,4n \
        | cut -f2-
}

# Prints: working | idle | permission | unknown
# Pure classifier over RAW, unfiltered pane content (a straight
# `tmux capture-pane -p`): blank-line stripping and the last-10-lines
# window happen internally, so a caller that batches many panes into one
# tmux invocation can classify each block without a second capture.
# Zero forks, on purpose — filtering and tailing via 2-3 forked processes
# per session measured ~100ms+ for 17 sessions, most of the statusbar's
# 200ms budget by itself. bash 3.2: no negative array indices, no
# mapfile/readarray.
classify_pane_status() {
    local raw="$1"

    if [[ "${2:-claude}" == "codex" ]]; then
        classify_codex_pane_status "$raw"
        return
    fi

    if [[ -z "$raw" ]]; then
        echo "unknown"
        return
    fi

    local -a all filtered
    IFS=$'\n' read -rd '' -a all <<< "$raw"
    local line
    for line in "${all[@]}"; do
        [[ -n "$line" ]] && filtered+=("$line")
    done

    # Claude Code renders an agents list below the footer while the session
    # has subagents running, and a session that goes idle leaves it in the
    # last painted frame indefinitely. Its rows end in a
    # "36m 12s · ↓ 421.5k tokens" tail, so they look like the spinner and
    # crowd the window below. "← for agents" is the footer hint,
    # present whether or not the list is up, so everything after the last
    # one is chrome. Older UI generations have no such line and are left
    # whole.
    local total=${#filtered[@]} i cut=-1
    for (( i = 0; i < total; i++ )); do
        [[ "${filtered[i]}" == *"← for agents"* ]] && cut="$i"
    done
    if (( cut >= 0 )); then
        filtered=("${filtered[@]:0:$(( cut + 1 ))}")
        total=${#filtered[@]}
    fi

    if (( total == 0 )); then
        echo "unknown"
        return
    fi

    local start=0
    (( total > 10 )) && start=$(( total - 10 ))
    local -a window=("${filtered[@]:start}")

    local content="" w
    for w in "${window[@]}"; do
        if [[ -n "$content" ]]; then
            content+=$'\n'"$w"
        else
            content="$w"
        fi
    done

    # Working markers across UI generations: "esc to interrupt" (older),
    # "⎿  Running…" (tool in flight), and the spinner status line
    # "· <Verb>… (41s · ↓ 1.9k tokens)", whose only stable fragment is the
    # "s · ↓ " + "tokens" pair — the verbs are randomized. The current UI
    # emits no "esc to interrupt", so the spinner is the only live marker
    # left; it is matched PER LINE between its parentheses, since an agents
    # list row carries the same fragment bare.
    if [[ "$content" == *"to interrupt"* || "$content" == *"⎿  Running…"* ]]; then
        echo "working"
        return
    fi
    for w in "${window[@]}"; do
        if [[ "$w" == *"("*"s · ↓ "*"tokens"*")"* ]]; then
            echo "working"
            return
        fi
    done

    # Must be tested before idle: ❯ appears in the Yes/No selector too. Only
    # the selector's numbered rows count — a reply saying "Yes, exactly" above
    # "Nothing since" is prose, not a prompt.
    local sel_yes=0 sel_no=0
    for w in "${window[@]}"; do
        [[ "$w" == *[0-9]". Yes"* ]] && sel_yes=1
        [[ "$w" == *[0-9]". No"* ]] && sel_no=1
    done
    if (( sel_yes && sel_no )); then
        echo "permission"
        return
    fi

    # Plan-mode question: "Enter to select".
    local wn=${#window[@]}
    if (( wn > 0 )); then
        local last="${window[$(( wn - 1 ))]}"
        local prev=""
        (( wn > 1 )) && prev="${window[$(( wn - 2 ))]}"
        if [[ "$last" == "Enter to select"* || "$prev" == "Enter to select"* ]]; then
            echo "permission"
            return
        fi
    fi

    if [[ "$content" == *"❯"* ]]; then
        echo "idle"
        return
    fi

    echo "unknown"
}

get_session_status() {
    local session="$1"
    local agent="${2:-}"
    [[ -n "$agent" ]] || agent=$(session_agent "$session")
    local raw
    raw=$(tmux capture-pane -t "${session}:1" -p -S -30 2>/dev/null)
    classify_pane_status "$raw" "$agent"
}

get_pane_status() {
    local raw
    raw=$(tmux capture-pane -t "$1" -p -S -30 2>/dev/null)
    classify_pane_status "$raw" "${2:-claude}"
}

# One line per agent pane, any window of any session:
# "<session>\t<pane>\t<window>\t<agent>\t<status>\t<agents>", status being
# classify_pane_status's permission | working | idle | unknown and agents
# the claude pane's live background-subagent count from live_agent_counts
# ("-" for 0 and for every codex pane).
#
# Two tmux round trips regardless of session count: one list-panes -a, then
# one batched capture of ONLY the panes whose tty belongs to an agent
# (agent_ttys). Capturing agent panes only — rather than capturing broadly
# and filtering after — is also what makes a prompt-lookalike false positive
# impossible: a non-agent pane's text is never read at all.
#
# Panes are addressed by #{pane_id} (immune to renumbering) and the
# separator line carries the session, window and agent, so blocks stay
# self-labeled and correctly classified even if a pane disappears between
# the two round trips — its capture is simply empty -> "unknown", and the
# next call self-heals.
scan_agent_panes() {
    local map rest
    map=$(_agent_tty_map) || return 0

    local pane_list
    pane_list=$(tmux list-panes -a -F $'#{session_name}\t#{pane_id}\t#{window_id}\t#{pane_tty}' 2>/dev/null)
    [[ -z "$pane_list" ]] && return 0

    local -a targets=()
    local sname pid wid ptty agent claude_pane_ids=""
    while IFS=$'\t' read -r sname pid wid ptty; do
        [[ -z "$pid" ]] && continue
        rest="${map#*$'\n'"${ptty#/dev/}"$'\t'}"
        [[ "$rest" == "$map" ]] && continue
        agent="${rest%%$'\n'*}"
        targets+=("${sname}"$'\t'"${pid}"$'\t'"${wid}"$'\t'"${agent}")
        [[ "$agent" == claude ]] && claude_pane_ids+="${pid}"$'\n'
    done <<< "$pane_list"
    (( ${#targets[@]} == 0 )) && return 0

    live_agent_counts "$claude_pane_ids"

    # Randomized separator: a fixed literal could appear in pane content and
    # split a block early.
    local sep="@@CLAUDE-SCAN-$$-${RANDOM}@@"
    local -a args=()
    local entry tpane
    for entry in "${targets[@]}"; do
        rest="${entry#*$'\t'}"
        tpane="${rest%%$'\t'*}"
        # The pane id rides the separator line WITHOUT its %: display -p
        # format-expands the message and strftime eats "%2..."; the parse
        # below puts the % back.
        args+=(capture-pane -t "$tpane" -p -S -30 \; display-message -p "${sep}${entry%%$'\t'*}"$'\t'"${tpane#%}"$'\t'"${rest#*$'\t'}" \;)
    done
    local combined
    combined=$(tmux "${args[@]}" 2>/dev/null)

    local block="" line name pane st agents wid2
    while IFS= read -r line; do
        if [[ "$line" == "$sep"* ]]; then
            entry="${line#"$sep"}"
            name="${entry%%$'\t'*}"
            rest="${entry#*$'\t'}"
            pane="%${rest%%$'\t'*}"
            rest="${rest#*$'\t'}"
            wid2="${rest%%$'\t'*}"
            agent="${rest#*$'\t'}"
            st=$(classify_pane_status "$block" "$agent")
            agents="-"
            rest="${LIVE_AGENTS_OUT#*$'\n'"${pane}"$'\t'}"
            [[ "$rest" != "$LIVE_AGENTS_OUT" ]] && agents="${rest%%$'\n'*}"
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$pane" "$wid2" "$agent" "$st" "$agents"
            block=""
        else
            block+="$line"$'\n'
        fi
    done <<< "$combined"
}

# One line per session: "<session>\t<status>\t<pane>\t<agents>". Status is
# the worst across the session's agent panes (permission > working > idle >
# unknown) and pane is the id of the one exhibiting it ("-" when unknown,
# first-seen wins on a tie), which is what lets C-y land on the prompt
# itself rather than on the session's current window while the prompt
# blocks in another. agents is the SUM of the session's panes' live
# subagent counts ("-" for 0).
aggregate_session_status() {
    # Delimited strings and a first-seen order array (bash 3.2 has no
    # associative arrays), searched by prefix stripping, never command
    # substitution: this runs inside the statusbar's ~200ms scan.
    local perm_s=$'\n' work_s=$'\n' idle_s=$'\n' seen=$'\n'
    local -a order=() sums=()
    local name pane _w _a st ag rest n idx
    while IFS=$'\t' read -r name pane _w _a st ag; do
        [[ -z "$name" ]] && continue
        case "$st" in
            permission) perm_s+="${name}"$'\t'"${pane}"$'\n' ;;
            working)    work_s+="${name}"$'\t'"${pane}"$'\n' ;;
            idle)       idle_s+="${name}"$'\t'"${pane}"$'\n' ;;
        esac
        n="$ag"
        [[ "$n" == "-" || -z "$n" ]] && n=0
        if [[ "$seen" != *$'\n'"${name}"$'\n'* ]]; then
            seen+="${name}"$'\n'
            order+=("$name")
            sums+=("$n")
        else
            for idx in "${!order[@]}"; do
                if [[ "${order[idx]}" == "$name" ]]; then
                    sums[idx]=$(( sums[idx] + n ))
                    break
                fi
            done
        fi
    done <<< "$1"

    local agents
    for idx in "${!order[@]}"; do
        name="${order[idx]}"
        st="unknown"
        pane="-"
        if rest="${perm_s#*$'\n'"$name"$'\t'}"; [[ "$rest" != "$perm_s" ]]; then
            st="permission"; pane="${rest%%$'\n'*}"
        elif rest="${work_s#*$'\n'"$name"$'\t'}"; [[ "$rest" != "$work_s" ]]; then
            st="working"; pane="${rest%%$'\n'*}"
        elif rest="${idle_s#*$'\n'"$name"$'\t'}"; [[ "$rest" != "$idle_s" ]]; then
            st="idle"; pane="${rest%%$'\n'*}"
        fi
        agents="-"
        (( sums[idx] > 0 )) && agents="${sums[idx]}"
        printf '%s\t%s\t%s\t%s\n' "$name" "$st" "$pane" "$agents"
    done
}

scan_claude_sessions() {
    aggregate_session_status "$(scan_agent_panes)"
}

# "<window>\t<status>", status being permission > working > done > idle.
# Unknown counts as idle: an agent process does live there. A pane with
# agents > 0 counts as working unless its own status is permission.
window_status_from_panes() {
    local done_s=$'\n'"${2}"$'\n'
    local perm_s=$'\n' work_s=$'\n' dn_s=$'\n' seen=$'\n'
    local -a order=()
    local _n pane win _a st ag
    while IFS=$'\t' read -r _n pane win _a st ag; do
        [[ -z "$win" ]] && continue
        case "$st" in
            permission) perm_s+="${win}"$'\n' ;;
            working)    work_s+="${win}"$'\n' ;;
        esac
        if [[ "$st" != permission && "$ag" != "-" ]] && (( ag > 0 )); then
            work_s+="${win}"$'\n'
        fi
        [[ "$done_s" == *$'\n'"${pane}"$'\n'* ]] && dn_s+="${win}"$'\n'
        if [[ "$seen" != *$'\n'"${win}"$'\n'* ]]; then
            seen+="${win}"$'\n'
            order+=("$win")
        fi
    done <<< "$1"

    for win in "${order[@]}"; do
        if [[ "$perm_s" == *$'\n'"${win}"$'\n'* ]]; then st="permission"
        elif [[ "$work_s" == *$'\n'"${win}"$'\n'* ]]; then st="working"
        elif [[ "$dn_s" == *$'\n'"${win}"$'\n'* ]]; then st="done"
        else st="idle"
        fi
        printf '%s\t%s\n' "$win" "$st"
    done
}

# drop_deferred_flags <flag-lines> <pane-lines>
#   <flag-lines>: "<session>\t<pane>" per line (bin/tmux-claude-attention's
#   cmd_list, pre-deferral). <pane-lines>: scan_agent_panes' own 6-field
#   format. Prints the flag lines whose pane does NOT carry live agents
#   (agents > 0) — per PANE, never per session, since the attention layer's
#   flags are themselves per pane. A3 in the workplan: deferral belongs at
#   READ time, not at flag time, so this is a pure filter the reader applies,
#   never a second flag state.
drop_deferred_flags() {
    local flags="$1" panes="$2"
    [[ -n "$flags" ]] || return 0

    local busy=$'\n'
    local _s p _w _a _st ag
    while IFS=$'\t' read -r _s p _w _a _st ag; do
        [[ -n "$p" ]] || continue
        if [[ "$ag" != "-" ]] && (( ag > 0 )); then
            busy+="${p}"$'\n'
        fi
    done <<< "$panes"

    local line pane
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        pane="${line##*$'\t'}"
        [[ "$busy" == *$'\n'"${pane}"$'\n'* ]] || printf '%s\n' "$line"
    done <<< "$flags"
}

get_pane_cwd() {
    local session="$1"
    tmux list-panes -t "${session}:1" -F '#{pane_current_path}' 2>/dev/null | head -1
}

# Claude Code converts '/', '.', and '_' to '-':
# /Users/first.last/dev/foo_bar -> -Users-first-last-dev-foo-bar
encode_cwd() {
    echo "$1" | sed 's|[/._]|-|g'
}

# Shared by build_cwd_session_map, live_agent_counts and bin/hq-snapshot's
# collect_turns: pane id (with "%", "-" when untracked), cwd, sessionId.
_CWD_MAP_JQ='[((.tmux // "") | [scan("%[0-9]+$")] | .[0] // "-"), .cwd, .sessionId] | @tsv'

# One line per live claude: "paneId\tcwd\tsessionId", paneId is "-" when
# unknown. Call once before the pane-exact lookups below, which read from
# this file ($_CWD_MAP_FILE).
_CWD_MAP_FILE=""
build_cwd_session_map() {
    _CWD_MAP_FILE=$(mktemp /tmp/claude-cwd-map.XXXXXX)
    jq -r "$_CWD_MAP_JQ" "${CLAUDE_SESSIONS_DIR}"/*.json 2>/dev/null > "$_CWD_MAP_FILE"
}

# live_agent_counts <newline-separated claude pane ids, with "%">
#   Sets LIVE_AGENTS_OUT to "\n%N\t<count>\n..." (leading newline, only
#   panes with count > 0) via prefix-stripping lookups — no subshell, so a
#   caller already paying for the one jq + one find below adds no fork of
#   its own reading the result. Live = the dashboard's own "+N": a
#   subagent's jsonl mtime within LIVE_AGENT_SECS AND a .meta.json on disk
#   (list_session_agents requires the same pair).
LIVE_AGENTS_OUT=$'\n'
live_agent_counts() {
    LIVE_AGENTS_OUT=$'\n'
    local pane_ids="$1"
    [[ -n "$pane_ids" ]] || return 0

    local map
    map=$(jq -r "$_CWD_MAP_JQ" "${CLAUDE_SESSIONS_DIR}"/*.json 2>/dev/null)
    [[ -n "$map" ]] || return 0
    map=$'\n'"$map"$'\n'

    # Pane-exact only (no find_pane_jsonl cwd fallback): A1 in the workplan
    # verified every live claude pane resolves pane-exactly on this machine.
    local -a dirs=() dir_panes=()
    local pane rest line pcwd psid dir
    while IFS= read -r pane; do
        [[ -n "$pane" ]] || continue
        rest="${map#*$'\n'"${pane}"$'\t'}"
        [[ "$rest" == "$map" ]] && continue
        line="${rest%%$'\n'*}"
        pcwd="${line%%$'\t'*}"
        psid="${line#*$'\t'}"
        # Bash form of encode_cwd's sed (verified equal under /bin/bash
        # 3.2), not a call to it: encode_cwd forks echo+sed per use, which
        # a per-pane loop on the statusbar's ~200ms budget cannot afford.
        dir="${CLAUDE_PROJECTS_DIR}/${pcwd//[\/._]/-}/${psid}/subagents"
        [[ -d "$dir" ]] || continue
        dirs+=("$dir")
        dir_panes+=("$pane")
    done <<< "$pane_ids"
    (( ${#dirs[@]} == 0 )) && return 0

    local found
    # BSD find's "-mtime -Ns" ("modified less than N seconds ago") is
    # macOS-only syntax (A4, verified against /usr/bin/find here); GNU find
    # rejects the trailing "s" on -mtime and this count silently reads 0
    # there, never an error.
    found=$(find "${dirs[@]}" -maxdepth 1 -name 'agent-*.jsonl' -mtime -$(( LIVE_AGENT_SECS + 1 ))s 2>/dev/null)
    [[ -n "$found" ]] || return 0

    local -a count=()
    local i path meta pdir
    for (( i = 0; i < ${#dirs[@]}; i++ )); do count[i]=0; done
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        meta="${path%.jsonl}.meta.json"
        [[ -f "$meta" ]] || continue
        pdir="${path%/*}"
        for (( i = 0; i < ${#dirs[@]}; i++ )); do
            [[ "${dirs[i]}" == "$pdir" ]] && count[i]=$(( count[i] + 1 ))
        done
    done <<< "$found"

    for (( i = 0; i < ${#dirs[@]}; i++ )); do
        (( count[i] > 0 )) && LIVE_AGENTS_OUT+="${dir_panes[i]}"$'\t'"${count[i]}"$'\n'
    done
}

# sessions/*.json records each claude's tmux pane id
# ("tmux":"sess:@win.%pane"). This is what disambiguates two claude
# processes sharing one CWD: without it, _cwd_lookup_jsonl's newest-jsonl
# heuristic silently hands back the OTHER claude's transcript — no
# subagents dir, wrong tokens. Prints the jsonl path, or nothing on a miss.
_pane_exact_jsonl() {
    local pane_id="$1"
    [[ -n "$_CWD_MAP_FILE" && -f "$_CWD_MAP_FILE" ]] || return 0
    local hit pcwd psid pjsonl
    hit=$(awk -F'\t' -v p="$pane_id" '$1 == p { print; exit }' "$_CWD_MAP_FILE")
    [[ -z "$hit" ]] && return 0
    IFS=$'\t' read -r _ pcwd psid <<< "$hit"
    pjsonl="${CLAUDE_PROJECTS_DIR}/$(encode_cwd "$pcwd")/${psid}.jsonl"
    [[ -n "$psid" && -f "$pjsonl" ]] && echo "$pjsonl"
}

# The cwd fallback uses THAT pane's cwd, not window 1's.
find_pane_jsonl() {
    local pane_id="$1"
    local pjsonl
    pjsonl=$(_pane_exact_jsonl "$pane_id")
    if [[ -n "$pjsonl" ]]; then
        echo "$pjsonl"
        return
    fi
    local cwd
    cwd=$(tmux display-message -p -t "$pane_id" '#{pane_current_path}' 2>/dev/null)
    _cwd_lookup_jsonl "$cwd"
}

# Window-1-pinned by construction, so it cannot see a claude running
# anywhere else: per-pane callers must use find_pane_jsonl instead.
find_session_jsonl() {
    local session="$1"

    local pane_id pjsonl
    for pane_id in $(tmux list-panes -t "${session}:1" -F '#{pane_id}' 2>/dev/null); do
        pjsonl=$(_pane_exact_jsonl "$pane_id")
        if [[ -n "$pjsonl" ]]; then
            echo "$pjsonl"
            return
        fi
    done

    _cwd_lookup_jsonl "$(get_pane_cwd "$session")"
}

_cwd_lookup_jsonl() {
    local cwd="$1"
    [[ -z "$cwd" ]] && return

    local encoded
    encoded=$(encode_cwd "$cwd")
    local project_dir="${CLAUDE_PROJECTS_DIR}/${encoded}"
    [[ ! -d "$project_dir" ]] && return

    local session_id=""
    if [[ -n "$_CWD_MAP_FILE" && -f "$_CWD_MAP_FILE" ]]; then
        session_id=$(awk -F'\t' -v cwd="$cwd" '$2 == cwd { print $3; exit }' "$_CWD_MAP_FILE")
    else
        session_id=$(jq -r --arg cwd "$cwd" 'select(.cwd == $cwd) | .sessionId' "${CLAUDE_SESSIONS_DIR}"/*.json 2>/dev/null | head -1)
    fi

    local jsonl="${project_dir}/${session_id}.jsonl"
    if [[ -n "$session_id" && -f "$jsonl" ]]; then
        local newest
        newest=$(ls -t "${project_dir}"/*.jsonl 2>/dev/null | head -1)
        if [[ -n "$newest" && "$newest" != "$jsonl" ]]; then
            # A newer transcript means /clear started a new session id that
            # the session JSON does not know about yet.
            echo "$newest"
            return
        fi
        echo "$jsonl"
        return
    fi

    ls -t "${project_dir}"/*.jsonl 2>/dev/null | head -1
}

# Prints tab-separated: context_size model
get_context_and_model() {
    local jsonl="$1"
    [[ ! -f "$jsonl" ]] && printf '0\tunknown' && return

    tail -50 "$jsonl" | jq -rs '
        [.[] | select(.type == "assistant" and .message.usage)] |
        if length == 0 then
            [0, "unknown"]
        else
            (last | .message.usage) as $last |
            (last | .message.model // "unknown") as $model |
            (($last.input_tokens // 0) + ($last.cache_read_input_tokens // 0) + ($last.cache_creation_input_tokens // 0)) as $context |
            [$context, $model]
        end | @tsv
    ' 2>/dev/null || printf '0\tunknown'
}

# Cache: output\tall\tturns\tstate_cost\test_cost\tbyte_offset.
# Prints tab-separated: total_output total_all turns cost
# - assistant records are deduped per requestId within each parsed chunk:
#   one API response is logged once PER CONTENT BLOCK with usage that
#   grows across blocks, so naive summing inflates output 2-3x. Keeping
#   the max-output record per request is the fix. A request straddling a
#   chunk boundary can still count twice — bounded to one per refresh.
# - turns: user prompts handled (non-meta user records that are not tool
#   results) — the human notion of a turn, not API requests. Sidechain
#   records are excluded unless the 3rd arg is 1; agent transcripts mark
#   everything isSidechain, so agent callers pass 1.
# - cost: totalCostUSD from the newest cost-state record when one exists
#   (exact and cumulative, but live sessions often have none), else
#   "~<usd>" estimated from the price sheet, else "-".
get_totals_incremental() {
    local jsonl="$1"
    local cache="$2"
    local inc_sc="${3:-0}"
    [[ "$inc_sc" == "1" ]] || inc_sc=0
    [[ ! -f "$jsonl" ]] && printf '0\t0\t0\t-' && return

    local file_size
    file_size=$(wc -c < "$jsonl" 2>/dev/null)

    local cached_out=0 cached_all=0 cached_turns=0 cached_scost="-" cached_est=0 cached_offset=0
    if [[ -f "$cache" ]]; then
        IFS=$'\t' read -r cached_out cached_all cached_turns cached_scost cached_est cached_offset < "$cache"
        # An empty 6th field (older cache format) or a shrunk file (new or
        # cleared session) resets the cache: one full re-parse, incremental
        # after.
        if [[ -z "$cached_offset" ]] || (( file_size < cached_offset )); then
            cached_out=0; cached_all=0; cached_turns=0; cached_scost="-"; cached_est=0; cached_offset=0
        fi
    fi

    _totals_result() {  # <out> <all> <turns> <state_cost> <est_cost>
        local cost="-"
        if [[ "$4" != "-" && -n "$4" ]]; then
            cost="$4"
        elif awk "BEGIN{exit !($5 > 0.0001)}" 2>/dev/null; then
            cost="~$5"
        fi
        printf '%s\t%s\t%s\t%s' "$1" "$2" "$3" "$cost"
    }

    if (( file_size == cached_offset )); then
        _totals_result "$cached_out" "$cached_all" "$cached_turns" "$cached_scost" "$cached_est"
        return
    fi

    # Line-tolerant (fromjson?) so a mid-write partial line drops that one
    # record instead of zeroing the whole delta. The price sheet below is
    # duplicated from bin/claude-tokens' JQ_PRELUDE, the source of truth —
    # edit both together.
    local delta_out=0 delta_all=0 delta_turns=0 delta_scost="-" delta_est=0
    local delta
    delta=$(tail -c +"$(( cached_offset + 1 ))" "$jsonl" | jq -Rn -r --argjson inc_sc "$inc_sc" '
        def prices: {
          "claude-fable-5-1":   [10, 50],
          "claude-fable-5":     [10, 50],
          "claude-mythos-5-1":  [10, 50],
          "claude-mythos-5":    [10, 50],
          "claude-opus-5":      [5, 25],
          "claude-opus-4-8":    [5, 25],
          "claude-opus-4-7":    [5, 25],
          "claude-opus-4-6":    [5, 25],
          "claude-opus-4-5":    [5, 25],
          "claude-opus-4-1":    [15, 75],
          "claude-opus-4":      [15, 75],
          "claude-sonnet-5":    [2, 10],
          "claude-sonnet-4-6":  [3, 15],
          "claude-sonnet-4-5":  [3, 15],
          "claude-sonnet-4":    [3, 15],
          "claude-haiku-4-5":   [1, 5],
          "claude-3-5-haiku":   [0.8, 4]
        };
        def base_model: sub("-20[0-9]{6}$"; "");
        def usage_cost($model):
          (prices[$model | base_model] // null) as $p
          | if $p == null then null else
              ( (.input_tokens // 0)            * $p[0]
              + (.output_tokens // 0)           * $p[1]
              + (.cache_read_input_tokens // 0) * $p[0] * 0.1
              + (if .cache_creation then
                   (.cache_creation.ephemeral_5m_input_tokens // 0) * $p[0] * 1.25
                 + (.cache_creation.ephemeral_1h_input_tokens // 0) * $p[0] * 2
                 else
                   (.cache_creation_input_tokens // 0) * $p[0] * 1.25
                 end)
              ) / 1000000
            end;
        [inputs | fromjson?] as $recs |
        ($recs | map(select(.type == "assistant" and .message.usage))
               | group_by(.requestId // .uuid // "?")
               | map(max_by(.message.usage.output_tokens // 0))) as $asst |
        ($asst | map(.message.usage.output_tokens // 0) | add // 0) as $d_out |
        ($asst | map(
            (.message.usage.input_tokens // 0) +
            (.message.usage.cache_read_input_tokens // 0) +
            (.message.usage.cache_creation_input_tokens // 0) +
            (.message.usage.output_tokens // 0)
        ) | add // 0) as $d_all |
        ($asst | map((.message.model // "") as $m | (.message.usage | usage_cost($m)) // 0)
               | add // 0) as $d_est |
        ($recs | map(select(
            .type == "user"
            and (.isMeta != true)
            and (($inc_sc == 1) or ((.isSidechain // false) == false))
            and (((.message.content | type) == "string")
                 or ([.message.content[]? | select(.type == "tool_result")] | length) == 0)
        )) | length) as $d_turns |
        ($recs | map(select(.type == "cost-state") | .totalCostUSD) | last) as $cost |
        [$d_out, $d_all, $d_turns, ($cost // "-"), $d_est] | @tsv
    ' 2>/dev/null)

    if [[ -n "$delta" ]]; then
        IFS=$'\t' read -r delta_out delta_all delta_turns delta_scost delta_est <<< "$delta"
    fi

    local new_out=$(( cached_out + delta_out ))
    local new_all=$(( cached_all + delta_all ))
    local new_turns=$(( cached_turns + delta_turns ))
    # cost-state is a cumulative snapshot, not a delta: newest wins. The
    # estimate is the one that accumulates (float math via awk).
    local new_scost="$cached_scost"
    [[ "$delta_scost" != "-" && -n "$delta_scost" ]] && new_scost="$delta_scost"
    local new_est
    new_est=$(awk "BEGIN{printf \"%.6f\", ${cached_est:-0} + ${delta_est:-0}}" 2>/dev/null || echo 0)

    printf '%s\t%s\t%s\t%s\t%s\t%s' "$new_out" "$new_all" "$new_turns" "$new_scost" "$new_est" "$file_size" > "$cache"
    _totals_result "$new_out" "$new_all" "$new_turns" "$new_scost" "$new_est"
}

_agent_file_mtime() {
    stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null
}

# Prints the cached value and returns 0 if the cache was stored for this
# exact mtime; otherwise returns 1 (caller should recompute and store).
_agent_cache_get() {
    local cache="$1" mtime="$2"
    [[ -f "$cache" ]] || return 1
    local cached_mtime
    cached_mtime=$(head -1 "$cache" 2>/dev/null)
    [[ -n "$mtime" && "$cached_mtime" == "$mtime" ]] || return 1
    tail -n +2 "$cache" 2>/dev/null
}

_agent_cache_set() {
    printf '%s\n%s' "$2" "$3" > "$1" 2>/dev/null
}

# Sorted for tree rendering (parents before children, siblings in spawn
# order). Tab-separated: agent_id, spawn_depth, parent_id, agentType,
# description, mtime, started. mtime is the transcript's last write, i.e.
# recency; started is the meta.json mtime, written once at spawn, and is
# what a "working Ns" age must count from — jsonl mtime resets on every
# write, so counting from it shows a perpetual "working 2s".
list_session_agents() {
    local sid_jsonl="$1"
    [[ -z "$sid_jsonl" || ! -f "$sid_jsonl" ]] && return

    local proj_dir sid subdir
    proj_dir=$(dirname "$sid_jsonl")
    sid=$(basename "$sid_jsonl" .jsonl)
    subdir="${proj_dir}/${sid}/subagents"
    [[ -d "$subdir" ]] || return

    local now
    now=$(date +%s)

    local meta id jsonl mtime started
    {
        for meta in "$subdir"/agent-*.meta.json; do
            [[ -f "$meta" ]] || continue
            id="${meta##*/agent-}"
            id="${id%.meta.json}"
            jsonl="${subdir}/agent-${id}.jsonl"
            [[ -f "$jsonl" ]] || continue
            mtime=$(_agent_file_mtime "$jsonl")
            [[ -z "$mtime" ]] && continue
            # Skip stale agents BEFORE forking jq for them, or every refresh
            # tick pays a stat + a jq per agent-*.meta.json ever written for
            # this session id, to render only the recent ones.
            (( now - mtime > STALE_AGENT_SECS )) && continue
            started=$(_agent_file_mtime "$meta")
            [[ -z "$started" ]] && started="$mtime"
            jq --arg id "$id" --argjson mtime "$mtime" --argjson started "$started" \
                '. + {id: $id, mtime: $mtime, started: $started}' "$meta" 2>/dev/null
        done
    } | jq -rs --argjson now "$now" --argjson stale "$STALE_AGENT_SECS" '
        def dfs($parentKey; $items):
            ($items | map(select(.parentKey == $parentKey)) | sort_by(.started, .mtime)) as $kids
            | reduce $kids[] as $k ([]; . + [$k] + dfs($k.id; $items));

        # Apply the stale filter FIRST, then compute $ids/parentKey from the
        # SURVIVORS only. Resolving parentKey against the full, pre-filter id
        # list leaves a live child of a since-stale parent pointing at a
        # parent that is no longer in $items, and dfs never reaches it — a
        # working agent silently vanishes from the tree.
        (map(. + {age: ($now - .mtime)}) | map(select(.age <= $stale))) as $survivors
        | ($survivors | map(.id)) as $ids
        | (
            $survivors
            | map(
                (.parentAgentId // "") as $p
                | . + { parentKey: (if $p == "" then "" elif ($ids | index($p)) then $p else "" end) }
              )
          ) as $items
        | dfs(""; $items)
        | .[]
        | [
            .id,
            # A promoted root (true orphan, or a parent the stale filter
            # dropped) has no visible parent row above it, so clamp its
            # indent to 0 instead of its original nested spawnDepth. The
            # type check keeps a non-numeric spawnDepth, from a malformed
            # meta, out of a bash arithmetic expression downstream.
            # (No apostrophes in here: this jq program is single-quoted.)
            (if .parentKey == "" then 0
             else (.spawnDepth // 1 | if type == "number" then . else 1 end)
             end),
            # "-" placeholder for a root/orphan: a tab-delimited bash `read`
            # collapses adjacent tabs (tab is IFS whitespace), so a blank
            # field mid-row silently shifts every field after it.
            ((.parentAgentId // "") as $pid | if $pid == "" then "-" else $pid end),
            (.agentType // "agent"),
            ((.description // "") as $d | if $d == "" then "(no description)" else $d end),
            .mtime,
            .started
          ] | @tsv
    ' 2>/dev/null
}

# With a cache-file, skips the jq re-parse while the jsonl's mtime is
# unchanged. Prints tab-separated: context output model
get_agent_stats() {
    local jsonl="$1" cache="$2"
    [[ ! -f "$jsonl" ]] && printf '0\t0\tunknown' && return

    local mtime=""
    if [[ -n "$cache" ]]; then
        mtime=$(_agent_file_mtime "$jsonl")
        local cached
        # An empty cached payload is a torn write (a crash mid-write, or two
        # dashboards racing on one cache path), never a real value — a real
        # result is at minimum "0\t0\tunknown". Recompute instead of
        # returning empty and shifting the caller's TSV fields.
        if cached=$(_agent_cache_get "$cache" "$mtime") && [[ -n "$cached" ]]; then
            printf '%s' "$cached"
            return
        fi
    fi

    local result
    # Line-tolerant parse: a mid-write partial last line from tail drops
    # that line instead of failing the whole slurp.
    result=$(tail -50 "$jsonl" | jq -Rn -r '
        [inputs | fromjson?] |
        [.[] | select(.type == "assistant" and .message.usage)] |
        if length == 0 then
            [0, 0, "unknown"]
        else
            (last | .message.usage) as $last |
            (last | .message.model // "unknown") as $model |
            (($last.input_tokens // 0) + ($last.cache_read_input_tokens // 0) + ($last.cache_creation_input_tokens // 0)) as $context |
            ($last.output_tokens // 0) as $output |
            [$context, $output, $model]
        end | @tsv
    ' 2>/dev/null)
    [[ -z "$result" ]] && result=$'0\t0\tunknown'

    [[ -n "$cache" ]] && _agent_cache_set "$cache" "$mtime" "$result"
    printf '%s' "$result"
}

# A `def tool_line: ...;` shared by get_agent_snippet and get_last_exchange:
# given a tool_use object as `.`, renders "Name: arg" (no arrow — each
# caller prefixes its own).
# Concatenate as a separate single-quoted segment ahead of a caller's own jq
# program (bash does not expand $-vars inside single quotes, and this
# string is full of jq's own $vars).
_AGENT_TOOL_LINE_JQ='
def tool_line:
  (.input // {}) as $in
  | ((["command","pattern","query","url","file_path","path","description","message","prompt"]
        | map($in[.]?) | map(select(type == "string" and length > 0)) | first)
     // ([$in | to_entries[] | .value | select(type == "string" and length > 0)] | first)) as $raw
  | (if $raw == null then ""
     else ($raw | split("\n")[0]) as $line
        | (if ($line | test("^[^ ]*/[^ ]*$")) and ($line | test("://") | not)
            then ($line | split("/") | last) else $line end)
     end) as $arg
  | (.name // "tool") + (if ($arg | length) > 0 then ": " + $arg else "" end);
'

# Prints one tab-separated line: kind prompt from reply tool pending.
# kind is "you"|"msg"|"-"; every other field is a JSON-encoded string
# (tojson) or "-", so none carries a raw tab or newline that would shift
# a TSV reader's columns. Claude transcripts only.
#
# Prompt offset: grep -b for the last human or peer record, the only
# full-file pass here; a typed prompt can sit far behind a 100+ KB run of
# tool results, so a bounded tail would miss it — see
# workplans/hq-feed-plan.md. A peer record newer than the last human one is
# a cross-session message (kind "msg", "from" its origin.name) UNLESS it
# carries no name — a subagent hand-back (senderTaskId, no name) — in which
# case it is skipped and the human record answers instead. A record with
# neither key (an older transcript, or a harness
# task-notification/local-command-stdout, whose origin.kind is
# "task-notification" or absent) never matches, so "you ›" is never drawn
# from one.
#
# Assistant side, from the bounded tail (tail -c 131072): the last
# non-empty text block (reply), the last tool_use (tool) and the last
# tool_use whose id has no matching tool_result in that tail (pending;
# AskUserQuestion renders as its first question's text).
#
# No caching: the mtime gate against re-parsing an unchanged transcript
# lives in the caller (bin/hq-snapshot's turns_rows).
get_last_exchange() {
    local jsonl="$1"
    if [[ ! -f "$jsonl" ]]; then
        printf -- '-\t-\t-\t-\t-\t-'
        return 0
    fi

    local offsets human_off="" peer_off=""
    offsets=$(grep -abE '"origin":\{"kind":"(human|peer)"' "$jsonl" 2>/dev/null)
    human_off=$(printf '%s\n' "$offsets" | grep -F '"origin":{"kind":"human"' | tail -1)
    human_off="${human_off%%:*}"
    peer_off=$(printf '%s\n' "$offsets" | grep -F '"origin":{"kind":"peer"' | tail -1)
    peer_off="${peer_off%%:*}"

    local kind="-" prompt="-" from="-" line rec

    if [[ -n "$peer_off" ]] && { [[ -z "$human_off" ]] || (( peer_off > human_off )); }; then
        # A pipefail-safe read: `head -1` closing early SIGPIPEs `tail`, and
        # the collector's `set -o pipefail` would otherwise surface that as
        # this command's exit status.
        line=$(tail -c +"$(( peer_off + 1 ))" "$jsonl" 2>/dev/null | head -1) || true
        rec=$(printf '%s' "$line" | jq -c 'select(.origin.name != null)' 2>/dev/null)
        if [[ -n "$rec" ]]; then
            kind="msg"
            from=$(printf '%s' "$rec" | jq -r '(.origin.name // "-") | tojson' 2>/dev/null)
            prompt=$(printf '%s' "$rec" | jq -r '
                (.origin.body //
                 (.message.content
                  | if type == "string" then .
                    else ([.[]? | select(.type == "text") | .text] | join("\n"))
                    end))
                | tojson' 2>/dev/null)
        fi
    fi

    if [[ "$kind" == "-" && -n "$human_off" ]]; then
        line=$(tail -c +"$(( human_off + 1 ))" "$jsonl" 2>/dev/null | head -1) || true
        prompt=$(printf '%s' "$line" | jq -r '
            def clean:
                # command-name/-message/-args appear in either order across
                # Claude Code versions (observed both ways live), so each is
                # matched independently rather than as one fixed sequence.
                (if test("<command-name>") then
                    (capture("<command-name>(?<n>[^<]*)</command-name>").n) as $n
                    | (if test("<command-args>")
                       then capture("<command-args>(?<a>[^<]*)</command-args>").a
                       else "" end) as $a
                    | $n + (if ($a | length) > 0 then " " + $a else "" end)
                 else . end)
                | gsub("<pasted_content[^>]*>.*?</pasted_content>"; "[pasted]"; "m");
            (.message.content
             | if type == "string" then .
               else ([.[]? | select(.type == "text") | .text] | join("\n"))
               end)
            | clean | tojson' 2>/dev/null)
        if [[ -n "$prompt" && "$prompt" != "null" ]]; then
            kind="you"
        else
            prompt="-"
        fi
    fi
    [[ -z "$prompt" ]] && prompt="-"

    local asst reply tool pending
    asst=$(tail -c 131072 "$jsonl" 2>/dev/null | jq -Rn -r "$_AGENT_TOOL_LINE_JQ"'
        [inputs | fromjson?] as $recs |
        ($recs | map(select(.type == "assistant")) | map((.message.content // [])[]?)) as $blocks |
        ($recs | map(select(.type == "user")) | map((.message.content // [])[]? | select(.type == "tool_result") | .tool_use_id)) as $results |
        ([$blocks[] | select(.type == "text") | .text | select(length > 0)] | last) as $reply_raw |
        ($blocks | map(select(.type == "tool_use"))) as $tool_uses |
        ($tool_uses | last) as $tool_tu |
        ($tool_uses | map(select(. as $t | ($results | index($t.id)) == null)) | last) as $pending_tu |
        ( if $reply_raw == null then "-" else ($reply_raw[0:32768] | tojson) end ) as $out_reply |
        ( if $tool_tu == null then "-" else ($tool_tu | tool_line | tojson) end ) as $out_tool |
        ( if $pending_tu == null then "-"
          elif $pending_tu.name == "AskUserQuestion" then
              (($pending_tu.input.questions[0].question // "") | tojson)
          else ($pending_tu | tool_line | tojson)
          end ) as $out_pending |
        [$out_reply, $out_tool, $out_pending] | join("\t")
    ' 2>/dev/null)
    reply="-"; tool="-"; pending="-"
    [[ -n "$asst" ]] && IFS=$'\t' read -r reply tool pending <<< "$asst"

    printf '%s\t%s\t%s\t%s\t%s\t%s' "$kind" "$prompt" "$from" "${reply:--}" "${tool:--}" "${pending:--}"
}

# A one-line "what is this agent doing", flattened and truncated to maxlen.
# Prefers the most recent non-empty assistant text (narration); with none
# in the window — a tool-heavy agent can run dozens of tool calls without
# narrating, pushing its last text past the byte-tail — falls back to its
# last tool_use as "→ Tool: arg", the arrow marking an action rather than
# speech. That fallback is what keeps the window bounded at tail -c 131072:
# tool_use records stay dense near EOF, and narration that has aged out of
# the window is genuinely stale, so it should not be shown as current.
# Parses per line via fromjson?, so the partial first record the byte-tail
# cuts is skipped rather than fatal. Empty output means neither text nor a
# tool call yet — the caller hides the line.
# The flatten + truncate happen INSIDE jq: bash 3.2's ${var//x/y} is
# quadratic on long strings in a UTF-8 locale — 13.7s for one 33KB
# narration (macOS 25.5, 2026-09-10), which stalled the whole dashboard on
# a cold cache. Bash must only ever see the <= maxlen result.
# cache ($3), when given, is a path whose cached result is reused while the
# jsonl's mtime is unchanged.
get_agent_snippet() {
    local jsonl="$1" maxlen="${2:-60}" cache="$3"
    [[ ! -f "$jsonl" ]] && printf '' && return

    local mtime=""
    if [[ -n "$cache" ]]; then
        mtime=$(_agent_file_mtime "$jsonl")
        local cached
        if cached=$(_agent_cache_get "$cache" "$mtime"); then
            printf '%s' "$cached"
            return
        fi
    fi

    local text
    text=$(tail -c 131072 "$jsonl" | jq -Rn -r --argjson maxlen "$maxlen" "$_AGENT_TOOL_LINE_JQ"'
        [inputs | fromjson?] as $recs |
        # all assistant content blocks, in order, most recent last
        [$recs[] | select(.type == "assistant") | (.message.content // [])[]?] as $blocks |
        ([$blocks[] | select(.type == "text") | .text | select(length > 0)] | last) as $narration |
        (if $narration != null then
            $narration
        else
            # Keyed on input FIELD names, never tool names, inside tool_line
            # (command/path/query are shared across many tools and stable
            # over time; a switch on tool names rots on every new tool,
            # rename or mcp__* name, and falling through to the first string
            # input value means an unknown or MCP tool still gets a summary).
            ($blocks | map(select(.type == "tool_use")) | last) as $tu |
            if $tu == null then
                empty
            else
                "→ " + ($tu | tool_line)
            end
        end)
        # Flatten to one line. A surviving tab counts as 1 char in
        # ${#row_plain} at render time but the terminal expands it to the
        # next 8-column stop, so a row that passes the width check still
        # wraps and misaligns every row below it. Other C0 control chars go
        # for the same reason.
        | gsub("[\\n\\r\\t]"; " ")
        | gsub("[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]"; "")
        | if length > $maxlen then .[:$maxlen - 1] + "…" else . end
    ' 2>/dev/null)

    [[ -n "$cache" ]] && _agent_cache_set "$cache" "$mtime" "$text"
    printf '%s' "$text"
}

# The formatters below assign to the variable named first instead of
# printing, so the dashboard's per-row loop forks nothing. bash 3.2's
# printf -v rejects an array element: pass a plain variable.

format_age() {
    local _fa_s="$2"
    if [[ -z "$_fa_s" ]]; then
        printf -v "$1" '?'
    elif (( _fa_s < 60 )); then
        printf -v "$1" '%ds' "$_fa_s"
    elif (( _fa_s < 3600 )); then
        printf -v "$1" '%dm' $(( _fa_s / 60 ))
    else
        printf -v "$1" '%dh' $(( _fa_s / 3600 ))
    fi
}

# 1234567 -> 1.2M, 12345 -> 12.3k, 999 -> 999. The decimal truncates, never
# rounds: 1299 -> 1.2k.
format_tokens() {
    local _ft_n="$2"
    if (( _ft_n >= 1000000 )); then
        printf -v "$1" '%d.%dM' $(( _ft_n / 1000000 )) $(( _ft_n % 1000000 / 100000 ))
    elif (( _ft_n >= 1000 )); then
        printf -v "$1" '%d.%dk' $(( _ft_n / 1000 )) $(( _ft_n % 1000 / 100 ))
    else
        printf -v "$1" '%s' "$_ft_n"
    fi
}

# Resolved relative to THIS file, so a worktree copy sources its own sibling
# rather than ~/dotfiles.
_agent_lib_dir="${BASH_SOURCE[0]%/*}"
[[ "$_agent_lib_dir" == "${BASH_SOURCE[0]}" ]] && _agent_lib_dir="$HOME/dotfiles/bin"
# shellcheck source=/dev/null
source "${_agent_lib_dir}/tmux-claude-lib-codex"
