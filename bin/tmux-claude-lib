#!/usr/bin/env bash

# Shared library for claude session manager scripts.
# Source this file, don't execute it directly.

CLAUDE_SESSIONS_DIR="$HOME/.claude/sessions"
CLAUDE_PROJECTS_DIR="$HOME/.claude/projects"

# Agent liveness thresholds (tunable). An agent transcript with mtime within
# LIVE_AGENT_SECS renders as working (●); older renders as done/idle (◯)
# with its age; older than STALE_AGENT_SECS is hidden entirely. See
# workplans/tmux-claude-dashboard-agent-trees-plan.md for the rationale.
LIVE_AGENT_SECS=120
STALE_AGENT_SECS=1800

# get_claude_sessions
#   Prints all claude-* tmux session names, one per line.
get_claude_sessions() {
    tmux list-sessions -F '#{session_activity} #{session_name}' 2>/dev/null \
        | grep ' claude-' \
        | sort -rn \
        | awk '{print $2}'
}

# get_session_status <tmux-session-name>
#   Prints: working | idle | permission | unknown
#   Detects state by inspecting the last lines of the tmux pane.
get_session_status() {
    local session="$1"
    local content
    content=$(tmux capture-pane -t "${session}:1" -p -S -30 2>/dev/null | grep -v '^$' | tail -10)

    if [[ -z "$content" ]]; then
        echo "unknown"
        return
    fi

    # Working: claude is actively streaming output
    if echo "$content" | grep -q "to interrupt"; then
        echo "working"
        return
    fi

    # Permission: Yes/No selector or plan mode question waiting for input
    # (must check before idle — ❯ appears in both)
    if echo "$content" | grep -q "Yes" && echo "$content" | grep -q "No"; then
        echo "permission"
        return
    fi
    if echo "$content" | tail -2 | grep -q "^Enter to select"; then
        echo "permission"
        return
    fi

    # Idle: the ❯ input prompt is visible, claude is done
    if echo "$content" | grep -q "❯"; then
        echo "idle"
        return
    fi

    echo "unknown"
}

# get_pane_cwd <tmux-session-name>
#   Prints the working directory of the claude pane (window 1).
get_pane_cwd() {
    local session="$1"
    tmux list-panes -t "${session}:1" -F '#{pane_current_path}' 2>/dev/null | head -1
}

# encode_cwd <path>
#   Encodes a path for the claude projects directory.
#   Claude Code converts '/', '.', and '_' to '-':
#   /Users/first.last/dev/foo_bar -> -Users-first-last-dev-foo-bar
encode_cwd() {
    echo "$1" | sed 's|[/._]|-|g'
}

# build_cwd_session_map
#   Builds a temp file mapping CWD -> sessionId (one per line, tab-separated).
#   Call once, then use find_session_jsonl which looks up from the cache.
_CWD_MAP_FILE=""
build_cwd_session_map() {
    _CWD_MAP_FILE=$(mktemp /tmp/claude-cwd-map.XXXXXX)
    jq -r '[.cwd, .sessionId] | @tsv' "${CLAUDE_SESSIONS_DIR}"/*.json 2>/dev/null > "$_CWD_MAP_FILE"
}

# find_session_jsonl <tmux-session-name>
#   Prints the path to the active JSONL transcript file, or empty string.
#   Falls back to the most recently modified JSONL in the project dir
#   (handles /clear creating a new session ID without updating the session JSON).
find_session_jsonl() {
    local session="$1"
    local cwd
    cwd=$(get_pane_cwd "$session")
    [[ -z "$cwd" ]] && return

    local encoded
    encoded=$(encode_cwd "$cwd")
    local project_dir="${CLAUDE_PROJECTS_DIR}/${encoded}"
    [[ ! -d "$project_dir" ]] && return

    # try session JSON lookup first
    local session_id=""
    if [[ -n "$_CWD_MAP_FILE" && -f "$_CWD_MAP_FILE" ]]; then
        session_id=$(awk -F'\t' -v cwd="$cwd" '$1 == cwd { print $2; exit }' "$_CWD_MAP_FILE")
    else
        session_id=$(jq -r --arg cwd "$cwd" 'select(.cwd == $cwd) | .sessionId' "${CLAUDE_SESSIONS_DIR}"/*.json 2>/dev/null | head -1)
    fi

    local jsonl="${project_dir}/${session_id}.jsonl"
    if [[ -n "$session_id" && -f "$jsonl" ]]; then
        # verify this is the most recent JSONL (not stale after /clear)
        local newest
        newest=$(ls -t "${project_dir}"/*.jsonl 2>/dev/null | head -1)
        if [[ -n "$newest" && "$newest" != "$jsonl" ]]; then
            # a newer JSONL exists — /clear likely created a new session
            echo "$newest"
            return
        fi
        echo "$jsonl"
        return
    fi

    # fallback: most recently modified JSONL in the project dir
    ls -t "${project_dir}"/*.jsonl 2>/dev/null | head -1
}

# get_context_and_model <jsonl-path>
#   Fast path: reads only the tail of the file.
#   Prints tab-separated: context_size model
get_context_and_model() {
    local jsonl="$1"
    [[ ! -f "$jsonl" ]] && printf '0\tunknown' && return

    tail -50 "$jsonl" | jq -rs '
        [.[] | select(.type == "assistant" and .message.usage)] |
        if length == 0 then
            [0, "unknown"]
        else
            (last | .message.usage) as $last |
            (last | .message.model // "unknown") as $model |
            (($last.input_tokens // 0) + ($last.cache_read_input_tokens // 0) + ($last.cache_creation_input_tokens // 0)) as $context |
            [$context, $model]
        end | @tsv
    ' 2>/dev/null || printf '0\tunknown'
}

# get_totals_incremental <jsonl-path> <cache-file>
#   Incremental path: parses only new bytes since last call.
#   Cache file stores: total_output\ttotal_all\tbyte_offset
#   Prints tab-separated: total_output total_all
get_totals_incremental() {
    local jsonl="$1"
    local cache="$2"
    [[ ! -f "$jsonl" ]] && printf '0\t0' && return

    local file_size
    file_size=$(wc -c < "$jsonl" 2>/dev/null)

    local cached_out=0 cached_all=0 cached_offset=0
    if [[ -f "$cache" ]]; then
        IFS=$'\t' read -r cached_out cached_all cached_offset < "$cache"
        # if file shrunk (new session / cleared), reset
        if (( file_size < cached_offset )); then
            cached_out=0; cached_all=0; cached_offset=0
        fi
    fi

    if (( file_size == cached_offset )); then
        # no new data
        printf '%s\t%s' "$cached_out" "$cached_all"
        return
    fi

    # parse only the new bytes
    local delta_out=0 delta_all=0
    local delta
    delta=$(tail -c +"$(( cached_offset + 1 ))" "$jsonl" | jq -rs '
        [.[] | select(.type == "assistant" and .message.usage)] |
        if length == 0 then
            [0, 0]
        else
            (map(.message.usage.output_tokens // 0) | add) as $d_out |
            (map(
                (.message.usage.input_tokens // 0) +
                (.message.usage.cache_read_input_tokens // 0) +
                (.message.usage.cache_creation_input_tokens // 0) +
                (.message.usage.output_tokens // 0)
            ) | add) as $d_all |
            [$d_out, $d_all]
        end | @tsv
    ' 2>/dev/null)

    if [[ -n "$delta" ]]; then
        IFS=$'\t' read -r delta_out delta_all <<< "$delta"
    fi

    local new_out=$(( cached_out + delta_out ))
    local new_all=$(( cached_all + delta_all ))

    # save updated cache
    printf '%s\t%s\t%s' "$new_out" "$new_all" "$file_size" > "$cache"
    printf '%s\t%s' "$new_out" "$new_all"
}

# ── agent trees ─────────────────────────────────────────

# _agent_file_mtime <path>
#   Prints a file's mtime as epoch seconds (GNU/BSD stat portable).
_agent_file_mtime() {
    stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null
}

# _agent_cache_get <cache-file> <current-mtime>
#   Prints the cached value and returns 0 if the cache was stored for this
#   exact mtime; otherwise returns 1 (caller should recompute and store).
_agent_cache_get() {
    local cache="$1" mtime="$2"
    [[ -f "$cache" ]] || return 1
    local cached_mtime
    cached_mtime=$(head -1 "$cache" 2>/dev/null)
    [[ -n "$mtime" && "$cached_mtime" == "$mtime" ]] || return 1
    tail -n +2 "$cache" 2>/dev/null
}

# _agent_cache_set <cache-file> <mtime> <value>
_agent_cache_set() {
    printf '%s\n%s' "$2" "$3" > "$1" 2>/dev/null
}

# list_session_agents <session-jsonl-path>
#   Prints one line per live subagent under that session's transcript,
#   sorted for tree rendering (parents before children, siblings in spawn
#   order). Tab-separated: agent_id, spawn_depth, parent_id, agentType,
#   description, mtime. Hides agents whose jsonl mtime is older than
#   STALE_AGENT_SECS. Missing/unknown meta fields degrade to blank rather
#   than erroring.
list_session_agents() {
    local sid_jsonl="$1"
    [[ -z "$sid_jsonl" || ! -f "$sid_jsonl" ]] && return

    local proj_dir sid subdir
    proj_dir=$(dirname "$sid_jsonl")
    sid=$(basename "$sid_jsonl" .jsonl)
    subdir="${proj_dir}/${sid}/subagents"
    [[ -d "$subdir" ]] || return

    local now
    now=$(date +%s)

    local meta id jsonl mtime
    {
        for meta in "$subdir"/agent-*.meta.json; do
            [[ -f "$meta" ]] || continue
            id="${meta##*/agent-}"
            id="${id%.meta.json}"
            jsonl="${subdir}/agent-${id}.jsonl"
            [[ -f "$jsonl" ]] || continue
            mtime=$(_agent_file_mtime "$jsonl")
            [[ -z "$mtime" ]] && continue
            jq --arg id "$id" --argjson mtime "$mtime" '. + {id: $id, mtime: $mtime}' "$meta" 2>/dev/null
        done
    } | jq -rs --argjson now "$now" --argjson stale "$STALE_AGENT_SECS" '
        def dfs($parentKey; $items):
            ($items | map(select(.parentKey == $parentKey)) | sort_by(.mtime)) as $kids
            | reduce $kids[] as $k ([]; . + [$k] + dfs($k.id; $items));

        . as $raw
        | ($raw | map(.id)) as $ids
        | (
            $raw
            | map(
                (.parentAgentId // "") as $p
                | . + {
                    age: ($now - .mtime),
                    parentKey: (if $p == "" then "" elif ($ids | index($p)) then $p else "" end)
                  }
              )
            | map(select(.age <= $stale))
          ) as $items
        | dfs(""; $items)
        | .[]
        | [
            .id,
            (.spawnDepth // 1),
            # "-" placeholder for a root/orphan: an empty TSV field here
            # would sit mid-row, and a tab-delimited bash read collapses
            # adjacent tabs (tab is IFS whitespace), silently shifting every
            # field after it — never emit a blank non-trailing field.
            ((.parentAgentId // "") as $pid | if $pid == "" then "-" else $pid end),
            (.agentType // "agent"),
            ((.description // "") as $d | if $d == "" then "(no description)" else $d end),
            .mtime
          ] | @tsv
    ' 2>/dev/null
}

# get_agent_stats <agent-jsonl> [cache-file]
#   Context tokens, last-turn output tokens, and model — reuses the same
#   fast tail-of-file approach as get_context_and_model. With a cache-file,
#   skips the jq re-parse when the jsonl's mtime hasn't changed since the
#   last call (mirrors get_totals_incremental's caching intent).
#   Prints tab-separated: context output model
get_agent_stats() {
    local jsonl="$1" cache="$2"
    [[ ! -f "$jsonl" ]] && printf '0\t0\tunknown' && return

    local mtime=""
    if [[ -n "$cache" ]]; then
        mtime=$(_agent_file_mtime "$jsonl")
        local cached
        if cached=$(_agent_cache_get "$cache" "$mtime"); then
            printf '%s' "$cached"
            return
        fi
    fi

    local result
    result=$(tail -50 "$jsonl" | jq -rs '
        [.[] | select(.type == "assistant" and .message.usage)] |
        if length == 0 then
            [0, 0, "unknown"]
        else
            (last | .message.usage) as $last |
            (last | .message.model // "unknown") as $model |
            (($last.input_tokens // 0) + ($last.cache_read_input_tokens // 0) + ($last.cache_creation_input_tokens // 0)) as $context |
            ($last.output_tokens // 0) as $output |
            [$context, $output, $model]
        end | @tsv
    ' 2>/dev/null)
    [[ -z "$result" ]] && result=$'0\t0\tunknown'

    [[ -n "$cache" ]] && _agent_cache_set "$cache" "$mtime" "$result"
    printf '%s' "$result"
}

# get_agent_snippet <agent-jsonl> <maxlen> [cache-file]
#   Last assistant text across the tail of the transcript, flattened to a
#   single line and truncated to maxlen. Reads only tail -c 65536 for
#   speed; parses per-line via fromjson? so a partial first line (cut mid
#   record by the byte-tail) is skipped instead of erroring. Empty output
#   means "no recent text" — caller should fall back to meta description.
get_agent_snippet() {
    local jsonl="$1" maxlen="${2:-60}" cache="$3"
    [[ ! -f "$jsonl" ]] && printf '' && return

    local mtime=""
    if [[ -n "$cache" ]]; then
        mtime=$(_agent_file_mtime "$jsonl")
        local cached
        if cached=$(_agent_cache_get "$cache" "$mtime"); then
            printf '%s' "$cached"
            return
        fi
    fi

    local text
    text=$(tail -c 65536 "$jsonl" | jq -Rn -r '
        [inputs | fromjson?] |
        [.[] | select(.type == "assistant") | (.message.content // [])[]? | select(.type == "text") | .text] |
        last // empty
    ' 2>/dev/null)

    # flatten to a single line
    text="${text//$'\n'/ }"
    text="${text//$'\r'/ }"

    if (( ${#text} > maxlen )); then
        text="${text:0:$(( maxlen - 1 ))}…"
    fi

    [[ -n "$cache" ]] && _agent_cache_set "$cache" "$mtime" "$text"
    printf '%s' "$text"
}

# format_age <seconds>
#   Pretty-prints an age/duration: 45 -> 45s, 300 -> 5m, 7200 -> 2h
format_age() {
    local s="$1"
    [[ -z "$s" ]] && printf '?' && return
    if (( s < 60 )); then
        printf '%ds' "$s"
    elif (( s < 3600 )); then
        printf '%dm' "$(( s / 60 ))"
    else
        printf '%dh' "$(( s / 3600 ))"
    fi
}

# format_tokens <number>
#   Pretty-prints token counts: 1234567 -> 1.2M, 12345 -> 12.3k, 999 -> 999
format_tokens() {
    local n="$1"
    if (( n >= 1000000 )); then
        printf "%.1fM" "$(echo "scale=1; $n / 1000000" | bc)"
    elif (( n >= 1000 )); then
        printf "%.1fk" "$(echo "scale=1; $n / 1000" | bc)"
    else
        echo "$n"
    fi
}

# short_model <model-string>
#   Shortens model names: claude-opus-4-6 -> opus-4-6, claude-sonnet-4-6 -> sonnet-4-6
short_model() {
    echo "$1" | sed 's/^claude-//'
}
