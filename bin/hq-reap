#!/usr/bin/env bash
# hq-reap — stops finished /feature task sessions from holding resident
# claude processes. Tier 1 kills a task session's tmux session outright when
# its worktree's PR is MERGED/CLOSED and nothing unique would be lost (the
# same removability test bin/worktrees sweep uses). Tier 2 SIGTERMs the
# claude of a phase-`done` task session whose PR is still OPEN after a long
# idle, leaving its tmux session, pane shell and worktree alone — "parked",
# resumable by name. Dry run by default; --apply is the only mode that acts.
#
# NEVER A CANDIDATE, either tier: a session that is not a task session (its
# @task option unset and no claude on its panes carrying `/feature --run` in
# argv — the pre-this-change fallback); one not tied to a linked worktree row
# (session_name_for <row path> must equal the session name); one that is
# attached; one with any agent pane working/permission/unknown; one with any
# non-agent pane running something other than a shell or an editor.
#
# NEVER REMOVED: no worktree, no file, ever. The log under
# ~/.local/state/hq/reap is append-only, like the sweep archive beside it.
# The only kills this script performs are `tmux kill-session` on a tier-1
# verdict and `kill -TERM` of a pid VERIFIED (ps -p <pid> -o tty=,comm=)
# still a claude on the parked pane's own tty, on a tier-2 verdict.
#
# Sourceable (the pure decision/builder functions below), like bin/worktrees'
# own guard: hand them back and run nothing when sourced rather than
# executed. See tests/test-hq-reap.sh.

DOTFILES="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
# shellcheck source=/dev/null
source "$DOTFILES/bin/project-dirs-lib"
# shellcheck source=/dev/null
source "$DOTFILES/bin/tmux-claude-lib"
# shellcheck source=/dev/null
source "$DOTFILES/bin/worktrees"

# REAP_DIR comes from bin/hq-snapshot (sourced via bin/worktrees above) —
# its one home.
REAP_PARK_SECS="${HQ_REAP_PARK_SECS:-43200}"

# ---- pure halves: decision table, command builders, detectors ----

# reap_sq <string> — single-quoted for a line typed into a shell, embedded
# quotes escaped the '\'' way (mirrors tmux-task-session's _task_sq).
reap_sq() {
    local s="$1" q="'"
    printf "'%s'" "${s//$q/$q\\$q$q}"
}

# reap_resume_cmd <session-name> [model] [effort] — into $reap_resume_cmd_out:
# the typed command that resumes a parked claude by name.
reap_resume_cmd() {
    local name="$1" model="${2:-}" effort="${3:-}" cmd
    cmd="claude --resume $(reap_sq "$name")"
    [[ -n "$model" ]] && cmd="$cmd --model $model"
    [[ -n "$effort" ]] && cmd="$cmd --effort $effort"
    reap_resume_cmd_out="$cmd"
}

# reap_parse_model_effort <ps-args> — into $reap_model_out/$reap_effort_out,
# the seat flags a task session's claude was launched with.
reap_parse_model_effort() {
    local args="$1"
    reap_model_out=""
    reap_effort_out=""
    [[ "$args" =~ --model[[:space:]]+([A-Za-z0-9._-]+) ]] && reap_model_out="${BASH_REMATCH[1]}"
    [[ "$args" =~ --effort[[:space:]]+([A-Za-z0-9._-]+) ]] && reap_effort_out="${BASH_REMATCH[1]}"
}

# reap_is_task_args <ps-args> — true when a claude's argv still carries the
# launch brief's leading `/feature --run` (sessions from before @task existed).
reap_is_task_args() {
    [[ "$1" == *"/feature --run"* ]]
}

# reap_pane_busy <pane_current_command> — true when a NON-AGENT pane runs
# something other than a shell or an editor (a leading "-" login-shell marker
# stripped first): work in flight, so the session is never a candidate.
reap_pane_busy() {
    local cmd="${1#-}"
    case "$cmd" in
        zsh|bash|sh|fish|nvim|vim|vi) return 1 ;;
        *) return 0 ;;
    esac
}

# reap_decide <task> <tied> <attached> <busy-cmd> <bad-pane-status> \
#             <dirty> <pr_state> <unpushed> <merged_local> <pr_head> <wt_head> \
#             <phase> <pane_count> <has_transcript> <idle_secs> <park_secs> <parked>
#   The whole decision table into one line on stdout: "kill <reason>" /
#   "park <reason>" / "keep <reason>". Tier 1's bucket/removability test is
#   bin/worktrees' own classify_worktree/sweep_is_removable with live and
#   prunable forced false — the task session IS the liveness signal here, not
#   lsof. Tier 2 only ever runs past an IN-REVIEW (PR OPEN) bucket, and never
#   twice on the same park: a claude that ignored SIGTERM must not be
#   resignalled every pass.
reap_decide() {
    local task="$1" tied="$2" attached="$3" busy="$4" pane_bad="$5"
    local dirty="$6" pr_state="$7" unpushed="$8" merged_local="$9"
    local pr_head="${10}" wt_head="${11}"
    local phase="${12}" pane_count="${13}" has_transcript="${14}"
    local idle_secs="${15}" park_secs="${16}" parked="${17}"
    local bucket

    [[ "$task" == true ]] || { printf 'keep not a task session'; return; }
    [[ "$tied" == true ]] || { printf 'keep not tied to a worktree'; return; }
    [[ "$attached" == true ]] && { printf 'keep attached'; return; }
    [[ -n "$busy" ]] && { printf 'keep busy pane: %s' "$busy"; return; }
    [[ -n "$pane_bad" ]] && { printf 'keep agent %s' "$pane_bad"; return; }

    bucket=$(classify_worktree false "$dirty" false "$pr_state" "$unpushed" "$merged_local")
    case "$bucket" in
        MERGED)
            if sweep_is_removable MERGED "$unpushed" "$pr_state" "$pr_head" "$wt_head" "$merged_local"; then
                printf 'kill merged'
            else
                printf 'keep merged, unpushed'
            fi
            return ;;
        ABANDONED)
            if [[ "$unpushed" != true || "$pr_head" == "$wt_head" ]]; then
                printf 'kill closed'
            else
                printf 'keep closed, unpushed'
            fi
            return ;;
        IN-REVIEW) : ;;
        *) printf 'keep %s' "$bucket"; return ;;
    esac

    [[ "$parked" == true ]] && { printf 'keep already parked'; return; }
    [[ "$phase" == done ]] || { printf 'keep phase %s' "${phase:-none}"; return; }
    (( pane_count == 1 )) || { printf 'keep %s agent panes' "$pane_count"; return; }
    [[ "$has_transcript" == true ]] || { printf 'keep no transcript'; return; }
    (( idle_secs >= park_secs )) || { printf 'keep idle %ds < %ds' "$idle_secs" "$park_secs"; return; }
    printf 'park idle %ds' "$idle_secs"
}

# Sourced (tests/test-hq-reap.sh) rather than executed: hand back the pure
# functions above and run nothing live.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0 2>/dev/null || true
fi

set -uo pipefail

usage() {
    cat <<'EOF'
usage: hq-reap               dry run — print every verdict, act on nothing
       hq-reap --apply       act: kill tier-1 verdicts, park tier-2 verdicts
       hq-reap resume <session>   wake a parked session's claude by name

Tiers (see the file header for the invariants):
  tier 1  kill   a task session's worktree PR is MERGED/CLOSED and nothing
                 unique would be lost; the tmux session dies, the worktree
                 stays on disk.
  tier 2  park   a phase-done task session's PR is still OPEN and it has
                 been idle >= HQ_REAP_PARK_SECS (default 43200 = 12h); its
                 claude gets SIGTERM, its tmux session/pane/worktree stay.
                 `hq-reap resume <session>`, or simply visiting the session
                 (Ctrl+F, wt-tmux-jump, Ctrl+G's Enter), resumes its claude.

Never a candidate: not a task session, not tied to a linked worktree,
attached, any agent pane working/permission/unknown, any non-agent pane
busy with something other than a shell or editor. Never removed: no
worktree, no file — ever.

Env overrides:
  HQ_REAP_DIR         default ~/.local/state/hq/reap — last-run stamp + log
  HQ_REAP_PARK_SECS   default 43200 (12h) — tier 2's idle threshold

Every kill/park --apply performs is appended to $HQ_REAP_DIR/log.tsv
(append-only — nothing under ~/.local/state/hq is ever removed). Exit 0 on
a dry run; --apply exits 2 if any action failed.
EOF
}

# ---- live-system glue (not unit-tested; thin wrappers over tmux/ps/jq) ----

# reap_session_is_task <session> — @task option, else the pre-@task
# fallback: any pane's tty running a claude whose argv matches reap_is_task_args.
reap_session_is_task() {
    local name="$1" v tty args
    v=$(tmux show-options -qv -t "$name" @task 2>/dev/null)
    [[ "$v" == 1 ]] && return 0
    while IFS= read -r tty; do
        tty="${tty#/dev/}"
        args=$(printf '%s\n' "$_REAP_PS_DUMP" | awk -v t="$tty" -F'\t' '$1==t{ $1=""; print; exit }')
        [[ -n "$args" ]] && reap_is_task_args "$args" && return 0
    done < <(tmux list-panes -s -t "$name" -F '#{pane_tty}' 2>/dev/null)
    return 1
}

# reap_session_busy_pane <session> — into stdout, the first non-shell/editor
# pane command found among the session's NON-agent panes, empty when none.
reap_session_busy_pane() {
    local name="$1" _pane cmd tty
    while IFS=$'\t' read -r _pane cmd tty; do
        tty="${tty#/dev/}"
        [[ "$_REAP_AGENT_TTYS" == *$'\n'"$tty"$'\n'* ]] && continue
        if reap_pane_busy "$cmd"; then
            printf '%s' "$cmd"
            return
        fi
    done < <(tmux list-panes -s -t "$name" -F $'#{pane_id}\t#{pane_current_command}\t#{pane_tty}' 2>/dev/null)
}

# reap_session_agent_panes <session> — into $reap_pane_count_out and
# $reap_bad_status_out (first working/permission/unknown status, else empty)
# from the already-collected machine-wide agent pane scan.
reap_session_agent_panes() {
    local name="$1" s p _w _a st
    reap_pane_count_out=0
    reap_bad_status_out=""
    reap_last_pane_out=""
    while IFS=$'\t' read -r s p _w _a st; do
        [[ "$s" == "$name" ]] || continue
        reap_pane_count_out=$(( reap_pane_count_out + 1 ))
        reap_last_pane_out="$p"
        case "$st" in
            working|permission|unknown)
                [[ -z "$reap_bad_status_out" ]] && reap_bad_status_out="$st" ;;
        esac
    done <<< "$_REAP_AGENT_PANES"
}

# reap_claude_json <pane-id> — into $reap_pid_out/$reap_name_out/
# $reap_sessionid_out/$reap_cwd_out, from ~/.claude/sessions/*.json whose
# tmux field names this exact pane. Several matches (a crash, or a resumed
# session left its old json behind) prefer the one whose pid is still alive
# over whichever glob sorts first; empty pid when no match at all.
reap_claude_json() {
    local pane="$1" lines line pid first="" alive=""
    reap_pid_out=""; reap_name_out=""; reap_sessionid_out=""; reap_cwd_out=""
    lines=$(jq -r --arg pane "$pane" 'select((.tmux // "") | endswith("." + $pane)) | [.pid,.name,.sessionId,.cwd] | @tsv' \
        "${CLAUDE_SESSIONS_DIR}"/*.json 2>/dev/null)
    [[ -n "$lines" ]] || return 0
    while IFS= read -r line; do
        [[ -z "$first" ]] && first="$line"
        pid="${line%%$'\t'*}"
        if [[ -z "$alive" && -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            alive="$line"
        fi
    done <<< "$lines"
    IFS=$'\t' read -r reap_pid_out reap_name_out reap_sessionid_out reap_cwd_out <<< "${alive:-$first}"
}

# reap_worktree_rows_load — the fresh worktrees snapshot's rows into
# $_REAP_ROWS (one recollect attempt when stale/wrong-shaped). Exit 1 and
# nothing else on failure: the caller must act on nothing, not stale facts.
reap_worktree_rows_load() {
    local sv
    sv=$(snapshot_verdict "$(snapshot_age worktrees)" "$(snapshot_cadence worktrees)")
    if [[ "$sv" != fresh ]] || ! snapshot_rows_current; then
        "$DOTFILES/bin/hq-snapshot" worktrees >/dev/null 2>&1
        sv=$(snapshot_verdict "$(snapshot_age worktrees)" "$(snapshot_cadence worktrees)")
    fi
    if [[ "$sv" != fresh ]] || ! snapshot_rows_current; then
        echo "hq-reap: worktrees snapshot unusable ($sv) — acting on nothing" >&2
        return 1
    fi
    _REAP_ROWS=$(snapshot_read worktrees)
}

# reap_row_for_session <session-name> — fills the f_row_* globals from the
# one worktrees row whose session_name_for(path) matches, empty $f_row_path
# on a miss.
reap_row_for_session() {
    local target="$1" kind _repo _bucket _branch pr_disp flags _age _where _pipe _epoch path _locked _sweepable
    local pr_state pr_head wt_head merged_local
    f_row_path=""
    while IFS=$'\t' read -r kind _repo _bucket _branch pr_disp flags _age _where _pipe _epoch path _locked _sweepable \
        pr_state pr_head wt_head merged_local; do
        [[ "$kind" == row ]] || continue
        session_name_for "$path"
        [[ "$session_name" == "$target" ]] || continue
        f_row_path="$path"
        f_row_pr_disp="$pr_disp"
        f_row_pr_state="$pr_state"
        f_row_pr_head="$pr_head"
        f_row_wt_head="$wt_head"
        f_row_merged_local="$merged_local"
        f_row_dirty=false
        case " $flags " in *' dirty '*) f_row_dirty=true ;; esac
        f_row_unpushed=false
        case " $flags " in *' unpushed '*) f_row_unpushed=true ;; esac
        return 0
    done <<< "$_REAP_ROWS"
    return 1
}

# reap_log <kind> <session> <worktree> <pr> <reason> — appends one line to
# $REAP_DIR/log.tsv. Append-only: nothing under ~/.local/state/hq is removed.
reap_log() {
    mkdir -p "$REAP_DIR" || return 1
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" "$4" "$5" \
        >> "$REAP_DIR/log.tsv"
}

# ---- one pass over every tmux session: build a verdict line per candidate ----

REAP_FAIL=0

reap_pass() {
    local apply="$1" name attached busy pane_bad phase idle_secs=0 has_transcript=false
    local pr_disp="-" age_disp="-" verdict verb reason

    _REAP_AGENT_PANES=$(scan_agent_panes)
    _REAP_AGENT_TTYS=$'\n'"$(agent_ttys | cut -f1)"$'\n'
    # comm-filtered to claude: a tty commonly carries several processes
    # (the login shell, background npm/node tools), and the fallback below
    # needs the claude's own argv, never whichever one ps lists first.
    _REAP_PS_DUMP=$(ps -A -o tty=,comm=,args= 2>/dev/null | awk '$2=="claude"{tty=$1; $1=$2=""; sub(/^  /,""); print tty "\t" $0}')

    reap_worktree_rows_load || return 1

    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        local task=false tied=false dirty=false pr_state="" unpushed=false merged_local=false
        local pr_head="-" wt_head="-" phase="" now attached_raw last_attached
        local parked=false parked_raw
        pr_disp="-"

        reap_session_is_task "$name" && task=true
        [[ "$task" == true ]] || continue

        if reap_row_for_session "$name"; then
            tied=true
            dirty="$f_row_dirty"; pr_state="$f_row_pr_state"; unpushed="$f_row_unpushed"
            merged_local="$f_row_merged_local"; pr_head="$f_row_pr_head"; wt_head="$f_row_wt_head"
            pr_disp="$f_row_pr_disp"
            phase=$(pipeline_state "$f_row_path")
        fi

        attached_raw=$(tmux display-message -p -t "$name" '#{session_attached}' 2>/dev/null)
        attached=false
        [[ -n "$attached_raw" && "$attached_raw" != "0" ]] && attached=true

        parked_raw=$(tmux show-options -qv -t "$name" @parked 2>/dev/null)
        [[ -n "$parked_raw" ]] && parked=true

        busy=$(reap_session_busy_pane "$name")
        reap_session_agent_panes "$name"
        pane_bad="$reap_bad_status_out"

        reap_pid_out=""; reap_name_out=""; reap_sessionid_out=""; reap_cwd_out=""
        if [[ "$tied" == true && -n "$reap_last_pane_out" ]]; then
            reap_claude_json "$reap_last_pane_out"
        fi
        if [[ -n "$reap_pid_out" && -n "$reap_sessionid_out" ]]; then
            local jsonl mtime
            jsonl="${CLAUDE_PROJECTS_DIR}/$(encode_cwd "$reap_cwd_out")/${reap_sessionid_out}.jsonl"
            if mtime=$(file_mtime "$jsonl" 2>/dev/null); then
                has_transcript=true
                now=$(date +%s)
                last_attached=$(tmux display-message -p -t "$name" '#{session_last_attached}' 2>/dev/null)
                [[ "$last_attached" =~ ^[0-9]+$ ]] || last_attached=0
                (( last_attached > mtime )) && mtime=$last_attached
                idle_secs=$(( now - mtime ))
            else
                has_transcript=false
                idle_secs=0
            fi
        else
            has_transcript=false
            idle_secs=0
        fi

        # pipeline_state's phase carries " r<round> <seat>" too (it is also
        # the PIPELINE column's text); reap_decide only ever tests the word.
        verdict=$(reap_decide "$task" "$tied" "$attached" "$busy" "$pane_bad" \
            "$dirty" "$pr_state" "$unpushed" "$merged_local" "$pr_head" "$wt_head" \
            "${phase%% *}" "$reap_pane_count_out" "$has_transcript" "$idle_secs" "$REAP_PARK_SECS" "$parked")
        verb="${verdict%% *}"
        reason="${verdict#* }"
        age_disp="-"
        (( idle_secs > 0 )) && age_disp=$(fmt_secs "$idle_secs")

        if [[ "$apply" == true ]]; then
            case "$verb" in
                kill) reap_apply_kill "$name" "$f_row_path" "$pr_disp" "$reason" ;;
                park) reap_apply_park "$name" "$reap_pid_out" "$reap_name_out" "$f_row_path" "$pr_disp" "$reason" ;;
            esac
        else
            local verb_disp
            case "$verb" in
                kill) verb_disp=KILL ;;
                park) verb_disp=PARK ;;
                *)    verb_disp=KEEP ;;
            esac
            printf '%-5s %-45s %-20s %-18s %-8s %s\n' \
                "$verb_disp" "$name" "$pr_disp" "${phase:--}" "$age_disp" "$reason"
        fi
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
}

# reap_apply_kill <session> <worktree> <pr> <reason> — tmux kill-session, logged.
reap_apply_kill() {
    local name="$1" wt="$2" pr="$3" reason="$4"
    if tmux kill-session -t "=${name}" 2>/dev/null; then
        reap_log kill "$name" "${wt:--}" "${pr:--}" "$reason"
        printf 'KILL %s: %s\n' "$name" "$reason"
    else
        echo "hq-reap: kill-session failed for $name" >&2
        REAP_FAIL=1
    fi
}

# reap_apply_park <session> <pid> <peer-name> <worktree> <pr> <reason> —
# verifies the pid is still a claude on the parked pane's own tty, SIGTERMs
# it, then marks the session parked with the exact resume command.
reap_apply_park() {
    local name="$1" pid="$2" peer="$3" wt="$4" pr="$5" reason="$6"
    local pane="$reap_last_pane_out" pane_tty ps_tty ps_comm args model effort epoch
    [[ -n "$pid" && -n "$pane" ]] || { echo "hq-reap: park: no pid/pane for $name" >&2; REAP_FAIL=1; return; }

    pane_tty=$(tmux display-message -p -t "$pane" '#{pane_tty}' 2>/dev/null)
    pane_tty="${pane_tty#/dev/}"
    read -r ps_tty ps_comm < <(ps -p "$pid" -o tty=,comm= 2>/dev/null)
    ps_tty="${ps_tty#/dev/}"
    if [[ "$ps_tty" != "$pane_tty" || "$ps_comm" != *claude* ]]; then
        echo "hq-reap: park: pid $pid is no longer $name's claude — skipping" >&2
        REAP_FAIL=1
        return
    fi

    args=$(ps -p "$pid" -o args= 2>/dev/null)
    reap_parse_model_effort "$args"
    model="$reap_model_out"; effort="$reap_effort_out"

    kill -TERM "$pid" 2>/dev/null

    reap_resume_cmd "${peer:-$name}" "$model" "$effort"
    epoch=$(date +%s)
    tmux set-option -t "$name" @task 1
    tmux set-option -t "$name" @parked "$epoch"
    tmux set-option -t "$name" @parked_pane "$pane"
    tmux set-option -t "$name" @parked_cmd "$reap_resume_cmd_out"
    reap_log park "$name" "${wt:--}" "${pr:--}" "$reason"
    printf 'PARK %s: %s\n' "$name" "$reason"
}

# ---- args ----

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    resume)
        name="${2:?usage: hq-reap resume <session>}"
        unpark_session "$name"
        exit $?
        ;;
    --apply)
        # Re-exec under a held lock, like hq-snapshot tick: a second run
        # finds it held and exits at once. -k keeps the lock file, so
        # nothing is ever removed to release it.
        if [[ -z "${HQ_REAP_LOCKED:-}" ]]; then
            HQ_REAP_LOCKED=1 exec lockf -k -s -t 0 "${TMPDIR:-/tmp}/hq-reap.lock" "$0" --apply
        fi
        mkdir -p "$REAP_DIR" || exit 2
        touch "$REAP_DIR/last-run" || exit 2
        reap_pass true
        exit $(( REAP_FAIL ? 2 : 0 ))
        ;;
    "")
        reap_pass false
        exit 0
        ;;
    *)
        echo "hq-reap: unknown argument: $1" >&2
        usage >&2
        exit 2
        ;;
esac
