#!/usr/bin/env bash
# doctor — read-only health check for this dotfiles install: what a rerun of
# the setup scripts would change, with every line naming the script that
# fixes it. It changes NOTHING itself. Exit 0 clean, 1 when anything is
# flagged. (setup.sh is the fresh-machine bootstrap; this is the after-a-pull
# check.)
#
# Every section is another script's own --check mode, so the doctor never
# holds a second copy of what "correct" means. Add one the same way: give the
# owning script a --check and call it here.
set -uo pipefail

DOTFILES="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
failed=0

section() { printf '\n== %s\n' "$1"; }

section "machine-local config (other/)"
"$DOTFILES/bin/seed_other.sh" --check || failed=1

section "symlinks"
"$DOTFILES/bin/symlink_files.sh" --check || failed=1

section "brew (etc/Brewfile_mac)"
if command -v brew >/dev/null 2>&1; then
    # --verbose names the missing deps; plain output only says "can't satisfy".
    # No auto-update: a health check must not spend a minute refreshing taps.
    HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 \
    brew bundle check --verbose --no-upgrade --file="$DOTFILES/etc/Brewfile_mac" \
        || { echo "  fix: brew bundle --no-upgrade --file=etc/Brewfile_mac"; failed=1; }
else
    echo "  brew not on PATH — skipped"
fi

echo
if (( failed )); then
    echo "doctor: issues found (see above)"
    exit 1
fi
echo "doctor: all clear"
