#!/usr/bin/env bash
# Claude Code PreToolUse(Bash) guard.
# Blocks the "expensive command piped into head/tail" footgun (loses output),
# and the "set -o pipefail + | head/tail" footgun (SIGPIPE aborts the pipeline,
# and with set -e the whole script). Checks the command string AND the contents
# of any .sh file the command executes.
#
# Fix it teaches: capture full output to a file, then slice the FILE:
#   ./run.sh > /tmp/out.log 2>&1; tail -60 /tmp/out.log
#
# stdin: PreToolUse hook JSON. Deny => print permissionDecision JSON. Allow => exit 0.
set -euo pipefail

input="$(cat)"
cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // ""' 2>/dev/null || true)"
cwd="$(printf '%s' "$input" | jq -r '.cwd // ""' 2>/dev/null || true)"
[ -z "$cmd" ] && exit 0

# Runners whose output is expensive to reproduce / must not be truncated away.
EXPENSIVE='pytest|/pytest\.sh|(^|[^a-z])uv run|flutter[ _]|dart run|(^|[^a-z])cdk |run_cdk|npm (run|test|ci)|yarn (test|build)|pnpm |go test|cargo (test|build)|gradle|mvn |(^|[^a-z])make (test|build|lint)|redis-cli[^|]*scan|(^|[^a-z])k6 |terraform (plan|apply)|docker build|deploy'
# A pipe into head/tail (with optional flags/spaces).
TRUNC='\|[[:space:]]*(head|tail)([[:space:]]|$)'
# pipefail turned on anywhere.
PIPEFAIL='set[[:space:]]+-[a-zA-Z]*o?[a-zA-Z]*[[:space:]]*pipefail|set[[:space:]]+-o[[:space:]]+pipefail|pipefail'

reason=""

check_text() {  # $1 = text, $2 = where (for message)
  local text="$1" where="$2"
  # tee or a redirect-capture means full output is preserved -> not the footgun.
  local has_tee=0
  printf '%s' "$text" | grep -Eq '\|[[:space:]]*tee([[:space:]]|$)' && has_tee=1
  # A: expensive | head/tail without a tee in the pipeline.
  if [ "$has_tee" -eq 0 ] \
     && printf '%s' "$text" | grep -Eiq "$EXPENSIVE" \
     && printf '%s' "$text" | grep -Eiq "$TRUNC"; then
    reason="Blocked: an expensive/long-running command is piped straight into head/tail${where}, which throws away the rest of its output. Capture full output to a file, then slice the file: \`<cmd> > /tmp/out.log 2>&1; tail -60 /tmp/out.log\` (or pipe through \`tee /tmp/out.log | tail\`)."
    return 0
  fi
  # B: pipefail + | head/tail  -> SIGPIPE aborts the pipeline (with set -e, the script).
  if printf '%s' "$text" | grep -Eiq "$PIPEFAIL" \
     && printf '%s' "$text" | grep -Eiq "$TRUNC"; then
    reason="Blocked: \`pipefail\` is combined with a pipe into head/tail${where}. When head/tail closes the pipe early the upstream stage gets SIGPIPE, pipefail promotes it to a pipeline failure, and \`set -e\` then aborts the script mid-run (this is exactly what silently killed a recon script). Drop pipefail on that pipeline, or write full output to a file and slice the file afterwards."
    return 0
  fi
  return 1
}

# 1) the command string itself
if check_text "$cmd" ""; then
  jq -nc --arg r "$reason" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'
  exit 0
fi

# 2) any .sh file the command executes -> scan its contents
for tok in $(printf '%s' "$cmd" | grep -oE '[^[:space:]"'"'"']+\.sh' || true); do
  f=""
  if [ -f "$tok" ]; then f="$tok"
  elif [ -n "$cwd" ] && [ -f "$cwd/$tok" ]; then f="$cwd/$tok"
  fi
  [ -z "$f" ] && continue
  body="$(cat "$f" 2>/dev/null || true)"
  [ -z "$body" ] && continue
  if check_text "$body" " inside the script $tok"; then
    jq -nc --arg r "$reason" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'
    exit 0
  fi
done

exit 0
