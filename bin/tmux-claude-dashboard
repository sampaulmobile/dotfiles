#!/usr/bin/env bash

# Interactive dashboard for Claude Code tmux sessions.
# Shows status, token usage, and model for all claude-* sessions.
# Bound to Ctrl+G via tmux neww.

source ~/dotfiles/bin/tmux-claude-lib

CACHE_DIR="/tmp/claude-dashboard"
mkdir -p "$CACHE_DIR/agents"

# max chars kept from an agent's last assistant text (before responsive
# truncation shortens it further to fit the terminal width)
AGENT_SNIPPET_MAXLEN=100

# ── colors ──────────────────────────────────────────────

RST=$'\033[0m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
CYAN=$'\033[36m'
YELLOW=$'\033[33m'
RED=$'\033[31m'
BOLD_RED=$'\033[1;31m'
GREEN=$'\033[32m'
DIM_GREEN=$'\033[2;32m'
DIM_RED=$'\033[2;31m'

# ── helpers ─────────────────────────────────────────────

# reload_sessions
#   Re-collects the session list from tmux.
#   Preserves selected cursor by session name (not index), since the list
#   is sorted by activity time and the order changes between refreshes.
reload_sessions() {
    local prev=""
    if (( ${#sessions[@]} > 0 && selected < ${#sessions[@]} )); then
        prev="${sessions[$selected]}"
    fi
    sessions=()
    while IFS= read -r s; do
        sessions+=("$s")
    done < <(get_claude_sessions)
    session_count=${#sessions[@]}
    selected=0
    if [[ -n "$prev" ]]; then
        for i in "${!sessions[@]}"; do
            [[ "${sessions[$i]}" == "$prev" ]] && selected=$i && break
        done
    fi
    (( selected >= session_count )) && selected=$(( session_count - 1 ))
    (( selected < 0 )) && selected=0
}

# kill_selected_session
#   Kills the tmux session at the current selection. No silent failure
#   paths: any refusal/error is reported via kill_error for the caller to
#   display. Killing the dashboard's own host session is ALLOWED (the x
#   handler warns first) — with detach-on-destroy off the client just moves
#   to the last session; this window dies with its host.
kill_error=""
kill_selected_session() {
    kill_error=""
    (( session_count == 0 )) && { kill_error="no sessions"; return 1; }
    local target="${sessions[$selected]}"
    [[ -z "$target" ]] && { kill_error="empty target (row/session index mismatch?)"; return 1; }
    local err
    # exact name match (= prefix prevents tmux prefix-matching)
    if ! err=$(tmux kill-session -t "=${target}" 2>&1); then
        kill_error="tmux: ${err:-kill-session failed}"
        return 1
    fi
}

get_session_stats() {
    local session="$1"
    local jsonl
    jsonl=$(find_session_jsonl "$session")

    if [[ -z "$jsonl" ]]; then
        printf '0\t0\t0\tunknown'
        return
    fi

    # fast: context + model from tail of file
    local ctx_model
    ctx_model=$(get_context_and_model "$jsonl")
    local ctx mdl
    IFS=$'\t' read -r ctx mdl <<< "$ctx_model"

    # incremental: totals from cache + delta (keyed by jsonl path for /clear safety)
    local jsonl_hash
    jsonl_hash=$(echo "$jsonl" | md5 -q 2>/dev/null || echo "$jsonl" | md5sum 2>/dev/null | cut -d' ' -f1)
    local totals_cache="${CACHE_DIR}/${session}.${jsonl_hash}.totals"
    local totals
    totals=$(get_totals_incremental "$jsonl" "$totals_cache")
    local tout tall
    IFS=$'\t' read -r tout tall <<< "$totals"

    printf '%s\t%s\t%s\t%s' "$ctx" "$tout" "$tall" "$mdl"
}

# get_session_agent_tree <tmux-session-name>
#   Prints one line per live subagent under this session, tab-separated:
#   agent_id, depth, parent_id, agentType, description, mtime, context,
#   output, model, snippet. Per-agent stats/snippet use mtime-keyed cache
#   files under CACHE_DIR so an idle agent's transcript isn't re-parsed
#   every refresh. Prints nothing if the session has no agents (or no
#   resolvable transcript) — never errors.
get_session_agent_tree() {
    local session="$1"
    local jsonl
    jsonl=$(find_session_jsonl "$session")
    [[ -z "$jsonl" ]] && return

    local proj_dir sid subdir
    proj_dir=$(dirname "$jsonl")
    sid=$(basename "$jsonl" .jsonl)
    subdir="${proj_dir}/${sid}/subagents"

    local aid depth parent atype adesc amtime
    while IFS=$'\t' read -r aid depth parent atype adesc amtime; do
        [[ -z "$aid" ]] && continue
        local agent_jsonl="${subdir}/agent-${aid}.jsonl"
        local ctx out mdl
        IFS=$'\t' read -r ctx out mdl < <(get_agent_stats "$agent_jsonl" "${CACHE_DIR}/agents/${session}.${aid}.stats")
        local snippet
        snippet=$(get_agent_snippet "$agent_jsonl" "$AGENT_SNIPPET_MAXLEN" "${CACHE_DIR}/agents/${session}.${aid}.snippet")
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$aid" "$depth" "$parent" "$atype" "$adesc" "$amtime" "$ctx" "$out" "$mdl" "$snippet"
    done < <(list_session_agents "$jsonl")
}

# ── render ──────────────────────────────────────────────

render() {
    local cols
    cols=$(tmux display-message -p '#{pane_width}' 2>/dev/null || tput cols 2>/dev/null || echo 80)

    # find longest session name
    local max_name=7
    for n in "${names[@]}"; do
        (( ${#n} > max_name )) && max_name=${#n}
    done

    local min_name=12
    local ctx_w=9 out_w=9 all_w=9 mdl_w=12

    # row_width computes exact visible chars for a given configuration
    # row = marker(2) + name_w + status(15) + ctx(9) [+ 1+out] [+ 1+all] [+ 2+mdl]
    row_width() {
        local nw=$1 o=$2 t=$3 m=$4
        local w=$(( 2 + nw + 15 + ctx_w ))
        (( o )) && w=$(( w + 1 + out_w ))
        (( t )) && w=$(( w + 1 + all_w ))
        (( m )) && w=$(( w + 2 + mdl_w ))
        echo $w
    }

    # try each layout: prefer full names, drop columns before truncating
    local show_model=0 show_output=0 show_total=0 name_w=$max_name

    if (( $(row_width $max_name 1 1 1) <= cols )); then
        show_output=1; show_total=1; show_model=1; name_w=$max_name
    elif (( $(row_width $max_name 1 1 0) <= cols )); then
        show_output=1; show_total=1; name_w=$max_name
    elif (( $(row_width $max_name 1 0 0) <= cols )); then
        show_output=1; name_w=$max_name
    elif (( $(row_width $max_name 0 0 0) <= cols )); then
        name_w=$max_name
    else
        # must truncate — try adding columns back with truncated names
        if (( $(row_width $min_name 1 1 1) <= cols )); then
            show_output=1; show_total=1; show_model=1
        elif (( $(row_width $min_name 1 1 0) <= cols )); then
            show_output=1; show_total=1
        elif (( $(row_width $min_name 1 0 0) <= cols )); then
            show_output=1
        fi
        # name gets whatever is left
        name_w=$(( cols - 2 - 15 - ctx_w ))
        (( show_output )) && name_w=$(( name_w - 1 - out_w ))
        (( show_total ))  && name_w=$(( name_w - 1 - all_w ))
        (( show_model ))  && name_w=$(( name_w - 2 - mdl_w ))
        (( name_w < min_name )) && name_w=$min_name
    fi

    # if there's spare space, add a gap between name and status (up to 3)
    local spare=$(( cols - $(row_width $name_w $show_output $show_total $show_model) ))
    local name_gap=0
    (( spare > 0 )) && name_gap=$spare
    (( name_gap > 3 )) && name_gap=3

    local out=""
    local now
    now=$(date +%s)

    # header
    local rhs="[⏎ · x · X · a · r · q]"
    (( cols >= 80 )) && rhs="[⏎ switch · x kill · X prune · a agents · r refresh · q quit]"
    local title="  Claude Sessions"
    local pad=$(( cols - ${#title} - ${#rhs} ))
    (( pad < 1 )) && pad=1
    out+="${BOLD}${title}${RST}$(printf '%*s' "$pad" '')${DIM}${rhs}${RST}"$'\n'
    out+="  $(printf '─%.0s' $(seq 1 $(( cols - 4 ))))"$'\n'

    # column headers
    local hdr
    local hdr_name_w=$(( name_w + name_gap ))
    hdr=$(printf "%-${hdr_name_w}s %-13s %${ctx_w}s" "SESSION" "STATUS" "CONTEXT")
    (( show_output )) && hdr+=$(printf " %${out_w}s" "OUTPUT")
    (( show_total ))  && hdr+=$(printf " %${all_w}s" "TOTAL")
    (( show_model ))  && hdr+=$(printf "  %-${mdl_w}s" "MODEL")
    out+="  ${DIM}${hdr}${RST}"$'\n'

    # rows
    for i in "${!sessions[@]}"; do
        local working_agents="${agent_working_counts[$i]:-0}"

        # live-agent badge eats into the name's own width budget
        local badge=""
        (( working_agents > 0 )) && badge=" +${working_agents}"
        local avail_name_w=$(( name_w - ${#badge} ))
        (( avail_name_w < 1 )) && avail_name_w=1

        local name="${names[$i]}"
        if (( ${#name} > avail_name_w )); then
            name="${name:0:$(( avail_name_w - 1 ))}…"
        fi

        local st="${statuses[$i]}"
        local ctx="${contexts[$i]}"
        local out_tok="${outputs[$i]}"
        local all_tok="${total_alls[$i]}"
        local mdl="${models[$i]}"

        # marker + name (+ badge, if this session has working agents)
        if (( i == selected )); then
            out+="${CYAN}▸ ${RST}${BOLD}"
        else
            out+="  "
        fi
        out+="${name}"
        (( working_agents > 0 )) && out+="${CYAN}${badge}${RST}"
        out+="$(printf '%*s' "$(( name_w - ${#name} - ${#badge} + name_gap ))" '')"
        (( i == selected )) && out+="${RST}"

        # an idle session with an attention done-flag (finished but unseen —
        # the statusbar's ✅ and C-o's jump target) shows as "done" here so
        # the dashboard reveals WHICH session the bar's ✅ belongs to
        if [[ "$st" == "idle" && -e "$HOME/.cache/claude-attention/${names[$i]}.done" ]]; then
            st="done"
        fi

        # status — padded to exactly 15 visible columns
        # ⏳ is Wide (2 cols), ⚙ and ● are Narrow (1 col); ✅ is Wide (2 cols)
        case "$st" in
            working)    out+="${YELLOW}⚙ working${RST}      " ;;
            idle)       out+="${DIM_GREEN}● idle${RST}         " ;;
            done)       out+="${GREEN}✅ done${RST}        " ;;
            permission) out+="${BOLD_RED}⏳ permission${RST}  " ;;
            gone)       out+="${DIM_RED}✗ gone${RST}         " ;;
            loading)    out+="${DIM}… loading${RST}     " ;;
            *)          out+="${DIM}? unknown${RST}      " ;;
        esac

        # context column — color coded by size
        local ctx_raw="$ctx"
        local ctx_fmt
        ctx_fmt=$(format_tokens "$ctx_raw")
        local ctx_color=""
        if (( ctx_raw >= 600000 )); then
            ctx_color="${BOLD_RED}"
        elif (( ctx_raw >= 300000 )); then
            ctx_color="${RED}"
        elif (( ctx_raw >= 100000 )); then
            ctx_color="${YELLOW}"
        fi

        out+="${ctx_color}$(printf "%${ctx_w}s" "$ctx_fmt")${RST}"
        (( show_output )) && out+="$(printf " %${out_w}s" "$out_tok")"
        (( show_total ))  && out+="$(printf " %${all_w}s" "$all_tok")"
        (( show_model ))  && out+="  ${DIM}${mdl}${RST}"
        out+=$'\n'

        # agent tree — auto-expand sessions with a working agent; 'a' forces
        # every session's tree open (including idle-only agents)
        local expand=0
        (( agents_forced )) && expand=1
        (( working_agents > 0 )) && expand=1
        if (( expand )) && [[ -n "${agent_lines[$i]}" ]]; then
            local aid adepth aparent atype adesc amtime actx aout amdl asnip
            while IFS=$'\t' read -r aid adepth aparent atype adesc amtime actx aout amdl asnip; do
                [[ -z "$aid" ]] && continue
                # Defense in depth for B3: ${#row_plain} below counts a tab
                # as 1 char, but the terminal expands it to the next
                # 8-column stop — neutralize any tab that reaches these
                # fields (from any source) before it can break the width
                # math that keeps rows from wrapping/misaligning.
                adesc="${adesc//$'\t'/ }"
                atype="${atype//$'\t'/ }"
                asnip="${asnip//$'\t'/ }"
                local aage=$(( now - amtime ))
                local aworking=0
                local amarker="◯" amarker_color="${DIM}"
                if (( aage <= LIVE_AGENT_SECS )); then
                    amarker="●"
                    amarker_color="${YELLOW}"
                    aworking=1
                fi
                local aage_str
                aage_str=$(format_age "$aage")

                local aindent
                aindent=$(printf '%*s' $(( 2 * adepth )) '')

                # ── SESSION column: tree marker + description, aligned to
                # the same hdr_name_w field the session name column uses.
                # Whole-string truncation (rather than truncating only the
                # description) guarantees this field never exceeds
                # hdr_name_w even in a pathological deep-nesting-vs-narrow-
                # terminal case, which keeps every column after it aligned
                # with the header no matter what.
                local sess_prefix="${aindent}└ "
                local sess_full="${sess_prefix}${amarker} ${adesc}"
                local sess_plain sess_colored
                if (( ${#sess_full} <= hdr_name_w )); then
                    sess_plain="$sess_full"
                    sess_colored="${sess_prefix}${amarker_color}${amarker}${RST} ${adesc}"
                elif (( hdr_name_w > ${#sess_prefix} + 2 )); then
                    local dbudget=$(( hdr_name_w - ${#sess_prefix} - 2 ))
                    local dtrunc="$adesc"
                    if (( ${#dtrunc} > dbudget )); then
                        (( dbudget > 1 )) && dtrunc="${dtrunc:0:$(( dbudget - 1 ))}…" || dtrunc="…"
                    fi
                    sess_plain="${sess_prefix}${amarker} ${dtrunc}"
                    sess_colored="${sess_prefix}${amarker_color}${amarker}${RST} ${dtrunc}"
                else
                    # extreme case: not even room for indent+marker+1 char —
                    # hard-truncate the whole field, drop color rather than
                    # risk cutting mid-escape-sequence.
                    local hbudget=$(( hdr_name_w > 1 ? hdr_name_w - 1 : 1 ))
                    sess_plain="${sess_full:0:$hbudget}…"
                    sess_colored="$sess_plain"
                fi
                local sess_pad=$(( hdr_name_w - ${#sess_plain} ))
                (( sess_pad < 0 )) && sess_pad=0

                # ── STATUS column: working/idle styled like session status,
                # age appended — fixed 15-visible-col field, same as session
                # rows.
                local st_label st_color
                if (( aworking )); then
                    st_label="working ${aage_str}"
                    st_color="${YELLOW}"
                else
                    st_label="idle ${aage_str}"
                    st_color="${DIM_GREEN}"
                fi
                (( ${#st_label} > 15 )) && st_label="${st_label:0:15}"
                local st_pad=$(( 15 - ${#st_label} ))
                (( st_pad < 0 )) && st_pad=0

                # ── CONTEXT / OUTPUT / TOTAL / MODEL — same field widths
                # and same show_output/show_total/show_model gating the
                # session row already computed for this render, so agent
                # rows drop columns at identical breakpoints.
                local actx_fmt aout_fmt
                actx_fmt=$(format_tokens "${actx:-0}")
                aout_fmt=$(format_tokens "${aout:-0}")

                local row=""
                row+="  ${sess_colored}$(printf '%*s' "$sess_pad" '')"
                row+="${st_color}${st_label}${RST}$(printf '%*s' "$st_pad" '')"
                row+="$(printf "%${ctx_w}s" "$actx_fmt")"
                (( show_output )) && row+="$(printf " %${out_w}s" "$aout_fmt")"
                (( show_total ))  && row+="$(printf " %${all_w}s" "-")"
                if (( show_model )); then
                    local amdl_field="$atype"
                    if (( ${#amdl_field} > mdl_w )); then
                        (( mdl_w > 1 )) && amdl_field="${amdl_field:0:$(( mdl_w - 1 ))}…" || amdl_field="…"
                    fi
                    row+="  ${DIM}${amdl_field}${RST}"
                fi
                out+="${row}"$'\n'

                # ── activity snippet — own dim full-width line beneath the
                # row, indented past the tree marker to the description's
                # start column; working agents only.
                if (( aworking )) && [[ -n "$asnip" ]]; then
                    local snip_indent
                    snip_indent=$(printf '%*s' $(( 2 + ${#sess_prefix} + 2 )) '')
                    local snip_plain="${snip_indent}\"${asnip}\""
                    if (( ${#snip_plain} > cols - 1 )); then
                        local sbudget=$(( cols - 1 - ${#snip_indent} - 2 ))
                        (( sbudget < 1 )) && sbudget=1
                        local strunc="$asnip"
                        if (( ${#strunc} > sbudget )); then
                            (( sbudget > 1 )) && strunc="${strunc:0:$(( sbudget - 1 ))}…" || strunc="…"
                        fi
                        snip_plain="${snip_indent}\"${strunc}\""
                    fi
                    out+="${DIM}${snip_plain}${RST}"$'\n'
                fi
            done <<< "${agent_lines[$i]}"
        fi
    done

    out+=$'\n'
    # Responsive like the header rhs above: the round-1 "a agents" addition
    # made this 85 chars, wider than an 80-col terminal (was 74 before),
    # wrapping onto the next line and garbling the display — a real
    # regression caught during round-2 smoke testing, not in the original
    # findings list. Drop the added text at narrow widths instead.
    local footer="  j/k navigate · ⏎ switch · x kill · X prune · r refresh · R hard · q quit"
    (( cols >= 85 )) && footer="  j/k navigate · ⏎ switch · x kill · X prune · a agents · r refresh · R hard · q quit"
    out+="${DIM}${footer}${RST}"

    printf '\033[H\033[2J%s' "$out"
}

# ── data collection ─────────────────────────────────────

load_data() {
    names=()
    statuses=()
    contexts=()
    outputs=()
    total_alls=()
    models=()
    agent_lines=()
    agent_working_counts=()
    agent_total_counts=()

    # show names immediately with placeholders
    for sess in "${sessions[@]}"; do
        names+=("${sess#claude-}")
        statuses+=("loading")
        contexts+=("0")
        outputs+=("—")
        total_alls+=("—")
        models+=("")
        agent_lines+=("")
        agent_working_counts+=("0")
        agent_total_counts+=("0")
    done
    render

    # batch CWD→sessionId map once
    build_cwd_session_map

    # collect all data in parallel — each session writes to a temp file
    local parallel_dir="${CACHE_DIR}/parallel.$$"
    mkdir -p "$parallel_dir"

    for i in "${!sessions[@]}"; do
        (
            sess="${sessions[$i]}"
            cwd=$(get_pane_cwd "$sess")
            cwd_ok=1
            [[ -n "$cwd" && ! -d "$cwd" ]] && cwd_ok=0
            st=$(get_session_status "$sess")
            stats=$(get_session_stats "$sess")
            printf '%s\t%s\t%s' "$cwd_ok" "$st" "$stats" > "${parallel_dir}/${i}"
            get_session_agent_tree "$sess" > "${parallel_dir}/${i}.agents"
        ) &
    done
    wait

    # read results and populate arrays
    local now
    now=$(date +%s)
    for i in "${!sessions[@]}"; do
        local result_file="${parallel_dir}/${i}"
        if [[ -f "$result_file" ]]; then
            local cwd_ok st ctx tout tall mdl
            IFS=$'\t' read -r cwd_ok st ctx tout tall mdl < "$result_file"
            [[ "$cwd_ok" == "0" ]] && st="gone"
            statuses[$i]="$st"
            contexts[$i]="$ctx"
            outputs[$i]=$(format_tokens "$tout")
            total_alls[$i]=$(format_tokens "$tall")
            models[$i]=$(short_model "$mdl")
        fi

        local agents_file="${parallel_dir}/${i}.agents"
        if [[ -s "$agents_file" ]]; then
            agent_lines[$i]=$(<"$agents_file")
            local total=0 working=0 amtime
            while IFS=$'\t' read -r _ _ _ _ _ amtime _ _ _ _; do
                [[ -z "$amtime" ]] && continue
                (( total++ ))
                (( now - amtime <= LIVE_AGENT_SECS )) && (( working++ ))
            done < "$agents_file"
            agent_total_counts[$i]="$total"
            agent_working_counts[$i]="$working"
        fi
    done

    rm -rf "$parallel_dir"
    render
}

# ── main loop ───────────────────────────────────────────

tput civis 2>/dev/null
trap 'tput cnorm 2>/dev/null; rm -f "$_CWD_MAP_FILE" 2>/dev/null' EXIT

selected=0
sessions=()
names=()
statuses=()
contexts=()
outputs=()
total_alls=()
models=()
agent_lines=()
agent_working_counts=()
agent_total_counts=()
agents_forced=0

# initial load
reload_sessions

if (( session_count == 0 )); then
    printf '\033[H\033[2J'
    printf "${DIM}  No claude sessions running.${RST}\n"
    read -rsn1 key
    exit 0
fi

load_data

# input loop — no auto-refresh, just respond to keys
while true; do
    key=""
    read -rsn1 key || true

    if [[ "$key" == $'\x1b' ]]; then
        read -rsn2 -t 0.1 seq || true
        case "$seq" in
            '[A') key="UP" ;;
            '[B') key="DOWN" ;;
            *)    key="ESC" ;;
        esac
    fi

    case "$key" in
        j|DOWN)
            (( selected++ ))
            (( selected >= session_count )) && selected=$(( session_count - 1 ))
            render
            ;;
        k|UP)
            (( selected-- ))
            (( selected < 0 )) && selected=0
            render
            ;;
        a)
            # toggle forcing every session's agent tree open (sessions with
            # a working agent auto-expand regardless of this toggle)
            (( agents_forced = !agents_forced ))
            render
            ;;
        r)
            # soft refresh: re-collect sessions, use cached totals
            reload_sessions
            load_data
            ;;
        x)
            # kill selected session (confirm if live)
            if (( session_count > 0 )); then
                _do_kill=0
                _myself=$(tmux display-message -p '#S' 2>/dev/null)
                _selfwarn=""
                [[ "${sessions[$selected]}" == "$_myself" ]] && _selfwarn=" ${RED}— hosts THIS dashboard, it will close too${RST}${YELLOW}"
                if [[ "${statuses[$selected]}" == "gone" && -z "$_selfwarn" ]]; then
                    _do_kill=1
                else
                    # confirm before killing a live (or self-hosting) session
                    tput cnorm 2>/dev/null
                    printf '\033[%d;3H' $(( session_count + 6 ))
                    printf "${YELLOW}Kill session ${names[$selected]}${_selfwarn}? [y/N]${RST} "
                    _confirm=""
                    read -rsn1 _confirm
                    tput civis 2>/dev/null
                    [[ "$_confirm" == "y" || "$_confirm" == "Y" ]] && _do_kill=1
                fi
                if (( _do_kill )); then
                    if kill_selected_session; then
                        reload_sessions
                        if (( session_count == 0 )); then
                            printf '\033[H\033[2J'
                            printf "${DIM}  No claude sessions running.${RST}\n"
                            read -rsn1
                            exit 0
                        fi
                        load_data
                    else
                        # no silent failures: show why, wait for ack
                        printf '\033[%d;3H' $(( session_count + 6 ))
                        printf "${RED}kill failed: %s${RST} (any key) " "$kill_error"
                        read -rsn1
                        render
                    fi
                else
                    render
                fi
            fi
            ;;
        X)
            # kill all gone sessions
            _killed=0
            for i in "${!sessions[@]}"; do
                if [[ "${statuses[$i]}" == "gone" ]]; then
                    tmux kill-session -t "=${sessions[$i]}" 2>/dev/null && (( _killed++ ))
                fi
            done
            if (( _killed > 0 )); then
                reload_sessions
                if (( session_count == 0 )); then
                    printf '\033[H\033[2J'
                    printf "${DIM}  No claude sessions running.${RST}\n"
                    read -rsn1
                    exit 0
                fi
                load_data
            fi
            ;;
        R)
            # hard refresh: re-collect sessions, clear totals + agent caches
            reload_sessions
            rm -f "${CACHE_DIR}"/*.totals 2>/dev/null
            rm -f "${CACHE_DIR}/agents/"* 2>/dev/null
            load_data
            ;;
        ""|Enter)
            # switch to selected session
            if (( session_count > 0 )); then
                _target="${sessions[$selected]}"
                if [[ -n "$_target" ]]; then
                    tmux switch-client -t "=${_target}:1"
                    exit 0
                fi
            fi
            ;;
        q|ESC)
            exit 0
            ;;
    esac
done
