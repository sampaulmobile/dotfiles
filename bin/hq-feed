#!/usr/bin/env bash
# The screen's ONLY tmux subcommands: list-clients, display, has-session,
# new-session (its own `hq-feed` session) and switch-client (its own
# client). The other-client move is bin/tmux-claude-attention's `jump-to`,
# invoked as a separate process — this script never switch-clients a
# DIFFERENT client itself. WRITES NOTHING of its own: no seen stamp, no
# state dir; DONE's "not yet visited" is the attention flag file, cleared
# by tmux-claude-attention when `g` lands on it.
#
# UTF-8/width discipline, fd safety and the view loop's timeout-vs-key
# distinction are the same bash 3.2 gotchas as bin/hq-decisions (see its
# decisions_ensure_utf8_locale/pad, its fd-safety header and view()).

DOTFILES="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
SELF="$DOTFILES/bin/hq-feed"
# shellcheck source=/dev/null
source "$DOTFILES/bin/hq-snapshot"
# format_age only (pure formatter, no tmux call at source time).
# shellcheck source=/dev/null
source "$DOTFILES/bin/tmux-claude-lib"

FLAG_DIR="${FLAG_DIR:-$HOME/.cache/claude-attention}"

feed_ensure_utf8_locale() {
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
        *UTF-8*|*utf8*|*UTF8*) return 0 ;;
    esac
    if locale -a 2>/dev/null | grep -qx 'C.UTF-8'; then
        export LC_CTYPE=C.UTF-8
    else
        export LC_CTYPE=en_US.UTF-8
    fi
}
feed_ensure_utf8_locale

usage() {
    cat <<'EOF'
usage: hq-feed                      open (or create) the hq-feed tmux session
       hq-feed --view               run the viewer in this terminal
       hq-feed --dump               print the LIST once and exit
       hq-feed --dump --detail PANE print one block's DETAIL once

One block per live agent pane (bin/hq-snapshot's `turns` source), bucketed by
what it needs from the owner, newest transcript first within a bucket:

  NEEDS YOU   pane status permission
  DONE        an attention flag (~/.cache/claude-attention/<session>@<pane>.done)
              exists for the pane — "not yet visited": nobody has landed on
              that pane since it finished (Ctrl+Y's own rule); cleared by `g`
              landing on it, by Ctrl+Y, or by visiting the pane, which drops
              it out of this bucket on the next load
  WORKING     pane status working
  IDLE        everything else; hidden by default as a count line, `a` toggles

Glyphs: permission, done, working (the statusbar's own 🔴/✅/●); IDLE rows
carry none.

Block, LIST view (a blank line separates blocks):
  <label>      [<pipeline tag> ·] [#<pr> ·] <glyph> <word> <age>   (right-aligned
                                                                  to the text width)
               #<pr> is the pipeline's PR from the pipelines source: a
               clickable OSC 8 link on a terminal when its URL is known.
  you › <prompt>              — kind "you": the owner's last typed prompt
  msg › <from>: <prompt>      — kind "msg": a cross-session message instead
  now → <tool>                — WORKING only: the tool_use in flight
  ask › <pending>              — NEEDS YOU only: the tool_use awaiting a result
                                  (AskUserQuestion renders its question text)
  it  › <reply>                — the last assistant text, markdown-flattened
                                  (headings/**/backticks stripped, a fenced
                                  block -> [code], a run of | lines ->
                                  [table], */+ bullets -> "- "), wrapped to
                                  the text width, blank lines dropped, up to
                                  4 lines; when more remain the 4th carries a
                                  right-aligned "(+N lines)" marker, clipped
                                  with … to make room. Shown whenever a reply
                                  exists.
Text width: the terminal, capped at FEED_WIDTH columns (default 110) so a
wide window does not stretch a reply into one long line. DETAIL keeps the
reply's blank lines. The you ›/msg › line is dim; the reply is not. A GitHub
PR URL in the reply collapses to #N, a clickable OSC 8 link on a terminal.
A codex pane shows its glyph, label and age only — no exchange lines
(get_last_exchange is Claude-only).

Label: the session name, "session:N" for a pane outside window 1 (the
dashboard's rule), replaced outright by the pane's claude session `name`
when one differs from the session (~/.claude/sessions/*.json).

Header: `FEED  N needs you · N done · N working · N idle` then
`updated <age> ago`, marked stale past turns' three cadences.

Keys:
  j/k   move by block; the whole block scrolls into view, and the
        "↑ N blocks · ↓ N blocks" line counts what is off screen
                             ⏎   DETAIL: full prompt + full stripped reply,
  a     show/hide IDLE             scrollable; q/esc/backspace back
  g     jump the OTHER tmux client to this block's exact pane
  r     recollect (runs `bin/hq-snapshot turns` first, then reloads)
  ^C    quit

The viewer never recollects on its own between keypresses — only `r` does.
EOF
}

RST=""; BOLD=""; DIM=""; SEL=""; LINK=""; LINKS=false
C_NEEDS=""; C_DONE=""; C_WORKING=""
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]]; then
    RST=$'\033[0m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; SEL=$'\033[48;5;236m'
    LINK=$'\033[34;4m'; LINKS=true
    C_NEEDS=$'\033[33m'; C_DONE=$'\033[32m'; C_WORKING=$'\033[34m'
fi

term_size() {
    local w="${COLUMNS:-}" h="${LINES:-}" sz
    if ! [[ "$w" =~ ^[1-9][0-9]*$ && "$h" =~ ^[1-9][0-9]*$ ]] \
       && sz=$( { stty size </dev/tty; } 2>/dev/null ) \
       && [[ "$sz" =~ ^[1-9][0-9]*\ [1-9][0-9]*$ ]]; then
        h="${sz% *}"; w="${sz#* }"
    fi
    [[ "$w" =~ ^[1-9][0-9]*$ ]] || w=$(tput cols 2>/dev/null)
    [[ "$h" =~ ^[1-9][0-9]*$ ]] || h=$(tput lines 2>/dev/null)
    [[ "$w" =~ ^[0-9]+$ ]] || w=100
    [[ "$h" =~ ^[0-9]+$ ]] || h=40
    term_w="$w"
    term_h="$h"
}

clip() {
    local t="$1" w="$2"
    (( w < 1 )) && { printf ''; return 0; }
    if (( ${#t} > w )); then printf '%s…' "${t:0:w-1}"; else printf '%s' "$t"; fi
}

pad() {
    local t="$1" w="$2" align="${3:-left}" n
    n=$(( w - ${#t} ))
    (( n < 0 )) && n=0
    if [[ "$align" == right ]]; then printf '%*s%s' "$n" '' "$t"
    else printf '%s%*s' "$t" "$n" ''
    fi
}

count_lines() {
    local s="$1" nl
    nl="${s//[^$'\n']/}"
    printf '%s' "${#nl}"
}

# See bin/hq-decisions' decisions_split: splits on any char in <seps> into
# the global SPLIT_OUT with no `read`/`<<<`/`< <(…)`.
feed_split() {
    local text="$1" seps="$2" oIFS="$IFS" had_f=0
    case "$-" in *f*) had_f=1 ;; esac
    IFS="$seps"
    set -f
    SPLIT_OUT=($text)
    IFS="$oIFS"
    (( had_f )) || set +f
}

# Every line including empty ones, no here-string. See bin/hq-decisions'
# decisions_split_lines_preserve.
feed_split_lines_preserve() {
    local text="$1" rest line
    SPLIT_OUT=()
    rest="$text"
    while :; do
        if [[ "$rest" == *$'\n'* ]]; then
            line="${rest%%$'\n'*}"
            rest="${rest#*$'\n'}"
        else
            line="$rest"
            rest=""
        fi
        SPLIT_OUT+=("$line")
        [[ -z "$rest" ]] && break
    done
}

# Pure bash word wrap (see bin/hq-decisions).
wrap_text() {
    local text="$1" width="$2" para rest line word out="" first_para=true
    (( width < 1 )) && width=1
    rest="$text"
    while :; do
        if [[ "$rest" == *$'\n'* ]]; then
            para="${rest%%$'\n'*}"
            rest="${rest#*$'\n'}"
        else
            para="$rest"
            rest=""
        fi
        if [[ "$first_para" == true ]]; then first_para=false; else out+=$'\n'; fi
        line=""
        feed_split "$para" $' \t\n'
        for word in ${SPLIT_OUT[@]+"${SPLIT_OUT[@]}"}; do
            while (( ${#word} > width )); do
                if [[ -n "$line" ]]; then
                    out+="$line"$'\n'
                    line=""
                fi
                out+="${word:0:width}"$'\n'
                word="${word:width}"
            done
            if [[ -z "$line" ]]; then
                line="$word"
            elif (( ${#line} + 1 + ${#word} <= width )); then
                line+=" $word"
            else
                out+="$line"$'\n'
                line="$word"
            fi
        done
        out+="$line"
        [[ -z "$rest" ]] && break
    done
    printf '%s' "$out"
}

other_client() {
    local mine out line act tty best="" bestact=-1
    mine=$(tmux display -p '#{client_tty}' 2>/dev/null)
    out=$(tmux list-clients -F '#{client_activity} #{client_tty}' 2>/dev/null)
    feed_split_lines_preserve "$out"
    for line in ${SPLIT_OUT[@]+"${SPLIT_OUT[@]}"}; do
        act=""; tty=""
        if [[ "$line" == *' '* ]]; then act="${line%% *}"; tty="${line#* }"; fi
        [[ -n "$tty" && "$tty" != "$mine" ]] || continue
        [[ "$act" =~ ^[0-9]+$ ]] || continue
        if (( act > bestact )); then bestact="$act"; best="$tty"; fi
    done
    printf '%s' "$best"
}

p_session=(); p_pane=(); p_window=(); p_agent=(); p_status=(); p_name=()
p_mtime=(); p_jsonl=(); p_kind=(); p_cwd=()
p_prompt=(); p_prompt_list=(); p_from=(); p_reply=(); p_tool=(); p_pending=(); p_links=()
p_label=(); p_pipe=(); p_pr=(); p_pr_url=(); p_bucket=(); p_age=()
order=()
n_needs=0; n_done=0; n_working=0; n_idle=0
TURNS_AGE=-1; TURNS_VERDICT=missing
STATUS_NOTE=""

# First match wins. <done?> is the already-resolved flag-file test, not a
# path.
feed_bucket() {
    local status="$1" done="$2"
    if [[ "$status" == permission ]]; then printf 'NEEDS YOU'
    elif [[ "$done" == true ]]; then printf 'DONE'
    elif [[ "$status" == working ]]; then printf 'WORKING'
    else printf 'IDLE'
    fi
}

# The dashboard's "session:N" rule, replaced outright by <name> when the
# record carries one.
feed_label() {
    local session="$1" window="$2" name="$3"
    if [[ -n "$name" && "$name" != "-" ]]; then
        printf '%s' "$name"
    elif [[ -n "$window" && "$window" != "1" && "$window" != "-" ]]; then
        printf '%s:%s' "$session" "$window"
    else
        printf '%s' "$session"
    fi
}

# A jq fragment (string, not a function call), spliced into load_data's
# one jq pass: strips markdown that reads badly in a terminal.
_FEED_STRIP_MD_JQ='
def strip_md:
  . as $text
  | ($text | split("\n")) as $lines
  | (reduce $lines[] as $l (
       {out: [], code: false, table: false};
       if ($l | test("^\\s*```")) then
         if .code then {out: .out, code: false, table: false}
         else {out: (.out + ["[code]"]), code: true, table: false}
         end
       elif .code then .
       elif ($l | test("^\\s*\\|.*\\|\\s*$")) then
         if .table then .
         else {out: (.out + ["[table]"]), code: false, table: true}
         end
       else
         ( .code = false | .table = false
         | ($l
            | gsub("^#{1,6}[ \t]+"; "")
            | gsub("\\*\\*"; "")
            | gsub("`"; "")
            | gsub("^(?<ind>[ \t]*)[*+][ \t]+"; "\(.ind)- ")
           ) as $cl
         | .out += [$cl]
         )
       end
     )
     | .out)
  | join("\n");
'

# No per-pane fork and no bash `${var//x/y}` over a reply: the jq pass
# emits one sentinel-delimited block per pane and the loop below
# reconstructs each field by APPENDING lines (never substituting), which is
# what keeps a 32 KB reply off bash 3.2's quadratic ${var//} path (see
# bin/tmux-claude-lib's get_agent_snippet header).
load_data() {
    local body sep out
    p_session=(); p_pane=(); p_window=(); p_agent=(); p_status=(); p_name=()
    p_mtime=(); p_jsonl=(); p_kind=(); p_cwd=()
    p_prompt=(); p_prompt_list=(); p_from=(); p_reply=(); p_tool=(); p_pending=(); p_links=()
    p_label=(); p_pipe=(); p_pr=(); p_pr_url=(); p_bucket=(); p_age=()
    order=()
    n_needs=0; n_done=0; n_working=0; n_idle=0

    TURNS_AGE=$(snapshot_age turns)
    TURNS_VERDICT=$(snapshot_verdict "$TURNS_AGE" "$(snapshot_cadence turns)")
    body=$(snapshot_read turns 2>/dev/null)
    pipeline_map_load
    pipeline_pr_map_load

    [[ -n "$body" ]] || return 0

    sep="@@FEED-$$-${RANDOM}@@"
    out=$(printf '%s\n' "$body" | jq -Rn -r --arg sep "$sep" \
        --arg pr_url 'https://github\.com/[^/ ]+/[^/ ]+/pull/(?<n>[0-9]+)' "$_FEED_STRIP_MD_JQ"'
        def dec: if . == "-" then "-" else fromjson end;
        [inputs | select(length > 0) | split("\t")] as $rows
        | $rows[]
        | . as $f
        | ($f[9]  | dec) as $prompt_raw
        | ($f[10] | dec) as $from
        | ($f[11] | dec) as $reply_raw
        | ($f[12] | dec) as $tool
        | ($f[13] | dec) as $pending
        | ($reply_raw | if . == "-" then "-" else strip_md end
           | if . == "-" then "-" else gsub($pr_url; "\u0001" + .n + "\u0002") end) as $reply
        | ($reply_raw | if . == "-" then "-"
           else [match($pr_url; "g") | .string | (split("/") | last) + "=" + .] | unique | join(" ") end
           | if . == "" then "-" else . end) as $links
        | ($prompt_raw | if . == "-" then "-" else .[0:32768] end) as $prompt
        | ($prompt | if . == "-" then "-"
                     else .[0:1024] | gsub("[\\n\\t\\x00-\\x1f\\x7f]"; " ") end) as $prompt_list
        | $sep + "H", ([$f[0],$f[1],$f[2],$f[3],$f[4],$f[5],$f[6],$f[7],$f[8],$f[14]] | join("\t")),
          $sep + "P", $prompt,
          $sep + "L", $prompt_list,
          $sep + "F", $from,
          $sep + "R", $reply,
          $sep + "T", $tool,
          $sep + "D", $pending,
          $sep + "K", $links
    ' 2>/dev/null)

    local cur_field="" cur_buf="" first_in_field=true line
    local session pane window agent status name mtime jsonl kind cwd
    flush_field() {
        case "$cur_field" in
            P) p_prompt+=("$cur_buf") ;;
            L) p_prompt_list+=("$cur_buf") ;;
            F) p_from+=("$cur_buf") ;;
            R) p_reply+=("$cur_buf") ;;
            T) p_tool+=("$cur_buf") ;;
            D) p_pending+=("$cur_buf") ;;
            K) p_links+=("$cur_buf") ;;
        esac
    }
    feed_split_lines_preserve "$out"
    for line in ${SPLIT_OUT[@]+"${SPLIT_OUT[@]}"}; do
        case "$line" in
            "${sep}H")
                flush_field
                cur_field="HDR"; cur_buf=""; first_in_field=true
                continue ;;
            "${sep}P") flush_field; cur_field=P; cur_buf=""; first_in_field=true; continue ;;
            "${sep}L") flush_field; cur_field=L; cur_buf=""; first_in_field=true; continue ;;
            "${sep}F") flush_field; cur_field=F; cur_buf=""; first_in_field=true; continue ;;
            "${sep}R") flush_field; cur_field=R; cur_buf=""; first_in_field=true; continue ;;
            "${sep}T") flush_field; cur_field=T; cur_buf=""; first_in_field=true; continue ;;
            "${sep}D") flush_field; cur_field=D; cur_buf=""; first_in_field=true; continue ;;
            "${sep}K") flush_field; cur_field=K; cur_buf=""; first_in_field=true; continue ;;
        esac
        if [[ "$cur_field" == HDR ]]; then
            feed_split "$line" $'\t'
            session="${SPLIT_OUT[0]-}"; pane="${SPLIT_OUT[1]-}"; window="${SPLIT_OUT[2]-}"
            agent="${SPLIT_OUT[3]-}"; status="${SPLIT_OUT[4]-}"; name="${SPLIT_OUT[5]-}"
            mtime="${SPLIT_OUT[6]-}"; jsonl="${SPLIT_OUT[7]-}"; kind="${SPLIT_OUT[8]-}"; cwd="${SPLIT_OUT[9]-}"
            p_session+=("$session"); p_pane+=("$pane"); p_window+=("$window")
            p_agent+=("$agent"); p_status+=("$status"); p_name+=("$name")
            p_mtime+=("$mtime"); p_jsonl+=("$jsonl"); p_kind+=("$kind"); p_cwd+=("$cwd")
            cur_field=""
            continue
        fi
        if [[ "$first_in_field" == true ]]; then cur_buf="$line"; first_in_field=false
        else cur_buf+=$'\n'"$line"
        fi
    done
    flush_field

    local n=${#p_session[@]} i done_flag flag_file sortable now
    now=$(date +%s)
    for (( i = 0; i < n; i++ )); do
        flag_file="$FLAG_DIR/${p_session[$i]}@${p_pane[$i]#%}.done"
        done_flag=false
        [[ -e "$flag_file" ]] && done_flag=true
        p_bucket+=("$(feed_bucket "${p_status[$i]}" "$done_flag")")
        p_label+=("$(feed_label "${p_session[$i]}" "${p_window[$i]}" "${p_name[$i]}")")
        p_pipe+=("$(pipeline_for_cwd "${p_cwd[$i]}")")
        pipeline_pr_for_cwd "${p_cwd[$i]}"
        p_pr+=("$PR_NUM"); p_pr_url+=("$PR_URL")
        case "${p_bucket[$i]}" in
            'NEEDS YOU') n_needs=$(( n_needs + 1 )) ;;
            DONE)        n_done=$(( n_done + 1 )) ;;
            WORKING)     n_working=$(( n_working + 1 )) ;;
            *)           n_idle=$(( n_idle + 1 )) ;;
        esac
        local m="${p_mtime[$i]}" age=""
        if [[ "$m" =~ ^[0-9]+$ ]]; then age=$(( now - m )); else m=0; fi
        p_age+=("$age")
        sortable+="$(_feed_bucket_rank "${p_bucket[$i]}")"$'\t'"$m"$'\t'"$i"$'\n'
    done

    (( n == 0 )) && return 0
    local sorted line
    sorted=$(printf '%s' "$sortable" | sort -t$'\t' -k1,1n -k2,2nr)
    feed_split_lines_preserve "$sorted"
    for line in ${SPLIT_OUT[@]+"${SPLIT_OUT[@]}"}; do
        [[ -n "$line" ]] || continue
        order+=("${line##*$'\t'}")
    done
}

_feed_bucket_rank() {
    case "$1" in
        'NEEDS YOU') printf 0 ;;
        DONE)        printf 1 ;;
        WORKING)     printf 2 ;;
        *)           printf 3 ;;
    esac
}

feed_glyph() {
    case "$1" in
        'NEEDS YOU') printf '%s' "🔴" ;;
        DONE)        printf '%s' "✅" ;;
        WORKING)     printf '%s' "●" ;;
        *)           printf '%s' " " ;;
    esac
}

feed_word() {
    case "$1" in
        'NEEDS YOU') printf 'perm' ;;
        DONE)        printf 'done' ;;
        WORKING)     printf 'working' ;;
        *)           printf 'idle' ;;
    esac
}

feed_color() {
    case "$1" in
        'NEEDS YOU') printf '%s' "$C_NEEDS" ;;
        DONE)        printf '%s' "$C_DONE" ;;
        WORKING)     printf '%s' "$C_WORKING" ;;
        *)           printf '%s' "$DIM" ;;
    esac
}

# The pipelines record's pr field for the worktree <cwd> sits in, as
# PR_NUM and PR_URL. The field is a URL from a full run but a bare number
# from a --quick one; a bare number borrows its pull-URL base from any
# record of the same repo that has a URL, and stays unlinked (PR_URL empty)
# when none does.
PR_NUM=""; PR_URL=""
pipeline_pr_map=""
pipeline_pr_map_load() {
    local line path repo pr base
    pipeline_pr_map=""
    feed_split_lines_preserve "$(snapshot_read pipelines 2>/dev/null)"
    for line in ${SPLIT_OUT[@]+"${SPLIT_OUT[@]}"}; do
        feed_split "$line" $'\t'
        path="${SPLIT_OUT[0]-}"; repo="${SPLIT_OUT[2]-}"; pr="${SPLIT_OUT[5]-}"
        [[ -n "$path" && -n "$pr" && "$pr" != "-" ]] || continue
        base=""
        [[ "$pr" == */pull/* ]] && base="${pr%/pull/*}"
        pipeline_pr_map+="${path}"$'\t'"${repo}"$'\t'"${pr}"$'\t'"${base:--}"$'\n'
    done
}
pipeline_pr_for_cwd() {
    local cwd="$1" line path repo pr base hit_repo="" hit_pr=""
    PR_NUM=""; PR_URL=""
    [[ -n "$cwd" && -n "$pipeline_pr_map" ]] || return 0
    feed_split_lines_preserve "$pipeline_pr_map"
    for line in ${SPLIT_OUT[@]+"${SPLIT_OUT[@]}"}; do
        feed_split "$line" $'\t'
        path="${SPLIT_OUT[0]-}"; repo="${SPLIT_OUT[1]-}"; pr="${SPLIT_OUT[2]-}"
        [[ -n "$path" ]] || continue
        if [[ "$cwd" == "$path" || "$cwd" == "$path"/* ]]; then hit_repo="$repo"; hit_pr="$pr"; break; fi
    done
    [[ -n "$hit_pr" ]] || return 0
    if [[ "$hit_pr" == */pull/* ]]; then
        PR_NUM="${hit_pr##*/}"; PR_URL="$hit_pr"
        return 0
    fi
    [[ "$hit_pr" =~ ^[0-9]+$ ]] || return 0
    PR_NUM="$hit_pr"
    feed_split_lines_preserve "$pipeline_pr_map"
    for line in ${SPLIT_OUT[@]+"${SPLIT_OUT[@]}"}; do
        feed_split "$line" $'\t'
        repo="${SPLIT_OUT[1]-}"; base="${SPLIT_OUT[3]-}"
        if [[ "$repo" == "$hit_repo" && "$base" != "-" && -n "$base" ]]; then
            PR_URL="${base}/pull/${PR_NUM}"
            break
        fi
    done
}

# The \x01N\x02 markers load_data put where a PR URL was become "#N":
# wrapped as an OSC 8 link on a terminal, plain otherwise. The markers (not
# "#N") make the number's boundary unambiguous, so #211 inside #2110 can
# never be linked twice.
link_prs() {
    local idx="$1" line="$2" n url pair out="" pre
    while [[ "$line" == *$'\x01'* ]]; do
        pre="${line%%$'\x01'*}"; line="${line#*$'\x01'}"
        n="${line%%$'\x02'*}"; line="${line#*$'\x02'}"
        url=""
        for pair in ${p_links[$idx]}; do
            [[ "${pair%%=*}" == "$n" ]] && url="${pair#*=}"
        done
        if [[ "$LINKS" == true && -n "$url" ]]; then
            out+="${pre}${LINK}"$'\033]8;;'"${url}"$'\033\\'"#${n}"$'\033]8;;\033\\'"${RST}"
        else
            out+="${pre}#${n}"
        fi
    done
    printf '%s%s' "$out" "$line"
}

# The terminal, capped at FEED_WIDTH so a wide window doesn't stretch a
# reply into one long line.
body_width() {
    local w="$term_w" cap="${FEED_WIDTH:-110}"
    [[ "$cap" =~ ^[1-9][0-9]*$ ]] && (( w > cap )) && w="$cap"
    printf '%s' "$w"
}

append_block_body() {
    local idx="$1" width="$2" bucket="${p_bucket[$1]}" full="$3"
    local kind="${p_kind[$idx]}" prefix_w=8

    if [[ "$kind" == you || "$kind" == msg ]]; then
        local label="you ›"
        if [[ "$full" == true ]]; then
            local p="${p_prompt[$idx]}" wline first=true
            if [[ "$kind" == msg ]]; then label="msg ›"; p="${p_from[$idx]}: ${p}"; fi
            feed_split_lines_preserve "$(wrap_text "$p" $(( width - prefix_w )))"
            for wline in "${SPLIT_OUT[@]}"; do
                if [[ "$first" == true ]]; then frame_rows+=("  ${DIM}${label} ${wline}${RST}"); first=false
                else frame_rows+=("        ${DIM}${wline}${RST}")
                fi
            done
        else
            local p="${p_prompt_list[$idx]}"
            if [[ "$kind" == msg ]]; then label="msg ›"; p="${p_from[$idx]}: ${p}"; fi
            frame_rows+=("  ${DIM}${label} $(clip "$p" $(( width - prefix_w )))${RST}")
        fi
    fi

    if [[ "$bucket" == WORKING && "${p_tool[$idx]}" != "-" ]]; then
        frame_rows+=("  ${DIM}now →${RST} $(clip "${p_tool[$idx]//$'\n'/ }" $(( width - prefix_w )))")
    elif [[ "$bucket" == 'NEEDS YOU' && "${p_pending[$idx]}" != "-" ]]; then
        frame_rows+=("  ${DIM}ask ›${RST} $(clip "${p_pending[$idx]//$'\n'/ }" $(( width - prefix_w )))")
    fi

    if [[ "${p_reply[$idx]}" != "-" ]]; then
        local wrapped wline total=0 shown=0 first=true
        wrapped=$(wrap_text "${p_reply[$idx]}" $(( width - prefix_w )))
        feed_split_lines_preserve "$wrapped"
        local -a body_lines=()
        for wline in "${SPLIT_OUT[@]}"; do
            [[ "$full" != true && -z "$wline" ]] && continue
            body_lines+=("$wline")
        done
        total=${#body_lines[@]}
        local cap=4 text_w=$(( width - prefix_w )) tail=""
        [[ "$full" == true ]] && cap=$total
        for wline in ${body_lines[@]+"${body_lines[@]}"}; do
            if (( shown >= cap )); then break; fi
            if (( shown == cap - 1 && total > cap )); then
                # Last shown line carries the marker. A link marker is two
                # chars wider than the "#N" it renders as, so the plain width
                # is ${#wline} minus the link count; a clip that cuts through
                # one drops it rather than leaving half a marker behind.
                local marker nlinks plain_w avail m
                marker=$(printf '(+%d lines)' $(( total - cap )))
                m="${wline//[^$'\x01']/}"; nlinks=${#m}
                plain_w=$(( ${#wline} - nlinks ))
                avail=$(( text_w - ${#marker} - 1 ))
                if (( plain_w > avail )); then
                    wline=$(clip "$wline" $(( avail + nlinks )))
                    if [[ "$wline" == *$'\x01'* && "${wline##*$'\x01'}" != *$'\x02'* ]]; then
                        wline="${wline%$'\x01'*}…"
                    fi
                    m="${wline//[^$'\x01']/}"; nlinks=${#m}
                    plain_w=$(( ${#wline} - nlinks ))
                fi
                tail="$(pad '' $(( text_w - plain_w - ${#marker} )))${DIM}${marker}${RST}"
            fi
            if [[ "$first" == true ]]; then frame_rows+=("  ${DIM}it  ›${RST} $(link_prs "$idx" "$wline")${tail}"); first=false
            else frame_rows+=("        $(link_prs "$idx" "$wline")${tail}")
            fi
            shown=$(( shown + 1 ))
        done
    fi
}

build_list_frame() {
    local counts="${n_needs} needs you · ${n_done} done · ${n_working} working · ${n_idle} idle"
    local plain_left="FEED  ${counts}"
    local age_part=""
    if (( TURNS_AGE >= 0 )); then
        age_part="updated $(fmt_secs "$TURNS_AGE") ago"
        [[ "$TURNS_VERDICT" != fresh ]] && age_part+=" (stale)"
    fi
    local pad_n=$(( term_w - ${#plain_left} - ${#age_part} ))
    local header_line
    if (( ${#plain_left} > term_w )); then
        header_line="$(clip "$plain_left" "$term_w")"
    elif [[ -n "$age_part" ]] && (( pad_n >= 1 )); then
        header_line="${BOLD}FEED${RST}  ${counts}$(printf '%*s' "$pad_n" '')${age_part}"
    else
        header_line="${BOLD}FEED${RST}  ${counts}"
    fi
    frame_head="${header_line}"$'\n\n'

    frame_rows=(); cursor_map=(); frame_row_line=(); frame_section_line=()
    local last_bucket="" idx bucket label glyph word age agestr pipe headline color
    local bw status_plain gw lw rw gap
    bw=$(body_width)
    for idx in ${order[@]+"${order[@]}"}; do
        bucket="${p_bucket[$idx]}"
        if [[ "$bucket" == IDLE && "$show_idle" != true ]]; then continue; fi
        if [[ "$bucket" != "$last_bucket" ]]; then
            [[ -n "$last_bucket" ]] && frame_rows+=("")
            local section="$bucket"
            [[ "$bucket" == DONE ]] && section="DONE · not yet visited"
            frame_section_line+=("${#frame_rows[@]}")
            frame_rows+=(" ${DIM}${section}${RST}")
            last_bucket="$bucket"
        else
            frame_rows+=("")
        fi
        color=$(feed_color "$bucket")
        glyph=$(feed_glyph "$bucket")
        word=$(feed_word "$bucket")
        format_age agestr "${p_age[$idx]}"
        label="${p_label[$idx]}"
        pipe="${p_pipe[$idx]}"
        # Column 0 is a one-char gutter paint() overwrites with the cursor
        # mark, so the row must start with a plain space, never a color code.
        # ✅/🔴 take two cells but count as one in ${#}, hence gw.
        status_plain="${glyph} ${word} ${agestr}"
        gw=1; case "$glyph" in ✅|🔴) gw=2 ;; esac
        rw=$(( ${#status_plain} + gw - 1 ))
        [[ -n "$pipe" ]] && rw=$(( rw + ${#pipe} + 3 ))
        [[ -n "${p_pr[$idx]}" ]] && rw=$(( rw + ${#p_pr[$idx]} + 4 ))
        lw=$(( ${#label} + 1 ))
        gap=$(( bw - lw - rw ))
        if (( gap < 2 )); then
            label=$(clip "$label" $(( bw - rw - 3 )))
            lw=$(( ${#label} + 1 )); gap=$(( bw - lw - rw ))
            (( gap < 1 )) && gap=1
        fi
        headline=" ${color}${label}${RST}$(printf '%*s' "$gap" '')"
        [[ -n "$pipe" ]] && headline+="${DIM}${pipe} · ${RST}"
        if [[ -n "${p_pr[$idx]}" ]]; then
            if [[ "$LINKS" == true && -n "${p_pr_url[$idx]}" ]]; then
                headline+="${LINK}"$'\033]8;;'"${p_pr_url[$idx]}"$'\033\\'"#${p_pr[$idx]}"$'\033]8;;\033\\'"${RST}${DIM} · ${RST}"
            else
                headline+="${DIM}#${p_pr[$idx]} · ${RST}"
            fi
        fi
        headline+="${color}${status_plain}${RST}"
        cursor_map+=("$idx")
        frame_row_line+=("${#frame_rows[@]}")
        frame_rows+=("$headline")
        append_block_body "$idx" "$(body_width)" false
    done
    if [[ "$show_idle" != true ]] && (( n_idle > 0 )); then
        [[ -n "$last_bucket" ]] && frame_rows+=("")
        frame_rows+=(" ${DIM}IDLE · ${n_idle} hidden — a to show${RST}")
    fi
    (( ${#frame_rows[@]} == 0 )) && frame_rows+=("  ${DIM}no live agent panes${RST}")

    if (( selected >= ${#cursor_map[@]} )); then selected=$(( ${#cursor_map[@]} - 1 )); fi
    (( selected < 0 )) && selected=0
    local k
    for k in "${!cursor_map[@]}"; do
        if [[ "${cursor_map[$k]}" == "$selected_idx" ]]; then selected="$k"; break; fi
    done
    (( selected >= ${#cursor_map[@]} )) && selected=$(( ${#cursor_map[@]} - 1 ))
    (( selected < 0 )) && selected=0
    frame_cursor_line=-1
    if (( ${#cursor_map[@]} > 0 )); then
        selected_idx="${cursor_map[$selected]}"
        frame_cursor_line="${frame_row_line[$selected]}"
    fi

    frame_tail=""
    frame_foot="${DIM}$(clip "j/k move · ⏎ detail · a show/hide idle · g jump to pane · r recollect · ^C quit" "$term_w")${RST}"$'\n'
}

build_detail_frame() {
    local idx="$detail_idx" bucket="${p_bucket[$detail_idx]}"
    local glyph word agestr
    glyph=$(feed_glyph "$bucket")
    word=$(feed_word "$bucket")
    format_age agestr "${p_age[$idx]}"
    local pipe="${p_pipe[$idx]}"
    local line1="‹ q  back to list"
    local right1="${p_label[$idx]} · ${word} ${agestr}"
    [[ -n "$pipe" ]] && right1+=" · ${pipe}"
    [[ -n "${p_pr[$idx]}" ]] && right1+=" · #${p_pr[$idx]}"
    local pad1=$(( term_w - ${#line1} - ${#right1} ))
    local hl
    if (( pad1 >= 1 )); then
        hl="${line1}$(printf '%*s' "$pad1" '')${right1}"
    else
        hl="${line1} ${right1}"
    fi
    frame_head="$(clip "$hl" "$term_w")"$'\n'"${BOLD}${p_label[$idx]}${RST} ${glyph} ${bucket}"$'\n'

    frame_rows=()
    frame_rows+=("")
    append_block_body "$idx" "$(body_width)" true
    (( ${#frame_rows[@]} == 1 )) && frame_rows+=("  ${DIM}nothing to show${RST}")

    frame_tail=""
    frame_cursor_line=-1
    frame_foot="${DIM}$(clip "j/k scroll · q/esc back · g jump to pane · ^C quit" "$term_w")${RST}"$'\n'
}

frame_rows=(); frame_row_line=(); frame_section_line=(); frame_head=""; frame_tail=""; frame_foot=""
frame_cols=0; frame_at=0; selected=0; selected_idx=-1; frame_top=0
cursor_map=(); show_idle=false; view_mode=list; detail_idx=-1

build_frame() {
    term_size
    frame_cols="$term_w"
    frame_at=$(date +%s)
    frame_rows=()
    frame_tail=""
    if [[ "$view_mode" == detail ]]; then
        build_detail_frame
    else
        build_list_frame
    fi
}

paint() {
    term_size
    local head_lines tail_lines foot_lines body total sel last i out
    head_lines=$(count_lines "$frame_head")
    tail_lines=$(count_lines "$frame_tail")
    foot_lines=$(count_lines "$frame_foot")
    total=${#frame_rows[@]}
    body=$(( term_h - head_lines - tail_lines - foot_lines - 1 ))
    (( body < 1 )) && body=1
    sel=-1
    if (( frame_cursor_line >= 0 )); then
        sel="$frame_cursor_line"
        # The unit of scrolling is the block: its headline, its body, and the
        # section label above it when it is the first of its bucket. A
        # headline alone at the screen's edge hides exactly what the cursor
        # is pointing at.
        local b_start="$sel" b_end=$(( total - 1 )) r
        for r in ${frame_row_line[@]+"${frame_row_line[@]}"}; do
            if (( r > sel )); then b_end=$(( r - 1 )); break; fi
        done
        while (( b_end > sel )) && [[ -z "${frame_rows[$b_end]}" ]]; do b_end=$(( b_end - 1 )); done
        for r in ${frame_section_line[@]+"${frame_section_line[@]}"}; do
            (( r == sel - 1 )) && b_start="$r"
        done
        (( sel == frame_row_line[0] )) && b_start=0
        (( b_start < frame_top )) && frame_top="$b_start"
        (( b_end >= frame_top + body )) && frame_top=$(( b_end - body + 1 ))
        (( frame_top > b_start )) && frame_top="$b_start"
    fi
    (( frame_top > total - body )) && frame_top=$(( total - body ))
    (( frame_top < 0 )) && frame_top=0
    last=$(( frame_top + body - 1 ))
    (( last >= total )) && last=$(( total - 1 ))

    out="$frame_head"
    for (( i = frame_top; i <= last; i++ )); do
        if (( i == sel )); then
            local l="${frame_rows[$i]}"
            [[ "$view_mode" == list ]] && l="›${l:1}"
            out+="${SEL}${l}${RST}"$'\n'
        else
            out+="${frame_rows[$i]}"$'\n'
        fi
    done
    out+="$frame_tail"
    if (( frame_top > 0 || last < total - 1 )) && [[ -z "$STATUS_NOTE" ]]; then
        local scroll_plain
        if [[ "$view_mode" == list ]]; then
            local above=0 below=0 r
            for r in ${frame_row_line[@]+"${frame_row_line[@]}"}; do
                (( r < frame_top )) && above=$(( above + 1 ))
                (( r > last )) && below=$(( below + 1 ))
            done
            scroll_plain="  ↑ ${above} blocks · ↓ ${below} blocks"
        else
            scroll_plain="  ↑ ${frame_top} lines · ↓ $(( total - 1 - last )) lines"
        fi
        out+="${DIM}$(clip "$scroll_plain" "$term_w")${RST}"$'\n'
    else
        out+="$(clip "$STATUS_NOTE" "$term_w")"$'\n'
    fi
    out+="$frame_foot"
    # A newline written on the terminal's last row scrolls the frame up one
    # line, and the header is what scrolls off; the frame therefore never
    # ends in one.
    screen_out="${out%$'\n'}"
    printf '\033[H\033[2J%s' "$screen_out"
}

render() {
    term_size
    local now
    now=$(date +%s)
    (( term_w != frame_cols || now - frame_at >= 30 )) && build_frame
    paint
}

dump() {
    local i
    build_frame
    printf '%s' "$frame_head"
    for i in "${!frame_rows[@]}"; do printf '%s\n' "${frame_rows[$i]}"; done
    printf '%s' "$frame_tail"
    printf '%s' "$frame_foot"
}

list_move() {
    local dir="$1"
    (( selected += dir ))
    (( selected >= ${#cursor_map[@]} )) && selected=$(( ${#cursor_map[@]} - 1 ))
    (( selected < 0 )) && selected=0
    if (( ${#cursor_map[@]} > 0 )); then
        selected_idx="${cursor_map[$selected]}"
        frame_cursor_line="${frame_row_line[$selected]}"
    fi
}

feed_signature() {
    snapshot_mtime turns 2>/dev/null
    printf ' '
    file_mtime "$FLAG_DIR" 2>/dev/null
}

jump_to_pane() {
    local idx="$1" tty
    [[ "$idx" -ge 0 ]] || { STATUS_NOTE="no pane"; return 0; }
    tty=$(other_client)
    if [[ -z "$tty" ]]; then
        STATUS_NOTE="no other client — this pane is ${p_label[$idx]}"
        return 0
    fi
    "$DOTFILES/bin/tmux-claude-attention" jump-to "$tty" "${p_session[$idx]}" "${p_pane[$idx]}"
    STATUS_NOTE="sent $tty to ${p_label[$idx]}"
}

recollect() {
    STATUS_NOTE=""
    if "$DOTFILES/bin/hq-snapshot" turns >/dev/null 2>&1; then
        STATUS_NOTE="recollected"
    else
        STATUS_NOTE="recollection FAILED — showing the previous snapshot"
    fi
    load_data
}

# Same timeout-vs-key handling as bin/hq-decisions: bash 3.2's `read -rsn1
# -t 2` returns 1 on BOTH a real timeout and a read failure, told apart by
# elapsed time (a non-zero read under 1s is a failure; 3 in a row exits
# instead of spinning).
view() {
    local key rc idx last_sig sig fail_count=0 t0
    tput civis 2>/dev/null
    trap 'tput cnorm 2>/dev/null' EXIT
    trap 'exit 130' INT
    load_data
    build_frame
    paint
    last_sig=$(feed_signature)
    while true; do
        key=""
        t0=$SECONDS
        read -rsn1 -t 2 key
        rc=$?
        if (( rc > 128 )) || (( rc != 0 )) && [[ -t 0 ]]; then
            if (( rc != 0 )) && (( SECONDS - t0 < 1 )); then
                fail_count=$(( fail_count + 1 ))
                if (( fail_count >= 3 )); then
                    echo "hq-feed: reading keys keeps failing — exiting" >&2
                    exit 1
                fi
            else
                fail_count=0
            fi
            sig=$(feed_signature)
            if [[ "$sig" != "$last_sig" ]]; then
                last_sig="$sig"
                load_data
                build_frame
                paint
            else
                render
            fi
            continue
        elif (( rc != 0 )); then
            exit 0
        fi
        fail_count=0
        STATUS_NOTE=""
        idx=-1
        (( ${#cursor_map[@]} > 0 && selected < ${#cursor_map[@]} )) && idx="${cursor_map[$selected]}"
        if [[ "$view_mode" == list ]]; then
            case "$key" in
                j) list_move 1; render ;;
                k) list_move -1; render ;;
                "")
                    if (( idx >= 0 )); then
                        detail_idx="$idx"
                        view_mode=detail
                        frame_top=0
                        build_frame
                    fi
                    paint ;;
                a)
                    if [[ "$show_idle" == true ]]; then show_idle=false; else show_idle=true; fi
                    build_frame
                    paint ;;
                g) (( idx >= 0 )) && jump_to_pane "$idx"; paint ;;
                r) recollect; build_frame; paint ;;
            esac
        else
            case "$key" in
                q|$'\e'|$'\x7f'|$'\b')
                    view_mode=list
                    frame_top=0
                    build_frame
                    paint ;;
                j) frame_top=$(( frame_top + 1 )); paint ;;
                k) frame_top=$(( frame_top - 1 )); paint ;;
                g) jump_to_pane "$detail_idx"; paint ;;
            esac
        fi
    done
}

# Hands back wrap_text and the other pure functions; sourcing runs no loop
# and reads no directory.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0 2>/dev/null || true
fi

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --dump)
        shift
        show_idle=false
        if [[ "${1:-}" == --detail ]]; then
            shift
            pane_arg="${1:-}"
            load_data
            detail_idx=-1
            for i in "${!p_pane[@]}"; do
                [[ "${p_pane[$i]}" == "$pane_arg" || "${p_pane[$i]}" == "%${pane_arg#%}" ]] && { detail_idx="$i"; break; }
            done
            if (( detail_idx < 0 )); then
                echo "hq-feed: no such pane '$pane_arg'" >&2
                exit 1
            fi
            view_mode=detail
            dump
            exit 0
        fi
        [[ -z "${1:-}" ]] || { echo "hq-feed: unknown argument: $1" >&2; usage >&2; exit 2; }
        load_data
        view_mode=list
        dump
        exit 0
        ;;
    --view)
        view
        ;;
    "")
        if [[ -n "${TMUX:-}" ]]; then
            tmux has-session -t '=hq-feed' 2>/dev/null \
                || tmux new-session -d -s hq-feed "$SELF --view"
            tmux switch-client -t '=hq-feed'
        else
            exec tmux new-session -A -s hq-feed "$SELF --view"
        fi
        ;;
    *)
        echo "hq-feed: unknown argument: $1" >&2
        usage >&2
        exit 2
        ;;
esac
