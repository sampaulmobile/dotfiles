#!/usr/bin/env bash
# worktree-doctor — read-only report on every worktree of every project the
# sessionizer knows about (bin/project-dirs-lib's search_dirs), classified
# into a state bucket with the exact command that would act on it. It is a
# separate script from bin/doctor (different question, different cadence),
# not a section of it.
#
#   bin/worktree-doctor             exit 0 clean, 1 while something is
#                                    removable (MERGED/ABANDONED/PRUNABLE)
#   bin/worktree-doctor --offline   skip gh (every PR -> pr:unknown)
#   bin/worktree-doctor --all       also print repos with no extra worktrees
#                                    ("clean"), to prove coverage
#
# It changes NOTHING: every git/gh call below is a read, and `wt` is only
# ever printed as the recommended fix, never executed. Sweeping/deletion is
# a separate, later operation — this is report-only.
#
# Buckets (first match wins):
#   LIVE       a live process has its cwd inside      — keep, in use
#   DIRTY      uncommitted/untracked files             — keep, inspect
#   PRUNABLE   admin entry, directory gone              — git worktree prune
#   MERGED     PR merged, or the branch is an ancestor
#              of the default branch                   — wt remove (also
#                                                          deletes the branch)
#   ABANDONED  PR closed, unmerged                      — wt remove -D
#                                                          (confirm first)
#   IN-REVIEW  PR open                                  — keep, /address-review
#                                                          may still need it
#   PARKED     no PR (or unknown) and unpushed          — keep, surface: ship
#                                                          it or remove it
#   SHIPPED?   no PR (or unknown), pushed, not merged    — keep, remote has it;
#                                                          likely needs a PR or
#                                                          a merge this can't
#                                                          see offline
#
# Liveness comes from `lsof -d cwd -Fpn` (a live process's cwd), never from
# git's worktree lock file (whose reason names the *hub session's* pid,
# which typically outlives the agent) or mtimes; lsof missing -> liveness is
# unknown for every row, treated as "not live" (the footer says so). PR
# state comes from `gh`, never `git branch --merged` (a squash merge looks
# unmerged to plain git); gh missing/unauthenticated/offline -> pr:unknown
# per row, never fatal.
set -uo pipefail

DOTFILES="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"

usage() {
    cat <<'EOF'
usage: worktree-doctor [--offline] [--all]

  --offline   skip gh entirely (every worktree's PR state -> pr:unknown)
  --all       also print repos with no extra worktrees (one "clean" line)

Read-only. Exit 0 when nothing is removable, 1 when at least one worktree
is MERGED, ABANDONED or PRUNABLE.
EOF
}

# classify_worktree <live> <dirty> <prunable> <pr_state> <unpushed> <merged_local>
#   live/dirty/prunable/unpushed/merged_local: "true" or "false".
#   pr_state: one of MERGED, CLOSED, OPEN, none, unknown.
#   Prints the bucket name. First match wins, in the precedence documented
#   above the flags in the header comment.
classify_worktree() {
    local live="$1" dirty="$2" prunable="$3" pr_state="$4" unpushed="$5" merged_local="$6"

    if [[ "$live" == true ]]; then
        echo "LIVE"
        return
    fi
    if [[ "$dirty" == true ]]; then
        echo "DIRTY"
        return
    fi
    if [[ "$prunable" == true ]]; then
        echo "PRUNABLE"
        return
    fi
    if [[ "$pr_state" == MERGED || "$merged_local" == true ]]; then
        echo "MERGED"
        return
    fi
    if [[ "$pr_state" == CLOSED ]]; then
        echo "ABANDONED"
        return
    fi
    if [[ "$pr_state" == OPEN ]]; then
        echo "IN-REVIEW"
        return
    fi
    if [[ "$unpushed" == true ]]; then
        echo "PARKED"
        return
    fi
    echo "SHIPPED?"
}

# Sourced (tests/test-worktree-doctor.sh) rather than executed: hand back
# usage/classify_worktree above and run none of the report below. Executed
# normally, BASH_SOURCE[0] is $0 and this is a no-op.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

# ---- args ----
OFFLINE=false
SHOW_ALL=false
for arg in "$@"; do
    case "$arg" in
        --offline) OFFLINE=true ;;
        --all) SHOW_ALL=true ;;
        -h|--help) usage; exit 0 ;;
        *)
            echo "worktree-doctor: unknown argument: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

GH_OK=false
if [[ "$OFFLINE" == false ]] && command -v gh >/dev/null 2>&1; then
    GH_OK=true
fi

# ---- liveness: one lsof, up front ----
LSOF_RAN=false
live_paths=$'\n'
if command -v lsof >/dev/null 2>&1; then
    LSOF_RAN=true
    while IFS= read -r _line; do
        case "$_line" in
            n*) live_paths+="${_line#n}"$'\n' ;;
        esac
    done < <(lsof -d cwd -Fpn 2>/dev/null)
fi

# is_live <path> — true if some live cwd equals or is under <path>.
is_live() {
    local target="$1" p
    while IFS= read -r p; do
        [[ -z "$p" ]] && continue
        [[ "$p" == "$target" || "$p" == "$target"/* ]] && return 0
    done <<< "$live_paths"
    return 1
}

# default_ref_for <repo> — the default-branch commit-ish to compare worktree
# HEADs against: origin/HEAD's symbolic ref, falling back to a local
# main/master. Empty when a repo has neither (merged_local then reports
# false for every worktree in it).
default_ref_for() {
    local repo="$1" ref
    ref=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
    if [[ -n "$ref" ]]; then
        printf '%s' "$ref"
        return
    fi
    if git -C "$repo" show-ref --verify --quiet refs/heads/main 2>/dev/null; then
        printf 'main'
        return
    fi
    if git -C "$repo" show-ref --verify --quiet refs/heads/master 2>/dev/null; then
        printf 'master'
        return
    fi
    printf ''
}

# ---- one source of truth for "which directories are projects" ----
# shellcheck source=/dev/null
source "$DOTFILES/bin/project-dirs-lib"
project_dirs

repos=()
repos_seen=$'\n'
# Guarded on element count, not just "declared": bash 3.2 treats
# "${arr[@]}" on a zero-element array as unbound under `set -u`.
if (( ${#project_dirs_out[@]} )); then
    for _cand in "${project_dirs_out[@]}"; do
        [[ -d "$_cand/.git" ]] || continue
        [[ "$repos_seen" == *$'\n'"$_cand"$'\n'* ]] && continue
        repos_seen+="$_cand"$'\n'
        repos+=("$_cand")
    done
fi

CNT_LIVE=0 CNT_DIRTY=0 CNT_PRUNABLE=0 CNT_MERGED=0 CNT_ABANDONED=0
CNT_INREVIEW=0 CNT_PARKED=0 CNT_SHIPPED=0

count_bucket() {
    case "$1" in
        LIVE)      CNT_LIVE=$((CNT_LIVE + 1)) ;;
        DIRTY)     CNT_DIRTY=$((CNT_DIRTY + 1)) ;;
        PRUNABLE)  CNT_PRUNABLE=$((CNT_PRUNABLE + 1)) ;;
        MERGED)    CNT_MERGED=$((CNT_MERGED + 1)) ;;
        ABANDONED) CNT_ABANDONED=$((CNT_ABANDONED + 1)) ;;
        IN-REVIEW) CNT_INREVIEW=$((CNT_INREVIEW + 1)) ;;
        PARKED)    CNT_PARKED=$((CNT_PARKED + 1)) ;;
        SHIPPED?)  CNT_SHIPPED=$((CNT_SHIPPED + 1)) ;;
    esac
}

# action_for <bucket> <repo> <path> <branch> — the recommended command,
# printed verbatim, never executed. A detached worktree (empty branch) must
# be addressed by PATH, not branch, for `wt remove` (verified against wt
# v0.68.0's --help).
action_for() {
    local bucket="$1" repo="$2" path="$3" branch="$4" target
    target="${branch:-$path}"
    case "$bucket" in
        LIVE)      echo "keep — in use" ;;
        DIRTY)     echo "keep — inspect: git -C $path status" ;;
        PRUNABLE)  echo "git -C $repo worktree prune" ;;
        MERGED)    echo "wt -C $repo remove $target  (deletes the merged branch too)" ;;
        ABANDONED) echo "wt -C $repo remove -D $target  (confirm first — deletes an unmerged branch)" ;;
        IN-REVIEW) echo "keep — /address-review may need it" ;;
        PARKED)    echo "keep, surface — ship it or remove it deliberately" ;;
        *)         echo "keep — remote has it; likely needs a PR or a merge you can't see offline" ;;
    esac
}

shorten() {
    local p="$1"
    [[ "$p" == "$HOME/"* ]] && p="~/${p#"$HOME"/}"
    printf '%s' "$p"
}

# Guarded on element count, not just "declared" — see the note above the
# same guard around project_dirs_out.
if (( ${#repos[@]} )); then
for repo in "${repos[@]}"; do
    default_ref=$(default_ref_for "$repo")
    repo_out=""

    # git worktree list --porcelain: blocks of "worktree <path>" / "HEAD
    # <sha>" / "branch refs/heads/<name>" (or "detached") / optional
    # "locked <reason>" / optional "prunable <reason>", separated by blank
    # lines. Read via process substitution (not a pipe into the loop) so
    # the counters above survive past the loop — bash runs `cmd | while`
    # in a subshell, `< <(cmd)` does not.
    path="" branch="" locked=false prunable=false wt_head=""
    have_block=false

    flush_block() {
        [[ "$have_block" == true ]] || return 0
        [[ "$path" == "$repo" ]] && { have_block=false; return 0; }  # main worktree

        local live dirty unpushed merged_local pr_state pr_disp age

        if [[ "$prunable" == true ]]; then
            live=false; dirty=false; unpushed=false; merged_local=false
            pr_state="unknown"; pr_disp="pr:unknown"; age="-"
        else
            if is_live "$path"; then live=true; else live=false; fi

            if [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]]; then
                dirty=true
            else
                dirty=false
            fi

            if [[ -n "$branch" ]]; then
                if git -C "$repo" rev-parse --verify -q "refs/remotes/origin/$branch" >/dev/null 2>&1; then
                    local ahead
                    ahead=$(git -C "$repo" rev-list --count "origin/$branch..$wt_head" 2>/dev/null)
                    [[ -z "$ahead" ]] && ahead=0
                    if (( ahead > 0 )); then unpushed=true; else unpushed=false; fi
                else
                    unpushed=true
                fi
                if [[ -n "$default_ref" ]] && git -C "$repo" merge-base --is-ancestor "$wt_head" "$default_ref" 2>/dev/null; then
                    merged_local=true
                else
                    merged_local=false
                fi
            else
                # Detached HEAD: no branch to push or diff against a
                # default. Deliberately treated as "surface it" (PARKED)
                # rather than silently reading as SHIPPED? — see NOTES.md.
                unpushed=true
                merged_local=false
            fi

            pr_state="unknown"
            pr_disp="pr:unknown"
            if [[ -n "$branch" ]] && [[ "$GH_OK" == true ]]; then
                local pr_line gh_rc pr_num pr_url
                pr_line=$(cd "$repo" 2>/dev/null && gh pr list --head "$branch" --state all \
                    --json number,state,url \
                    --jq '(.[0] // empty) | [(.number|tostring), .state, .url] | @tsv' 2>/dev/null)
                gh_rc=$?
                if [[ $gh_rc -eq 0 ]]; then
                    if [[ -z "$pr_line" ]]; then
                        pr_state="none"
                        pr_disp="no PR"
                    else
                        IFS=$'\t' read -r pr_num pr_state pr_url <<< "$pr_line"
                        pr_disp="PR #${pr_num} ${pr_state}"
                    fi
                fi
            fi

            age=$(git -C "$path" log -1 --format=%cr 2>/dev/null)
            [[ -z "$age" ]] && age="-"
        fi

        local bucket flags
        bucket=$(classify_worktree "$live" "$dirty" "$prunable" "$pr_state" "$unpushed" "$merged_local")
        count_bucket "$bucket"

        flags=""
        [[ "$locked" == true ]] && flags+="locked "
        [[ "$dirty" == true ]] && flags+="dirty "
        [[ "$unpushed" == true ]] && flags+="unpushed "
        flags="${flags% }"
        [[ -z "$flags" ]] && flags="-"

        repo_out+=$(printf '  %-9s %-28s %-16s %-20s %-14s %s\n' \
            "$bucket" "${branch:-(detached)}" "$pr_disp" "$flags" "$age" "$(shorten "$path")")
        repo_out+=$'\n'
        repo_out+=$(printf '      %s\n' "$(action_for "$bucket" "$repo" "$path" "$branch")")
        repo_out+=$'\n'

        have_block=false
    }

    while IFS= read -r line; do
        case "$line" in
            "worktree "*)
                flush_block
                path="${line#worktree }"
                branch="" locked=false prunable=false wt_head=""
                have_block=true
                ;;
            "HEAD "*)     wt_head="${line#HEAD }" ;;
            "branch "*)   branch="${line#branch refs/heads/}" ;;
            detached)     branch="" ;;
            locked*)      locked=true ;;
            prunable*)    prunable=true ;;
            *) : ;;
        esac
    done < <(git -C "$repo" worktree list --porcelain 2>/dev/null)
    flush_block

    if [[ -n "$repo_out" ]]; then
        printf '\n== %s\n' "$(shorten "$repo")"
        printf '%s' "$repo_out"
    elif [[ "$SHOW_ALL" == true ]]; then
        printf '\n== %s\n' "$(shorten "$repo")"
        echo "  clean"
    fi
done
fi

echo
echo "-- summary --"
printf 'LIVE:%d  DIRTY:%d  PRUNABLE:%d  MERGED:%d  ABANDONED:%d  IN-REVIEW:%d  PARKED:%d  SHIPPED?:%d\n' \
    "$CNT_LIVE" "$CNT_DIRTY" "$CNT_PRUNABLE" "$CNT_MERGED" "$CNT_ABANDONED" \
    "$CNT_INREVIEW" "$CNT_PARKED" "$CNT_SHIPPED"
if [[ "$GH_OK" == true ]]; then
    echo "gh consulted: yes (some per-row lookups may still show pr:unknown on failure)"
elif [[ "$OFFLINE" == true ]]; then
    echo "gh consulted: no (--offline)"
else
    echo "gh consulted: no (gh not found — every row shows pr:unknown)"
fi
if [[ "$LSOF_RAN" == true ]]; then
    echo "lsof consulted: yes"
else
    echo "lsof consulted: no (lsof not found — liveness unknown, treated as not-live)"
fi

if (( CNT_MERGED > 0 || CNT_ABANDONED > 0 || CNT_PRUNABLE > 0 )); then
    echo
    echo "worktree-doctor: removable worktrees found (see MERGED/ABANDONED/PRUNABLE above)"
    exit 1
fi
echo
echo "worktree-doctor: nothing removable"
