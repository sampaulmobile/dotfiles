#!/usr/bin/env bash
# worktree-doctor — read-only report on every worktree of every project
# bin/project-dirs-lib knows about, bucketed with the exact command that
# would act on it. The buckets and the invocation are in the repo's CLAUDE.md
# and in usage() below; the bucket precedence is classify_worktree's order.
#
# It changes NOTHING: every git/gh call here is a read, and `wt` is only ever
# printed as the recommended fix, never executed. Acting on the report is
# bin/worktree-sweep's job (it sources the derivation + classification here);
# keep this one report-only.
#
# Liveness comes from `lsof -d cwd -Fpn` (a live process's cwd), never from
# git's worktree lock file (whose reason names the *hub session's* pid, which
# typically outlives the agent) and never from mtimes; without lsof every row
# is treated as not-live and the footer says so. PR state comes from `gh`,
# never `git branch --merged` — a squash merge looks unmerged to plain git;
# gh missing/unauthenticated/offline degrades a row to pr:unknown, never
# fatal.
set -uo pipefail

DOTFILES="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"

usage() {
    cat <<'EOF'
usage: worktree-doctor [--offline] [--all]

  --offline   skip gh entirely (every worktree's PR state -> pr:unknown)
  --all       also print repos with no extra worktrees (one "clean" line)

Read-only. Exit 0 when nothing is removable, 1 when at least one worktree
is MERGED, ABANDONED or PRUNABLE.
EOF
}

# classify_worktree <live> <dirty> <prunable> <pr_state> <unpushed> <merged_local>
#   live/dirty/prunable/unpushed/merged_local: "true" or "false".
#   pr_state: one of MERGED, CLOSED, OPEN, none, unknown.
#   Prints the bucket name. First match wins — the order below IS the
#   precedence, and tests/test-worktree-doctor.sh pins it.
classify_worktree() {
    local live="$1" dirty="$2" prunable="$3" pr_state="$4" unpushed="$5" merged_local="$6"

    if [[ "$live" == true ]]; then
        echo "LIVE"
        return
    fi
    if [[ "$dirty" == true ]]; then
        echo "DIRTY"
        return
    fi
    if [[ "$prunable" == true ]]; then
        echo "PRUNABLE"
        return
    fi
    if [[ "$pr_state" == MERGED || "$merged_local" == true ]]; then
        echo "MERGED"
        return
    fi
    if [[ "$pr_state" == CLOSED ]]; then
        echo "ABANDONED"
        return
    fi
    if [[ "$pr_state" == OPEN ]]; then
        echo "IN-REVIEW"
        return
    fi
    if [[ "$unpushed" == true ]]; then
        echo "PARKED"
        return
    fi
    echo "SHIPPED?"
}

# action_for <bucket> <repo> <path> <branch> <locked> — the recommended
# command, printed verbatim, never executed. A detached worktree (empty
# branch) must be addressed by PATH, not branch, for `wt remove` (verified
# against wt v0.68.0's --help). `locked` never changes the bucket, only
# whether MERGED/ABANDONED get the `git worktree unlock` prefix they need:
# every harness-made agent worktree stays locked after its agent exits, and
# `wt remove` (like `git worktree remove`) refuses a locked worktree.
action_for() {
    local bucket="$1" repo="$2" path="$3" branch="$4" locked="${5:-false}"
    local target unlock_prefix
    target="${branch:-$path}"
    unlock_prefix=""
    if [[ "$locked" == true ]] && [[ "$bucket" == MERGED || "$bucket" == ABANDONED ]]; then
        unlock_prefix="git -C $repo worktree unlock $path && "
    fi
    case "$bucket" in
        LIVE)      echo "keep — in use" ;;
        DIRTY)     echo "keep — inspect: git -C $path status" ;;
        PRUNABLE)  echo "git -C $repo worktree prune" ;;
        MERGED)    echo "${unlock_prefix}wt -C $repo remove $target  (deletes the merged branch too)" ;;
        ABANDONED) echo "${unlock_prefix}wt -C $repo remove -D $target  (confirm first — deletes an unmerged branch)" ;;
        IN-REVIEW) echo "keep — /address-review may need it" ;;
        PARKED)    echo "keep, surface — ship it or remove it deliberately" ;;
        *)         echo "keep — remote has it; likely needs a PR or a merge you can't see offline" ;;
    esac
}

# parse_porcelain_blocks <repo>
#   Reads `git worktree list --porcelain` from stdin and calls
#   on_worktree_block <path> <branch> <locked> <prunable> <wt_head> once per
#   block, skipping <repo> itself (the main worktree, always listed first by
#   git) and flushing a trailing block that has no blank line after it.
#   on_worktree_block belongs to the CALLER, not this file: the report below
#   defines the real one, tests/test-worktree-doctor.sh a recording stub —
#   which is what lets the parser be exercised with no git and no gh.
parse_porcelain_blocks() {
    local repo="$1"
    local path="" branch="" locked=false prunable=false wt_head=""
    local have_block=false

    _pb_flush() {
        [[ "$have_block" == true ]] || return 0
        have_block=false
        [[ "$path" == "$repo" ]] && return 0
        on_worktree_block "$path" "$branch" "$locked" "$prunable" "$wt_head"
    }

    while IFS= read -r line; do
        case "$line" in
            "worktree "*)
                _pb_flush
                path="${line#worktree }"
                branch="" locked=false prunable=false wt_head=""
                have_block=true
                ;;
            "HEAD "*)     wt_head="${line#HEAD }" ;;
            "branch "*)   branch="${line#branch refs/heads/}" ;;
            detached)     branch="" ;;
            locked*)      locked=true ;;
            prunable*)    prunable=true ;;
            *) : ;;
        esac
    done
    _pb_flush
}

# ---- liveness + fact derivation (shared with bin/worktree-sweep) ----
# These live ABOVE the source guard so the sweeper, which must classify a
# worktree exactly as this report does before it deletes anything, sources
# the identical machinery instead of keeping a second copy that could drift.
# They read/write globals the caller owns: init_liveness fills live_paths;
# derive_worktree_facts reads $repo, $default_ref and $GH_OK and writes the
# f_* result globals below.

# init_liveness — fill live_paths (one cwd per line) from a single lsof and
# set LSOF_RAN. Without lsof, live_paths stays empty and is_live is always
# false (every worktree treated as not-live; the caller's footer says so).
LSOF_RAN=false
live_paths=$'\n'
init_liveness() {
    if command -v lsof >/dev/null 2>&1; then
        LSOF_RAN=true
        while IFS= read -r _line; do
            case "$_line" in
                n*) live_paths+="${_line#n}"$'\n' ;;
            esac
        done < <(lsof -d cwd -Fpn 2>/dev/null)
    fi
}

# is_live <path> — true if some live cwd equals or is under <path>.
is_live() {
    local target="$1" p
    while IFS= read -r p; do
        [[ -z "$p" ]] && continue
        [[ "$p" == "$target" || "$p" == "$target"/* ]] && return 0
    done <<< "$live_paths"
    return 1
}

# default_ref_for <repo> — the default-branch commit-ish to compare worktree
# HEADs against: origin/HEAD's symbolic ref, falling back to a local
# main/master. Empty when a repo has neither (merged_local then reports
# false for every worktree in it).
default_ref_for() {
    local repo="$1" ref
    ref=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
    if [[ -n "$ref" ]]; then
        printf '%s' "$ref"
        return
    fi
    if git -C "$repo" show-ref --verify --quiet refs/heads/main 2>/dev/null; then
        printf 'main'
        return
    fi
    if git -C "$repo" show-ref --verify --quiet refs/heads/master 2>/dev/null; then
        printf 'master'
        return
    fi
    printf ''
}

# derive_worktree_facts <path> <branch> <prunable> <wt_head>
#   Compute the per-worktree facts classify_worktree needs, into the globals
#   f_live f_dirty f_unpushed f_merged_local f_pr_state f_pr_disp f_age.
#   Reads $repo, $default_ref and $GH_OK from the caller. A prunable block
#   short-circuits to the "nothing to inspect" defaults (its gitdir is gone).
derive_worktree_facts() {
    local path="$1" branch="$2" prunable="$3" wt_head="$4"

    if [[ "$prunable" == true ]]; then
        f_live=false; f_dirty=false; f_unpushed=false; f_merged_local=false
        f_pr_state="unknown"; f_pr_disp="pr:unknown"; f_age="-"
        return
    fi

    if is_live "$path"; then f_live=true; else f_live=false; fi

    # --no-optional-locks: not even the stat-cache refresh git does
    # opportunistically on a plain `status --porcelain` is allowed here.
    if [[ -n "$(git --no-optional-locks -C "$path" status --porcelain 2>/dev/null)" ]]; then
        f_dirty=true
    else
        f_dirty=false
    fi

    if [[ -n "$branch" ]]; then
        if git -C "$repo" rev-parse --verify -q "refs/remotes/origin/$branch" >/dev/null 2>&1; then
            local ahead
            ahead=$(git -C "$repo" rev-list --count "origin/$branch..$wt_head" 2>/dev/null)
            [[ -z "$ahead" ]] && ahead=0
            if (( ahead > 0 )); then f_unpushed=true; else f_unpushed=false; fi
        else
            f_unpushed=true
        fi
        # B6: --is-ancestor is trivially true when wt_head == default_ref's
        # own commit (a branch that never diverged — a fresh `wt switch -c`,
        # or one parked before its first commit), wrongly bucketing a
        # zero-commit branch as MERGED. Requiring wt_head to differ from
        # default's CURRENT commit closes that hole; it does not (and, from
        # the ref graph alone, cannot) additionally prove the branch ever had
        # unique commits of its own — verified empirically: once a real
        # local merge/rebase folds a branch's commits into default, HEAD is
        # exactly as much "an ancestor with nothing default lacks" as a
        # branch that never diverged at all (git 2.x, both `--ff-only` and
        # `--no-ff` merges reproduce this).
        local default_sha
        default_sha=$(git -C "$repo" rev-parse --verify -q "$default_ref" 2>/dev/null)
        if [[ -n "$default_ref" ]] && [[ -n "$default_sha" ]] && [[ "$wt_head" != "$default_sha" ]] \
            && git -C "$repo" merge-base --is-ancestor "$wt_head" "$default_ref" 2>/dev/null; then
            f_merged_local=true
        else
            f_merged_local=false
        fi
    else
        # Detached HEAD has no branch to push or diff against a default.
        # Deliberately reported as PARKED ("surface it") rather than
        # SHIPPED?, which would read as "the remote has this" — it may
        # not, and there is no branch to check.
        f_unpushed=true
        f_merged_local=false
    fi

    f_pr_state="unknown"
    f_pr_disp="pr:unknown"
    if [[ -n "$branch" ]] && [[ "$GH_OK" == true ]]; then
        local pr_line gh_rc pr_num pr_url
        pr_line=$(cd "$repo" 2>/dev/null && gh pr list --head "$branch" --state all \
            --json number,state,url \
            --jq '(.[0] // empty) | [(.number|tostring), .state, .url] | @tsv' 2>/dev/null)
        gh_rc=$?
        if [[ $gh_rc -eq 0 ]]; then
            if [[ -z "$pr_line" ]]; then
                f_pr_state="none"
                f_pr_disp="no PR"
            else
                IFS=$'\t' read -r pr_num f_pr_state pr_url <<< "$pr_line"
                f_pr_disp="PR #${pr_num} ${f_pr_state}"
            fi
        fi
    fi

    f_age=$(git -C "$path" log -1 --format=%cr 2>/dev/null)
    [[ -z "$f_age" ]] && f_age="-"
}

# Sourced (tests/test-worktree-doctor.sh, bin/worktree-sweep) rather than
# executed: hand back the pure + shared functions above and run none of the
# report below.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

# ---- args ----
OFFLINE=false
SHOW_ALL=false
for arg in "$@"; do
    case "$arg" in
        --offline) OFFLINE=true ;;
        --all) SHOW_ALL=true ;;
        -h|--help) usage; exit 0 ;;
        *)
            echo "worktree-doctor: unknown argument: $arg" >&2
            usage >&2
            exit 2
            ;;
    esac
done

GH_OK=false
if [[ "$OFFLINE" == false ]] && command -v gh >/dev/null 2>&1; then
    GH_OK=true
fi

# ---- liveness: one lsof, up front ----
init_liveness

# shellcheck source=/dev/null
source "$DOTFILES/bin/project-dirs-lib"
project_dirs

repos=()
repos_seen=$'\n'
# Guarded on element count, not just "declared": bash 3.2 treats
# "${arr[@]}" on a zero-element array as unbound under `set -u`.
if (( ${#project_dirs_out[@]} )); then
    for _cand in "${project_dirs_out[@]}"; do
        [[ -d "$_cand/.git" ]] || continue
        [[ "$repos_seen" == *$'\n'"$_cand"$'\n'* ]] && continue
        repos_seen+="$_cand"$'\n'
        repos+=("$_cand")
    done
fi

CNT_LIVE=0 CNT_DIRTY=0 CNT_PRUNABLE=0 CNT_MERGED=0 CNT_ABANDONED=0
CNT_INREVIEW=0 CNT_PARKED=0 CNT_SHIPPED=0

count_bucket() {
    case "$1" in
        LIVE)      CNT_LIVE=$((CNT_LIVE + 1)) ;;
        DIRTY)     CNT_DIRTY=$((CNT_DIRTY + 1)) ;;
        PRUNABLE)  CNT_PRUNABLE=$((CNT_PRUNABLE + 1)) ;;
        MERGED)    CNT_MERGED=$((CNT_MERGED + 1)) ;;
        ABANDONED) CNT_ABANDONED=$((CNT_ABANDONED + 1)) ;;
        IN-REVIEW) CNT_INREVIEW=$((CNT_INREVIEW + 1)) ;;
        PARKED)    CNT_PARKED=$((CNT_PARKED + 1)) ;;
        SHIPPED?)  CNT_SHIPPED=$((CNT_SHIPPED + 1)) ;;
    esac
}

shorten() {
    local p="$1"
    [[ "$p" == "$HOME/"* ]] && p="~/${p#"$HOME"/}"
    printf '%s' "$p"
}

# on_worktree_block <path> <branch> <locked> <prunable> <wt_head>
#   The real per-row derivation and printing for parse_porcelain_blocks.
#   Derivation is derive_worktree_facts (shared with the sweeper); this just
#   classifies and formats. Depends on globals the per-repo loop below sets:
#   $repo, $default_ref and $repo_out (the current repo's accumulated text).
on_worktree_block() {
    local path="$1" branch="$2" locked="$3" prunable="$4" wt_head="$5"

    derive_worktree_facts "$path" "$branch" "$prunable" "$wt_head"

    local bucket flags
    bucket=$(classify_worktree "$f_live" "$f_dirty" "$prunable" "$f_pr_state" "$f_unpushed" "$f_merged_local")
    count_bucket "$bucket"

    flags=""
    [[ "$locked" == true ]] && flags+="locked "
    [[ "$f_dirty" == true ]] && flags+="dirty "
    [[ "$f_unpushed" == true ]] && flags+="unpushed "
    flags="${flags% }"
    [[ -z "$flags" ]] && flags="-"

    repo_out+=$(printf '  %-9s %-28s %-16s %-20s %-14s %s\n' \
        "$bucket" "${branch:-(detached)}" "$f_pr_disp" "$flags" "$f_age" "$(shorten "$path")")
    repo_out+=$'\n'
    repo_out+=$(printf '      %s\n' "$(action_for "$bucket" "$repo" "$path" "$branch" "$locked")")
    repo_out+=$'\n'
}

# Guarded on element count, not just "declared" — see the note above the
# same guard around project_dirs_out.
if (( ${#repos[@]} )); then
for repo in "${repos[@]}"; do
    default_ref=$(default_ref_for "$repo")
    repo_out=""

    # Read via process substitution (not a pipe into a while loop) so the
    # counters above survive past this call — bash runs `cmd | while` in a
    # subshell, `< <(cmd)` does not.
    parse_porcelain_blocks "$repo" < <(git -C "$repo" worktree list --porcelain 2>/dev/null)

    if [[ -n "$repo_out" ]]; then
        printf '\n== %s\n' "$(shorten "$repo")"
        printf '%s' "$repo_out"
    elif [[ "$SHOW_ALL" == true ]]; then
        printf '\n== %s\n' "$(shorten "$repo")"
        echo "  clean"
    fi
done
fi

echo
echo "-- summary --"
printf 'LIVE:%d  DIRTY:%d  PRUNABLE:%d  MERGED:%d  ABANDONED:%d  IN-REVIEW:%d  PARKED:%d  SHIPPED?:%d\n' \
    "$CNT_LIVE" "$CNT_DIRTY" "$CNT_PRUNABLE" "$CNT_MERGED" "$CNT_ABANDONED" \
    "$CNT_INREVIEW" "$CNT_PARKED" "$CNT_SHIPPED"
if [[ "$GH_OK" == true ]]; then
    echo "gh consulted: yes (some per-row lookups may still show pr:unknown on failure)"
elif [[ "$OFFLINE" == true ]]; then
    echo "gh consulted: no (--offline)"
else
    echo "gh consulted: no (gh not found — every row shows pr:unknown)"
fi
if [[ "$LSOF_RAN" == true ]]; then
    echo "lsof consulted: yes"
else
    echo "lsof consulted: no (lsof not found — liveness unknown, treated as not-live)"
fi

if (( CNT_MERGED > 0 || CNT_ABANDONED > 0 || CNT_PRUNABLE > 0 )); then
    echo
    echo "worktree-doctor: removable worktrees found (see MERGED/ABANDONED/PRUNABLE above)"
    exit 1
fi
echo
echo "worktree-doctor: nothing removable"
