#!/usr/bin/env bash

# Switch between the two claude-in-tmux layouts, migrating LIVE sessions
# (conversations keep running — windows are moved, never killed):
#
#   tmux-claude-migrate window   claude-X popup sessions -> a "claude" window
#                                inside each project session X; sets mode file
#   tmux-claude-migrate popup    "claude" windows -> claude-X popup sessions;
#                                sets mode file
#
# The mode file (~/dotfiles/other/tmux-claude-mode) is read by the C-Space
# dispatcher in dots/tmux.conf. All other popup logic (sessionizer branch,
# attention-layer popup handling, statusbar filter) keys off claude-*
# sessions existing, so it self-disables in window mode with no code changes.
#
# Run this YOURSELF from a shell — it reshapes live tmux sessions.

set -euo pipefail

MODE_FILE="$HOME/dotfiles/other/tmux-claude-mode"
FLAG_DIR="$HOME/.cache/claude-attention"

mode="${1:-}"

case "$mode" in
window)
    moved=0
    while IFS= read -r psess; do
        proj="${psess#claude-}"
        if ! tmux has-session -t "=$proj" 2>/dev/null; then
            echo "skip: $psess (no project session '$proj' to move into)" >&2
            continue
        fi
        if tmux list-windows -t "${proj}:" -F '#{window_name}' | grep -qx claude; then
            echo "skip: $proj already has a claude window" >&2
            continue
        fi
        wid=$(tmux list-windows -t "${psess}:" -F '#{window_id}' | head -1)
        # moving the popup session's only window dissolves that session and
        # drops any popup client viewing it — which is the point
        tmux move-window -s "$wid" -t "${proj}:99" 2>/dev/null \
            || tmux move-window -s "$wid" -t "${proj}:" 2>/dev/null
        tmux rename-window -t "$wid" claude
        tmux set-option -w -t "$wid" automatic-rename off
        rm -f "${FLAG_DIR}/${psess}.done"
        tmux set -t "${proj}:" @claude_popup "" 2>/dev/null || true
        (( moved++ )) || true
        echo "moved: $psess -> $proj window 'claude'"
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^claude-')
    echo "window" > "$MODE_FILE"
    echo "mode=window (moved $moved). Reload tmux config (prefix+r) if C-Space was rebound this session."
    ;;
popup)
    moved=0
    while IFS= read -r proj; do
        [[ "$proj" == claude-* ]] && continue
        wid=$(tmux list-windows -t "${proj}:" -F '#{window_name} #{window_id}' 2>/dev/null \
            | awk '$1 == "claude" {print $2; exit}')
        [[ -z "$wid" ]] && continue
        psess="claude-${proj}"
        if tmux has-session -t "=$psess" 2>/dev/null; then
            echo "skip: $psess already exists" >&2
            continue
        fi
        tmux new-session -ds "$psess"
        placeholder=$(tmux list-windows -t "${psess}:" -F '#{window_id}' | head -1)
        tmux move-window -s "$wid" -t "${psess}:99" 2>/dev/null \
            || tmux move-window -s "$wid" -t "${psess}:"
        tmux kill-window -t "$placeholder"
        (( moved++ )) || true
        echo "moved: $proj window 'claude' -> $psess"
    done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)
    echo "popup" > "$MODE_FILE"
    echo "mode=popup (moved $moved)."
    ;;
*)
    echo "usage: $(basename "$0") {window|popup}   (current: $(cat "$MODE_FILE" 2>/dev/null || echo popup))" >&2
    exit 1
    ;;
esac
