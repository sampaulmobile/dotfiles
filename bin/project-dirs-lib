#!/usr/bin/env bash

# Constraints: project_dirs() runs on every ~5s snapshot tick (hq-snapshot's
# collect_pipelines), so this file must stay fork-free (globs, [[ ]], `read`,
# parameter expansion — no $(...), no git, no basename) and free of side
# effects beyond sourcing the .local override. bash 3.2 (macOS /bin/bash): no mapfile, no
# associative arrays, no ${var,,}, no `local -n`.

# Entries are "path:depth" — depth 0 = the directory is itself a project,
# depth 1 = its immediate children are. bash 3.2 quirk: ${arr+x} on an array
# tests element 0, which is exactly the "is this unset" test wanted here.
if [[ -z "${search_dirs+x}" ]]; then
    search_dirs=(
        "$HOME/dev:1"
        "$HOME/research:1"
        "$HOME/dotfiles:0"
    )
fi

# Never a project, even when it sits inside a depth-1 search dir.
if [[ -z "${runners_root+x}" ]]; then
    runners_root="$HOME/dev/gha-runners"
fi

# Machine-local override (untracked): may redefine search_dirs entirely. See
# other/tmux-sessionizer.local.example.
PROJECT_DIRS_LOCAL="${PROJECT_DIRS_LOCAL:-$HOME/dotfiles/other/tmux-sessionizer.local}"
[[ -f "$PROJECT_DIRS_LOCAL" ]] && source "$PROJECT_DIRS_LOCAL"

# worktree_branch_out is the linked worktree's branch (empty when detached or
# <path> isn't a linked worktree); worktree_repo_out is the main repo's path
# (empty unless the gitdir has the ".../.git/worktrees/<name>" shape).
worktree_branch() {
    local path="$1" gitfile line gitdir ref
    worktree_branch_out=""
    worktree_repo_out=""
    gitfile="$path/.git"
    [[ -f "$gitfile" ]] || return 0
    line=""
    IFS= read -r line < "$gitfile" 2>/dev/null || :
    case "$line" in
        "gitdir: "*) gitdir="${line#gitdir: }" ;;
        *) return 0 ;;
    esac
    case "$gitdir" in
        */.git/worktrees/*) worktree_repo_out="${gitdir%%/.git/worktrees/*}" ;;
    esac
    [[ -f "$gitdir/HEAD" ]] || return 0
    ref=""
    IFS= read -r ref < "$gitdir/HEAD" 2>/dev/null || :
    case "$ref" in
        "ref: refs/heads/"*) worktree_branch_out="${ref#ref: refs/heads/}" ;;
        *) worktree_branch_out="" ;;
    esac
}

# Writes `session_name`: "/" -> "-" matches worktrunk's own sanitize; "." ->
# "_" is this repo's own rule. Reads no filesystem and needs no <path>, which
# is what lets bin/wt-tmux-cleanup call it post-remove/post-merge, after the
# worktree directory is already gone.
session_name_for_branch() {
    local repo_name="$1"
    local branch="$2"
    local name="${repo_name}_${branch//\//-}"
    session_name="${name//./_}"
}

# worktrunk always passes a 3rd hook argument to post-remove/post-merge; for
# a DETACHED worktree it renders as the literal string "HEAD" (empirical, wt
# v0.68.0; the docs claim `branch` is undefined there), never empty. "HEAD"
# is an unambiguous sentinel: git refuses it as a real branch name
# (`git check-ref-format --branch HEAD`). The empty/"HEAD" fallback must keep
# matching the name Ctrl+F and wt-tmux-jump give that worktree.
session_name_for_removed() {
    local repo_name="$1"
    local path="$2"
    local branch="$3"
    if [[ -z "$branch" || "$branch" == "HEAD" ]]; then
        session_name_for "$path"
    else
        session_name_for_branch "$repo_name" "$branch"
    fi
}

# A worktrunk sibling (proj.feat-x) keeps its basename: its dir name already
# encodes repo+branch. The branch lookup below reads the filesystem, so it
# only works while the worktree exists — callers running after removal use
# session_name_for_branch instead.
session_name_for() {
    # One variable per `local` on purpose: bash expands every word of a
    # `local a=$x b=$a` command before any of its assignments take effect, so
    # a combined statement would compute parent/base from path's OLD value.
    local path="$1"
    local parent="${path%/*}"
    local base="${path##*/}"
    local name repo repo_base

    case "$path" in
        */.claude/worktrees/*)
            repo="${path%%/.claude/worktrees/*}"
            repo_base="${repo##*/}"
            worktree_branch "$path"
            if [[ -n "$worktree_branch_out" ]]; then
                session_name_for_branch "$repo_base" "$worktree_branch_out"
                return
            fi
            name="${repo_base}_${base}"
            ;;
        *)
            if [[ -d "$parent/.bare" ]]; then
                name="${parent##*/}_${base}"
            else
                name="$base"
            fi
            ;;
    esac
    session_name="${name//./_}"
}

# .git is a directory only for a main worktree; a linked worktree's .git is a
# file, so this is how a main worktree's own agent worktrees get included.
_project_dirs_add_one() {
    local cand="$1" wt
    project_dirs_out+=("$cand")
    if [[ -d "$cand/.git" ]]; then
        for wt in "$cand"/.claude/worktrees/*/; do
            wt="${wt%/}"
            _project_dirs_add_one "$wt"
        done
    fi
}

_project_dirs_add_candidate() {
    local cand="$1" wt
    if [[ -d "$cand/.bare" ]]; then
        for wt in "$cand"/*/; do
            wt="${wt%/}"
            [[ "${wt##*/}" == ".bare" ]] && continue
            _project_dirs_add_one "$wt"
        done
    else
        _project_dirs_add_one "$cand"
    fi
}

# Worktrunk siblings count only when .git is a FILE (a linked worktree), so
# a plain sibling like proj.bak is skipped; depth-1 entries skip this pass
# since their siblings are already depth-1 rows.
#
# Deliberately never builds an intermediate candidates array to iterate with
# "${arr[@]}": bash 3.2 treats that expansion as unbound under `set -u` when
# the array is empty (a depth-1 entry with no subdirectories, and
# search_dirs itself, hence the early return below), and bin/worktrees
# sources this into a `set -uo pipefail` shell. Globbing straight into
# `for x in <pattern>` with nullglob just runs zero times.
project_dirs() {
    project_dirs_out=()
    local entry dir depth cand sib

    (( ${#search_dirs[@]} )) || return 0
    shopt -s nullglob
    for entry in "${search_dirs[@]}"; do
        dir="${entry%%:*}"
        depth="${entry##*:}"

        if [[ "$depth" -eq 0 ]]; then
            _project_dirs_add_candidate "$dir"
        else
            for cand in "$dir"/*/; do
                cand="${cand%/}"
                [[ "$cand" == "$runners_root" ]] && continue
                _project_dirs_add_candidate "$cand"
            done
        fi

        if [[ "$depth" -eq 0 ]]; then
            for sib in "$dir".*/; do
                sib="${sib%/}"
                [[ -f "$sib/.git" ]] || continue
                project_dirs_out+=("$sib")
            done
        fi
    done
    shopt -u nullglob
}
