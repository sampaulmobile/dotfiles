#!/usr/bin/env bash

# The single home for search_dirs, the machine-local override and the
# tmux-session naming rule. Sourced by bin/tmux-sessionizer, bin/worktree-doctor,
# bin/wt-tmux-jump and bin/wt-tmux-cleanup, none of which keep a second copy.
#
# Constraints: project_dirs() runs on the sessionizer's hot path before fzf
# draws, so this file must stay fork-free (globs, [[ ]], `read`, parameter
# expansion — no $(...), no git, no basename) and free of side effects beyond
# sourcing the .local override. bash 3.2 (macOS /bin/bash): no mapfile, no
# associative arrays, no ${var,,}, no `local -n`.

# ---- Project directories ----
# Entries are "path:depth" — depth 0 = the directory is itself a project,
# depth 1 = its immediate children are. Assigned only when unset so a test (or
# the .local override below) can pre-set it. bash 3.2 quirk: ${arr+x} on an
# array tests element 0, which is exactly the "is this unset" test wanted here.
if [[ -z "${search_dirs+x}" ]]; then
    search_dirs=(
        "$HOME/dev:1"
        "$HOME/research:1"
        "$HOME/dotfiles:0"
    )
fi

# Machine-local override (untracked): may redefine search_dirs entirely. See
# other/tmux-sessionizer.local.example. PROJECT_DIRS_LOCAL exists so a test can
# point this at /nonexistent instead of the real machine's file.
PROJECT_DIRS_LOCAL="${PROJECT_DIRS_LOCAL:-$HOME/dotfiles/other/tmux-sessionizer.local}"
[[ -f "$PROJECT_DIRS_LOCAL" ]] && source "$PROJECT_DIRS_LOCAL"
# ------------------------------

# worktree_branch <path>
#   Branch of a linked worktree into the global `worktree_branch_out` (empty
#   when detached, or when <path> is not a linked worktree), and the MAIN
#   repo's path into `worktree_repo_out` (empty unless the gitdir has the
#   ".../.git/worktrees/<name>" shape) — the sessionizer groups a worktrunk
#   sibling under its repo rather than its own dir name. Both come fork-free
#   out of the .git FILE's gitdir line and that admin dir's HEAD.
worktree_branch() {
    local path="$1" gitfile line gitdir ref
    worktree_branch_out=""
    worktree_repo_out=""
    gitfile="$path/.git"
    [[ -f "$gitfile" ]] || return 0
    line=""
    IFS= read -r line < "$gitfile" 2>/dev/null || :
    case "$line" in
        "gitdir: "*) gitdir="${line#gitdir: }" ;;
        *) return 0 ;;
    esac
    case "$gitdir" in
        */.git/worktrees/*) worktree_repo_out="${gitdir%%/.git/worktrees/*}" ;;
    esac
    [[ -f "$gitdir/HEAD" ]] || return 0
    ref=""
    IFS= read -r ref < "$gitdir/HEAD" 2>/dev/null || :
    case "$ref" in
        "ref: refs/heads/"*) worktree_branch_out="${ref#ref: refs/heads/}" ;;
        *) worktree_branch_out="" ;;
    esac
}

# session_name_for_branch <repo-name> <branch>
#   The naming rule itself, into the global `session_name`: branch "/" -> "-"
#   (matching worktrunk's sanitize), then "." -> "_". Every naming path routes
#   through here so they cannot drift. Reads no filesystem and needs no
#   <path>, which is what lets bin/wt-tmux-cleanup call it from post-remove /
#   post-merge, after the worktree directory is already gone.
session_name_for_branch() {
    local repo_name="$1"
    local branch="$2"
    local name="${repo_name}_${branch//\//-}"
    session_name="${name//./_}"
}

# session_name_for_removed <repo-name> <path> <branch>
#   wt-tmux-cleanup's naming entry point; writes the global `session_name`.
#   worktrunk always passes a 3rd hook argument to post-remove/post-merge, and
#   for a DETACHED worktree it renders as the literal string "HEAD" (empirical,
#   wt v0.68.0; the docs claim `branch` is undefined there), never empty. Empty
#   and "HEAD" therefore both mean "no real branch" and fall back to
#   session_name_for's path-basename rule — the same name Ctrl+F and
#   wt-tmux-jump give that worktree. "HEAD" is an unambiguous sentinel: it can
#   never be a real branch (`git check-ref-format --branch HEAD` refuses it).
session_name_for_removed() {
    local repo_name="$1"
    local path="$2"
    local branch="$3"
    if [[ -z "$branch" || "$branch" == "HEAD" ]]; then
        session_name_for "$path"
    else
        session_name_for_branch "$repo_name" "$branch"
    fi
}

# session_name_for <path>
#   Session name for a project/worktree path, into the global `session_name`
#   (no subshell per call: this runs once per candidate dir on the hot path).
#   Agent worktree (<repo>/.claude/worktrees/<x>) -> "<repo>_<branch>",
#   detached -> "<repo>_<basename>"; legacy .bare/ worktree ->
#   "<project>_<branch>"; anything else (plain project dir, or a worktrunk
#   sibling like proj.feat-x, whose dir name already encodes repo+branch) ->
#   basename. The branch lookup reads the filesystem, so it only works while
#   the worktree still exists — that is why callers running after removal use
#   session_name_for_branch instead.
session_name_for() {
    # One variable per `local` on purpose: bash expands every word of a
    # `local a=$x b=$a` command before any of its assignments take effect, so
    # a combined statement would compute parent/base from path's OLD value.
    local path="$1"
    local parent="${path%/*}"
    local base="${path##*/}"
    local name repo repo_base

    case "$path" in
        */.claude/worktrees/*)
            repo="${path%%/.claude/worktrees/*}"
            repo_base="${repo##*/}"
            worktree_branch "$path"
            if [[ -n "$worktree_branch_out" ]]; then
                session_name_for_branch "$repo_base" "$worktree_branch_out"
                return
            fi
            name="${repo_base}_${base}"
            ;;
        *)
            if [[ -d "$parent/.bare" ]]; then
                name="${parent##*/}_${base}"
            else
                name="$base"
            fi
            ;;
    esac
    session_name="${name//./_}"
}

# _project_dirs_add_one <path>
#   Appends <path> to project_dirs_out, then its agent worktrees when <path>
#   is a main worktree (.git is a directory, not a linked worktree's file).
_project_dirs_add_one() {
    local cand="$1" wt
    project_dirs_out+=("$cand")
    if [[ -d "$cand/.git" ]]; then
        for wt in "$cand"/.claude/worktrees/*/; do
            wt="${wt%/}"
            _project_dirs_add_one "$wt"
        done
    fi
}

# _project_dirs_add_candidate <path>
#   Expands a legacy .bare/ container into its worktree children, otherwise
#   adds <path> directly.
_project_dirs_add_candidate() {
    local cand="$1" wt
    if [[ -d "$cand/.bare" ]]; then
        for wt in "$cand"/*/; do
            wt="${wt%/}"
            [[ "${wt##*/}" == ".bare" ]] && continue
            _project_dirs_add_one "$wt"
        done
    else
        _project_dirs_add_one "$cand"
    fi
}

# project_dirs
#   Fills the global array project_dirs_out, per search_dirs entry: the entry
#   itself (depth 0) or its immediate children (depth 1); legacy .bare/
#   containers expanded into their worktree children; those candidates' agent
#   worktrees (<cand>/.claude/worktrees/*/); and, for depth-0 entries only,
#   worktrunk siblings (<entry>.*/) that really are linked worktrees (.git is
#   a FILE), so a plain sibling like proj.bak is skipped. Depth-1 entries need
#   no sibling pass: their siblings are already depth-1 rows.
#   Deliberately never builds an intermediate candidates array to iterate with
#   "${arr[@]}": bash 3.2 treats that expansion as unbound under `set -u` when
#   the array is empty (a depth-1 entry with no subdirectories), and
#   bin/worktree-doctor sources this into a `set -uo pipefail` shell. Globbing
#   straight into `for x in <pattern>` with nullglob just runs zero times.
project_dirs() {
    project_dirs_out=()
    local entry dir depth cand sib

    # bash 3.2 + `set -u`: "${arr[@]}" on a ZERO-element array is "unbound".
    (( ${#search_dirs[@]} )) || return 0
    shopt -s nullglob
    for entry in "${search_dirs[@]}"; do
        dir="${entry%%:*}"
        depth="${entry##*:}"

        if [[ "$depth" -eq 0 ]]; then
            _project_dirs_add_candidate "$dir"
        else
            for cand in "$dir"/*/; do
                cand="${cand%/}"
                _project_dirs_add_candidate "$cand"
            done
        fi

        if [[ "$depth" -eq 0 ]]; then
            for sib in "$dir".*/; do
                sib="${sib%/}"
                [[ -f "$sib/.git" ]] || continue
                project_dirs_out+=("$sib")
            done
        fi
    done
    shopt -u nullglob
}
