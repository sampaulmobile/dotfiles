#!/usr/bin/env bash

# Claude attention layer: flag files for "finished but unseen" claude
# panes. Fed by the Stop hook, consumed by tmux-claude-statusbar (✅
# count) and the C-y jump binding (dots/tmux.conf).
#
# Flag dir: ~/.cache/claude-attention/ — one file per claude PANE,
# `<session>@<pane-id-sans-%>.done` (e.g. `dotfiles@228.done`), touched to
# flag and removed to clear. Pane granularity matters twice over: a claude
# finishing in a non-visible window of an ATTACHED session used to be
# suppressed entirely (the old session-level self-flag check), and
# clearing used to wipe the whole session's flag on attach even when the
# finished claude's window was never looked at. "Seen" now means the
# pane's window became the visible (current) window of a client-attached
# session.
#
# To wire up the Stop hook, add this to ~/.claude/settings.json
# (machine-local, NOT this repo — see other/claude/ in CLAUDE.md):
#
#   "hooks": {
#     "Stop": [
#       {
#         "matcher": "",
#         "hooks": [
#           {
#             "type": "command",
#             "command": "~/dotfiles/bin/tmux-claude-attention flag-done",
#             "async": true
#           }
#         ]
#       }
#     ]
#   }
#
# Subcommands:
#   flag-done        Touch a flag for the calling pane. Called by the Stop
#                    hook (runs as a child of the claude process, so the
#                    owning pane is $TMUX_PANE). Silent no-op outside tmux,
#                    and when the pane is actually on screen (its window is
#                    the session's current one AND a client is attached —
#                    you watched it finish).
#   clear <session>  Remove the flags for the panes in <session>'s current
#                    window (what's on screen). Called by the tmux
#                    client-attached / client-session-changed /
#                    session-window-changed hooks. Gated on a client being
#                    attached to <session>: session-window-changed fires
#                    for DETACHED sessions too (scripts select-window on
#                    headless sessions — new_hub_session, wt-tmux-jump),
#                    and a window nobody watched wasn't "seen".
#   list             Print flagged panes ("<session>\t<pane-id>") whose
#                    pane is still live, newest-first. Prunes flags for
#                    dead panes (and legacy session-level flags) as it
#                    goes.
#   jump [client-tty]
#                    Switch to the session most needing attention: first a
#                    session waiting on a permission prompt, else the
#                    newest done-flag, else a "nothing needs attention"
#                    tmux message. client-tty (tmux's #{client_tty}) scopes
#                    switch-client/display-message to the invoking client —
#                    dots/tmux.conf's binding always passes it. Falls back
#                    to unscoped (tmux's own most-recently-active-client
#                    pick) only when called with no argument, so ad hoc CLI
#                    invocation (`tmux-claude-attention jump`) still works.

source ~/dotfiles/bin/tmux-claude-lib

FLAG_DIR="$HOME/.cache/claude-attention"

# flag_path <session> <pane-id>
#   Pane ids are server-unique (%N), but the session name stays in the
#   filename so the sessionizer can color rows green from a plain glob and
#   clear/list can filter per session without a tmux round trip.
flag_path() {
    printf '%s/%s@%s.done' "$FLAG_DIR" "$1" "${2#%}"
}

# file_mtime <path>
#   Prints a file's mtime as epoch seconds (GNU/BSD stat portable).
file_mtime() {
    stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null
}

cmd_flag_done() {
    # Not in tmux — nothing to flag.
    [[ -z "${TMUX_PANE:-}" ]] && exit 0

    local session wactive
    IFS=$'\t' read -r session wactive < <(tmux display -pt "$TMUX_PANE" $'#{session_name}\t#{window_active}' 2>/dev/null)
    [[ -z "$session" ]] && exit 0

    # Suppress self-flagging only when this pane is actually on screen:
    # its window is the session's current one AND a client is attached.
    # (The old session-level check swallowed the flag whenever ANY window
    # of the session was being watched — a claude finishing in window 4
    # while you looked at window 1 never flagged at all.)
    if [[ "$wactive" == "1" ]] \
        && tmux list-clients -F '#{client_session}' 2>/dev/null | grep -qxF "$session"; then
        exit 0
    fi

    mkdir -p "$FLAG_DIR"
    touch "$(flag_path "$session" "$TMUX_PANE")"
}

cmd_clear() {
    local session="$1"
    [[ -z "$session" ]] && exit 0

    # Early exit with zero tmux round trips when the session has no flags:
    # this runs on EVERY window switch anywhere (session-window-changed
    # hook), so the common case must stay a glob test.
    local flags=("$FLAG_DIR/${session}@"*.done)
    [[ -e "${flags[0]}" ]] || exit 0

    # "Seen" requires a watcher: session-window-changed fires for detached
    # sessions too (scripts select-window on headless sessions), and a
    # window nobody watched must keep its flags.
    tmux list-clients -F '#{client_session}' 2>/dev/null | grep -qxF "$session" || exit 0

    # Panes of the session's current window = what's on screen now
    # (list-panes with a bare session target uses its current window).
    local pane
    for pane in $(tmux list-panes -t "=${session}" -F '#{pane_id}' 2>/dev/null); do
        rm -f "$(flag_path "$session" "$pane")"
    done
}

cmd_list() {
    [[ -d "$FLAG_DIR" ]] || return 0

    # One tmux round trip for the whole live-pane set, then check each
    # flag against it in pure bash — a per-flag tmux call would easily
    # blow the statusbar's 200ms budget once more than a couple of panes
    # are flagged at once.
    local live=$'\n'
    live+=$(tmux list-panes -a -F '#{session_name}@#{pane_id}' 2>/dev/null)
    live+=$'\n'

    local f key session pane
    for f in "$FLAG_DIR"/*.done; do
        [[ -e "$f" ]] || continue
        key="${f##*/}"
        key="${key%.done}"
        session="${key%@*}"
        pane="${key##*@}"
        if [[ "$key" == *@* && "$live" == *$'\n'"${session}@%${pane}"$'\n'* ]]; then
            printf '%s\t%s\t%s\n' "$(file_mtime "$f")" "$session" "%${pane}"
        else
            # dead pane, or a legacy session-level flag (pre-pane format)
            rm -f "$f"
        fi
    done | sort -rn | cut -f2,3
}

# restore_popup <session> [client-tty]
#   If <session> had a claude popup open when it was last left
#   (@claude_popup=1, set by tmux-claude-popup / preserved by the
#   sessionizer), reopen it on arrival — same courtesy the sessionizer
#   extends on C-f. Backgrounded: display-popup -E blocks until the popup
#   closes, and this script must not hang on it.
restore_popup() {
    local s="$1" client="$2"
    [[ "$(tmux show -qv -t "${s}:" @claude_popup 2>/dev/null)" == "1" ]] || return 0
    tmux has-session -t "=claude-$s" 2>/dev/null || return 0
    local -a pc=()
    [[ -n "$client" ]] && pc=(-c "$client")
    (tmux display-popup "${pc[@]}" -E -w 80% -h 80% "tmux attach-session -t 'claude-$s'" >/dev/null 2>&1 &)
}

cmd_jump() {
    local client="$1"
    local session

    # Scope switch-client/display-message to the invoking client when we
    # know it. run-shell spawns a plain shell — the tmux CLI invocations
    # inside it are fresh clients with no attached-client identity, so an
    # unscoped `switch-client -t` falls back to tmux's own pick (the
    # most-recently-active attached client), which can silently yank a
    # DIFFERENT real attached client to the target session — observed live
    # during development, hence the explicit scoping. Only fall back to
    # unscoped when called with no client (ad hoc CLI use).
    local -a cflag=()
    [[ -n "$client" ]] && cflag=(-c "$client")

    # Resolve the jump target FIRST. Popup handling (closing it, redirecting
    # to the outer client) must only happen when there is actually somewhere
    # to go — otherwise a no-op C-y would eat the popup for nothing.

    # exit_via_popup_check: called with a confirmed target right before
    # switching. If the invoking client is a claude-* popup, dismiss it and
    # redirect to the newest non-popup client (popup-in-popup prevention).
    exit_via_popup_check() {
        [[ -z "$client" ]] && return 0
        local csess
        csess=$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null \
            | awk -v t="$client" '$1 == t {print $2}')
        if [[ "$csess" == claude-* ]]; then
            local parent
            parent=$(tmux list-clients -F '#{client_activity} #{client_tty} #{client_session}' 2>/dev/null \
                | awk '$3 !~ /^claude-/ {print $1, $2}' | sort -rn | awk 'NR==1 {print $2}')
            tmux detach-client -t "$client" 2>/dev/null
            client="$parent"   # may be empty -> unscoped fallback
            cflag=()
            [[ -n "$client" ]] && cflag=(-c "$client")
        fi
    }

    # Popup-aware targets: a flagged claude-<proj> popup session shouldn't
    # be attached fullscreen — route to its project session <proj> instead
    # (consuming the popup's flags ourselves, since the attach hook will
    # only clear <proj>'s). User re-opens the popup there with C-Space.
    do_switch() {
        local target="$1" pane="$2"
        if [[ "$target" == claude-* ]] && tmux has-session -t "=${target#claude-}" 2>/dev/null; then
            rm -f "${FLAG_DIR}/${target}"@*.done "${FLAG_DIR}/${target}.done"
            target="${target#claude-}"
            pane=""
        fi
        exit_via_popup_check
        tmux switch-client "${cflag[@]}" -t "=$target"
        if [[ -n "$pane" ]]; then
            # land on the flagged pane's window (a pane id resolves to its
            # window), and consume its flag directly — the hooks only clear
            # what a client is looking at, and on a server whose loaded
            # config predates the session-window-changed hook nothing else
            # would clear it after this select-window.
            tmux select-window -t "$pane" 2>/dev/null \
                && tmux select-pane -t "$pane" 2>/dev/null
            rm -f "$(flag_path "$target" "$pane")"
        fi
        restore_popup "$target" "$client"
    }

    # Priority 1: a session waiting on a permission prompt (most recently
    # active first). One shared multi-pane scan (scan_claude_sessions in
    # tmux-claude-lib): two tmux round trips total instead of the old
    # serial capture-pane per session, covers claudes outside window 1,
    # and never reads a non-claude pane (the old per-session
    # get_session_status had no tty gate — a vim buffer showing prompt
    # literals could become a jump target).
    local perm_sessions=$'\n'
    local st
    while IFS=$'\t' read -r session st; do
        [[ "$st" == "permission" ]] && perm_sessions+="${session}"$'\n'
    done < <(scan_claude_sessions)
    if [[ "$perm_sessions" != $'\n' ]]; then
        while IFS= read -r session; do
            [[ -z "$session" ]] && continue
            if [[ "$perm_sessions" == *$'\n'"${session}"$'\n'* ]]; then
                do_switch "$session"
                return
            fi
        done < <(tmux list-sessions -F '#{session_activity} #{session_name}' 2>/dev/null | sort -rn | awk '{print $2}')
    fi

    # Priority 2: the newest finished-but-unseen pane.
    local pane=""
    IFS=$'\t' read -r session pane < <(cmd_list | head -1)
    if [[ -n "$session" ]]; then
        do_switch "$session" "$pane"
        return
    fi

    tmux display-message "${cflag[@]}" "nothing needs attention"
}

# cmd_last <client-tty>
#   Popup-aware "toggle to last session" (C-t): a popup client has no last
#   session of its own, so from inside a claude-* popup we dismiss the popup
#   and toggle the newest non-popup client instead. Ordinary clients are
#   handled natively by the binding and never reach this path.
cmd_last() {
    local client="$1"
    [[ -z "$client" ]] && { tmux switch-client -l 2>/dev/null; return; }
    local csess
    csess=$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null \
        | awk -v t="$client" '$1 == t {print $2}')
    if [[ "$csess" == claude-* ]]; then
        local parent
        parent=$(tmux list-clients -F '#{client_activity} #{client_tty} #{client_session}' 2>/dev/null \
            | awk '$3 !~ /^claude-/ {print $1, $2}' | sort -rn | awk 'NR==1 {print $2}')
        tmux detach-client -t "$client" 2>/dev/null
        if [[ -n "$parent" ]]; then
            tmux switch-client -c "$parent" -l 2>/dev/null \
                && restore_popup "$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null \
                       | awk -v t="$parent" '$1 == t {print $2}')" "$parent"
        fi
    else
        tmux switch-client -c "$client" -l 2>/dev/null \
            && restore_popup "$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null \
                   | awk -v t="$client" '$1 == t {print $2}')" "$client"
    fi
}

case "${1:-}" in
    flag-done) cmd_flag_done ;;
    clear)     cmd_clear "${2:-}" ;;
    list)      cmd_list ;;
    jump)      cmd_jump "${2:-}" ;;
    last)      cmd_last "${2:-}" ;;
    *)
        echo "usage: $(basename "$0") {flag-done|clear <session>|list|jump [client-tty]|last [client-tty]}" >&2
        exit 1
        ;;
esac
