#!/usr/bin/env bash

# Claude attention layer: flag files for "finished but unseen" tmux
# sessions. Fed by the Stop hook, consumed by tmux-claude-statusbar (✅
# count) and the C-y jump binding (dots/tmux.conf).
#
# Flag dir: ~/.cache/claude-attention/ — one file per tmux session name,
# `<session>.done`, touched to flag and removed to clear.
#
# To wire up the Stop hook, add this to ~/.claude/settings.json
# (machine-local, NOT this repo — see other/claude/ in CLAUDE.md):
#
#   "hooks": {
#     "Stop": [
#       {
#         "matcher": "",
#         "hooks": [
#           {
#             "type": "command",
#             "command": "~/dotfiles/bin/tmux-claude-attention flag-done",
#             "async": true
#           }
#         ]
#       }
#     ]
#   }
#
# Subcommands:
#   flag-done        Touch a flag for the calling session. Called by the
#                    Stop hook (runs as a child of the claude process, so
#                    the owning session is derived from $TMUX_PANE). Silent
#                    no-op outside tmux, and when any client is currently
#                    attached to the owning session (you watched it finish).
#   clear <session>  Remove the flag for <session>. Called by the tmux
#                    client-attached/client-session-changed hooks.
#   list             Print flagged sessions whose tmux session still
#                    exists, newest-first. Prunes flags for dead sessions
#                    as it goes.
#   jump [client-tty]
#                    Switch to the session most needing attention: first a
#                    session waiting on a permission prompt, else the
#                    newest done-flag, else a "nothing needs attention"
#                    tmux message. client-tty (tmux's #{client_tty}) scopes
#                    switch-client/display-message to the invoking client —
#                    dots/tmux.conf's binding always passes it. Falls back
#                    to unscoped (tmux's own most-recently-active-client
#                    pick) only when called with no argument, so ad hoc CLI
#                    invocation (`tmux-claude-attention jump`) still works.

source ~/dotfiles/bin/tmux-claude-lib

FLAG_DIR="$HOME/.cache/claude-attention"

flag_path() {
    printf '%s/%s.done' "$FLAG_DIR" "$1"
}

# file_mtime <path>
#   Prints a file's mtime as epoch seconds (GNU/BSD stat portable).
file_mtime() {
    stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null
}

cmd_flag_done() {
    # Not in tmux — nothing to flag.
    [[ -z "${TMUX_PANE:-}" ]] && exit 0

    local session
    session=$(tmux display -pt "$TMUX_PANE" '#{session_name}' 2>/dev/null)
    [[ -z "$session" ]] && exit 0

    # Suppress self-flagging: any client attached to this session watched
    # it finish, so there's nothing to flag.
    if tmux list-clients -F '#{client_session}' 2>/dev/null | grep -qxF "$session"; then
        exit 0
    fi

    mkdir -p "$FLAG_DIR"
    touch "$(flag_path "$session")"
}

cmd_clear() {
    local session="$1"
    [[ -z "$session" ]] && exit 0
    rm -f "$(flag_path "$session")"
}

cmd_list() {
    [[ -d "$FLAG_DIR" ]] || return 0

    # One tmux round trip for the whole live-session set, then check each
    # flag against it in pure bash — a has-session call per flag file
    # would be one more tmux round trip per flag, easily blowing the
    # statusbar's 200ms budget once more than a couple of sessions are
    # flagged at once.
    local live=$'\n'
    live+=$(tmux list-sessions -F '#{session_name}' 2>/dev/null)
    live+=$'\n'

    local f session
    for f in "$FLAG_DIR"/*.done; do
        [[ -e "$f" ]] || continue
        session="${f##*/}"
        session="${session%.done}"
        if [[ "$live" == *$'\n'"$session"$'\n'* ]]; then
            printf '%s\t%s\n' "$(file_mtime "$f")" "$session"
        else
            rm -f "$f"
        fi
    done | sort -rn | cut -f2
}

# restore_popup <session> [client-tty]
#   If <session> had a claude popup open when it was last left
#   (@claude_popup=1, set by tmux-claude-popup / preserved by the
#   sessionizer), reopen it on arrival — same courtesy the sessionizer
#   extends on C-f. Backgrounded: display-popup -E blocks until the popup
#   closes, and this script must not hang on it.
restore_popup() {
    local s="$1" client="$2"
    [[ "$(tmux show -qv -t "${s}:" @claude_popup 2>/dev/null)" == "1" ]] || return 0
    tmux has-session -t "=claude-$s" 2>/dev/null || return 0
    local -a pc=()
    [[ -n "$client" ]] && pc=(-c "$client")
    (tmux display-popup "${pc[@]}" -E -w 80% -h 80% "tmux attach-session -t 'claude-$s'" >/dev/null 2>&1 &)
}

cmd_jump() {
    local client="$1"
    local session

    # Scope switch-client/display-message to the invoking client when we
    # know it. run-shell spawns a plain shell — the tmux CLI invocations
    # inside it are fresh clients with no attached-client identity, so an
    # unscoped `switch-client -t` falls back to tmux's own pick (the
    # most-recently-active attached client), which can silently yank a
    # DIFFERENT real attached client to the target session — observed live
    # during development, hence the explicit scoping. Only fall back to
    # unscoped when called with no client (ad hoc CLI use).
    local -a cflag=()
    [[ -n "$client" ]] && cflag=(-c "$client")

    # Resolve the jump target FIRST. Popup handling (closing it, redirecting
    # to the outer client) must only happen when there is actually somewhere
    # to go — otherwise a no-op C-y would eat the popup for nothing.

    # exit_via_popup_check: called with a confirmed target right before
    # switching. If the invoking client is a claude-* popup, dismiss it and
    # redirect to the newest non-popup client (popup-in-popup prevention).
    exit_via_popup_check() {
        [[ -z "$client" ]] && return 0
        local csess
        csess=$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null \
            | awk -v t="$client" '$1 == t {print $2}')
        if [[ "$csess" == claude-* ]]; then
            local parent
            parent=$(tmux list-clients -F '#{client_activity} #{client_tty} #{client_session}' 2>/dev/null \
                | awk '$3 !~ /^claude-/ {print $1, $2}' | sort -rn | awk 'NR==1 {print $2}')
            tmux detach-client -t "$client" 2>/dev/null
            client="$parent"   # may be empty -> unscoped fallback
            cflag=()
            [[ -n "$client" ]] && cflag=(-c "$client")
        fi
    }

    # Popup-aware targets: a flagged claude-<proj> popup session shouldn't
    # be attached fullscreen — route to its project session <proj> instead
    # (consuming the popup's flag ourselves, since the attach hook will only
    # clear <proj>'s). User re-opens the popup there with C-Space.
    do_switch() {
        local target="$1"
        if [[ "$target" == claude-* ]] && tmux has-session -t "=${target#claude-}" 2>/dev/null; then
            rm -f "${FLAG_DIR}/${target}.done"
            target="${target#claude-}"
        fi
        exit_via_popup_check
        tmux switch-client "${cflag[@]}" -t "=$target"
        restore_popup "$target" "$client"
    }

    # Priority 1: a session waiting on a permission prompt (most recently
    # active first). One shared multi-pane scan (scan_claude_sessions in
    # tmux-claude-lib): two tmux round trips total instead of the old
    # serial capture-pane per session, covers claudes outside window 1,
    # and never reads a non-claude pane (the old per-session
    # get_session_status had no tty gate — a vim buffer showing prompt
    # literals could become a jump target).
    local perm_sessions=$'\n'
    local st
    while IFS=$'\t' read -r session st; do
        [[ "$st" == "permission" ]] && perm_sessions+="${session}"$'\n'
    done < <(scan_claude_sessions)
    if [[ "$perm_sessions" != $'\n' ]]; then
        while IFS= read -r session; do
            [[ -z "$session" ]] && continue
            if [[ "$perm_sessions" == *$'\n'"${session}"$'\n'* ]]; then
                do_switch "$session"
                return
            fi
        done < <(tmux list-sessions -F '#{session_activity} #{session_name}' 2>/dev/null | sort -rn | awk '{print $2}')
    fi

    # Priority 2: the newest finished-but-unseen session.
    session=$(cmd_list | head -1)
    if [[ -n "$session" ]]; then
        do_switch "$session"
        return
    fi

    tmux display-message "${cflag[@]}" "nothing needs attention"
}

# cmd_last <client-tty>
#   Popup-aware "toggle to last session" (C-t): a popup client has no last
#   session of its own, so from inside a claude-* popup we dismiss the popup
#   and toggle the newest non-popup client instead. Ordinary clients are
#   handled natively by the binding and never reach this path.
cmd_last() {
    local client="$1"
    [[ -z "$client" ]] && { tmux switch-client -l 2>/dev/null; return; }
    local csess
    csess=$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null \
        | awk -v t="$client" '$1 == t {print $2}')
    if [[ "$csess" == claude-* ]]; then
        local parent
        parent=$(tmux list-clients -F '#{client_activity} #{client_tty} #{client_session}' 2>/dev/null \
            | awk '$3 !~ /^claude-/ {print $1, $2}' | sort -rn | awk 'NR==1 {print $2}')
        tmux detach-client -t "$client" 2>/dev/null
        if [[ -n "$parent" ]]; then
            tmux switch-client -c "$parent" -l 2>/dev/null \
                && restore_popup "$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null \
                       | awk -v t="$parent" '$1 == t {print $2}')" "$parent"
        fi
    else
        tmux switch-client -c "$client" -l 2>/dev/null \
            && restore_popup "$(tmux list-clients -F '#{client_tty} #{client_session}' 2>/dev/null \
                   | awk -v t="$client" '$1 == t {print $2}')" "$client"
    fi
}

case "${1:-}" in
    flag-done) cmd_flag_done ;;
    clear)     cmd_clear "${2:-}" ;;
    list)      cmd_list ;;
    jump)      cmd_jump "${2:-}" ;;
    last)      cmd_last "${2:-}" ;;
    *)
        echo "usage: $(basename "$0") {flag-done|clear <session>|list|jump [client-tty]|last [client-tty]}" >&2
        exit 1
        ;;
esac
