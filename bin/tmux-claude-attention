#!/usr/bin/env bash

# Attention layer: flag files for "finished but unseen" agent panes. Fed by
# the Stop hook, consumed by tmux-claude-statusbar (✅ count) and the C-y
# jump binding (dots/tmux.conf).
#
# Flag dir: ~/.cache/claude-attention/ — one file per agent PANE,
# `<session>@<pane-id-sans-%>.done` (e.g. `dotfiles@228.done`), touched to
# flag and removed to clear. Everything here is per PANE, never per session:
# "seen" means THAT pane's window became the current window of a
# client-attached session. A session-level flag both suppresses a claude
# finishing in a background window of an attached session and clears a
# window nobody looked at.
#
# To wire up the Stop hook, add this to ~/.claude/settings.json
# (machine-local, NOT this repo — see other/claude/ in CLAUDE.md):
#
#   "hooks": {
#     "Stop": [
#       {
#         "matcher": "",
#         "hooks": [
#           {
#             "type": "command",
#             "command": "~/dotfiles/bin/tmux-claude-attention flag-done",
#             "async": true
#           }
#         ]
#       }
#     ]
#   }
#
# Subcommands (the cmd_* functions below carry the reasoning):
#   flag-done              Stop hook — flag the calling pane.
#   clear <session>        tmux client-attached / client-session-changed /
#                          session-window-changed hooks.
#   list                   Flagged live panes, newest first.
#   jump [client-tty]      C-y. Permission prompt first, else newest flag.
#   codex-session-start    codex SessionStart hook (dots/codex/hooks.json).
#   codex-session-end      codex SessionEnd hook.

source ~/dotfiles/bin/tmux-claude-lib

FLAG_DIR="$HOME/.cache/claude-attention"

# Pane -> codex rollout map. Claude Code records its own tmux pane in
# ~/.claude/sessions/*.json; codex records nothing of the sort, so its
# SessionStart hook writes the mapping here instead:
#   <FLAG_DIR>/codex/<pane-id-sans-%>.tsv = "<session_id>\t<rollout>\t<cwd>"
# One file per pane, replaced (not appended) on every SessionStart — codex
# fires that on a thread's first prompt and again after /new, so the entry
# follows the pane through new threads. $CODEX_MAP_DIR comes from
# bin/tmux-claude-lib-codex (sourced above): writer and reader must not be
# able to drift apart.

# flag_path <session> <pane-id>
#   Pane ids are server-unique (%N), but the session name stays in the
#   filename so the sessionizer can color rows green from a plain glob and
#   clear/list can filter per session without a tmux round trip.
flag_path() {
    printf '%s/%s@%s.done' "$FLAG_DIR" "$1" "${2#%}"
}

# file_mtime <path>
#   Prints a file's mtime as epoch seconds (GNU/BSD stat portable).
file_mtime() {
    stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null
}

cmd_flag_done() {
    # The Stop hook runs as a child of the agent process, so $TMUX_PANE is
    # the pane that finished. Nothing to flag without one.
    [[ -z "${TMUX_PANE:-}" ]] && exit 0

    local session wactive cur
    IFS=$'\t' read -r session wactive cur < <(tmux display -pt "$TMUX_PANE" $'#{session_name}\t#{window_active}\t#{@agent_status}' 2>/dev/null)
    [[ -z "$session" ]] && exit 0

    # Suppress the flag only when THIS pane is on screen: its window is the
    # session's current one AND a client is attached. Testing the session
    # instead swallows the flag whenever any window of it is being watched,
    # so a claude finishing in window 4 while you read window 1 never flags.
    if [[ "$wactive" == "1" ]] \
        && tmux list-clients -F '#{client_session}' 2>/dev/null | grep -qxF "$session"; then
        exit 0
    fi

    mkdir -p "$FLAG_DIR"
    touch "$(flag_path "$session" "$TMUX_PANE")"

    # A still-busy sibling agent pane in the same window outranks the flag
    # (window_status_from_panes precedence), so leave those alone.
    case "$cur" in
        permission|working) ;;
        *) tmux set-option -wq -t "$TMUX_PANE" @agent_status done 2>/dev/null ;;
    esac
}

cmd_clear() {
    local session="$1"
    [[ -z "$session" ]] && exit 0

    # Early exit with zero tmux round trips when the session has no flags:
    # this runs on EVERY window switch anywhere (session-window-changed
    # hook), so the common case must stay a glob test.
    local flags=("$FLAG_DIR/${session}@"*.done)
    [[ -e "${flags[0]}" ]] || exit 0

    # "Seen" requires a watcher: session-window-changed fires for detached
    # sessions too (scripts select-window on headless sessions), and a
    # window nobody watched must keep its flags.
    tmux list-clients -F '#{client_session}' 2>/dev/null | grep -qxF "$session" || exit 0

    # Panes of the session's current window = what's on screen now. The
    # trailing colon matters: list-panes takes a target-WINDOW, and a bare
    # "=name" is first tried as a window called "name" in the caller's own
    # session (nvim titles its window after the repo dir, so a hub session
    # "dotfiles" has a window "dotfiles" — and the wrong window's flags got
    # cleared). "=name:" is unambiguously that session's current window.
    local pane cur
    while IFS=$'\t' read -r pane cur; do
        [[ -z "$pane" ]] && continue
        rm -f "$(flag_path "$session" "$pane")"
    done < <(tmux list-panes -t "=${session}:" -F $'#{pane_id}\t#{@agent_status}' 2>/dev/null)
    [[ "$cur" == "done" ]] && tmux set-option -wq -t "=${session}:" @agent_status idle 2>/dev/null
}

cmd_list() {
    [[ -d "$FLAG_DIR" ]] || return 0

    # One tmux round trip for the whole live-pane set, then test each flag
    # against it in pure bash: a per-flag tmux call blows the statusbar's
    # 200ms budget as soon as more than a couple of panes are flagged.
    local live=$'\n'
    live+=$(tmux list-panes -a -F '#{session_name}@#{pane_id}' 2>/dev/null)
    live+=$'\n'

    # Prune map entries whose pane is gone: codex's SessionEnd removes its
    # own, but a killed pane never gets one. Reuses the live-pane set above.
    local m mpane
    for m in "$CODEX_MAP_DIR"/*.tsv; do
        [[ -e "$m" ]] || continue
        mpane="${m##*/}"
        mpane="${mpane%.tsv}"
        [[ "$live" == *"@%${mpane}"$'\n'* ]] || rm -f "$m"
    done

    local f key session pane
    for f in "$FLAG_DIR"/*.done; do
        [[ -e "$f" ]] || continue
        key="${f##*/}"
        key="${key%.done}"
        session="${key%@*}"
        pane="${key##*@}"
        if [[ "$key" == *@* && "$live" == *$'\n'"${session}@%${pane}"$'\n'* ]]; then
            printf '%s\t%s\t%s\n' "$(file_mtime "$f")" "$session" "%${pane}"
        else
            # dead pane, or a legacy session-level flag (pre-pane format)
            rm -f "$f"
        fi
    done | sort -rn | cut -f2,3
}

cmd_jump() {
    local client="$1"
    local session

    # Scope switch-client/display-message to the invoking client whenever
    # it is known (dots/tmux.conf's binding always passes #{client_tty}).
    # run-shell spawns a plain shell, whose tmux invocations are fresh
    # clients with no attached-client identity, so an unscoped
    # `switch-client -t` falls back to tmux's most-recently-active attached
    # client and can yank a DIFFERENT real client to the target session —
    # seen live. Unscoped is only for ad hoc CLI use with no argument.
    local -a cflag=()
    [[ -n "$client" ]] && cflag=(-c "$client")

    do_switch() {
        local target="$1" pane="$2"
        tmux switch-client "${cflag[@]}" -t "=$target"
        if [[ -n "$pane" ]]; then
            # Land on the flagged pane's window (a pane id resolves to its
            # window) and consume the flag here: the tmux hooks only clear
            # what a client is looking at, and a server whose loaded config
            # predates the session-window-changed hook would clear nothing
            # after this select-window.
            tmux select-window -t "$pane" 2>/dev/null \
                && tmux select-pane -t "$pane" 2>/dev/null
            local f
            f=$(flag_path "$target" "$pane")
            if [[ -e "$f" ]]; then
                rm -f "$f"
                tmux set-option -wq -t "$pane" @agent_status idle 2>/dev/null
            fi
        fi
    }

    # Priority 1: a pane waiting on a permission prompt, most recently
    # active session first. Via the shared scan_claude_sessions, which is
    # tty-gated — a per-session capture with no tty gate can make a vim
    # buffer showing prompt literals into a jump target. Its 3rd field is
    # the pane exhibiting the status, so the jump lands on the prompt itself
    # rather than the session's current window.
    local perm_s=$'\n'
    local st pane
    while IFS=$'\t' read -r session st pane; do
        [[ "$st" == "permission" ]] && perm_s+="${session}"$'\t'"${pane}"$'\n'
    done < <(scan_claude_sessions)
    if [[ "$perm_s" != $'\n' ]]; then
        local rest
        while IFS= read -r session; do
            [[ -z "$session" ]] && continue
            rest="${perm_s#*$'\n'"$session"$'\t'}"
            if [[ "$rest" != "$perm_s" ]]; then
                do_switch "$session" "${rest%%$'\n'*}"
                return
            fi
        done < <(tmux list-sessions -F '#{session_activity} #{session_name}' 2>/dev/null | sort -rn | awk '{print $2}')
    fi

    # Priority 2: the newest finished-but-unseen pane.
    local pane=""
    IFS=$'\t' read -r session pane < <(cmd_list | head -1)
    if [[ -n "$session" ]]; then
        do_switch "$session" "$pane"
        return
    fi

    tmux display-message "${cflag[@]}" "nothing needs attention"
}

cmd_codex_session_start() {
    # Hooks inherit the shell environment, so $TMUX_PANE is the pane codex
    # runs in. It becomes a filename below: accept only tmux's own %N form.
    [[ "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]] || exit 0

    local input sid tpath cwd
    input=$(cat)
    # One field per LINE, not @tsv: tab is IFS whitespace, so a tab-split
    # read collapses an empty field and shifts every value after it.
    {
        read -r sid
        read -r tpath
        read -r cwd
    } <<< "$(printf '%s' "$input" |
        jq -r '.session_id // "", .transcript_path // "", .cwd // ""' 2>/dev/null)"

    # A payload without a transcript path is useless to the dashboard; leave
    # any existing entry alone rather than replacing it with nothing.
    [[ -z "$tpath" ]] && exit 0
    # Never write a leading empty field: the reader splits with IFS=$'\t',
    # a leading tab is swallowed as whitespace, and every value shifts left.
    sid=${sid:--}

    mkdir -p "$CODEX_MAP_DIR"
    local out="$CODEX_MAP_DIR/${TMUX_PANE#%}.tsv"
    local tmp="${out}.$$.tmp"
    # Atomic: the dashboard reads these while codex writes them.
    if printf '%s\t%s\t%s\n' "$sid" "$tpath" "$cwd" > "$tmp" 2>/dev/null; then
        mv -f "$tmp" "$out"
    else
        rm -f "$tmp"
    fi
}

cmd_codex_session_end() {
    [[ "${TMUX_PANE:-}" =~ ^%[0-9]+$ ]] || exit 0
    rm -f "$CODEX_MAP_DIR/${TMUX_PANE#%}.tsv"
}

case "${1:-}" in
    flag-done)           cmd_flag_done ;;
    clear)               cmd_clear "${2:-}" ;;
    list)                cmd_list ;;
    jump)                cmd_jump "${2:-}" ;;
    codex-session-start) cmd_codex_session_start ;;
    codex-session-end)   cmd_codex_session_end ;;
    *)
        echo "usage: $(basename "$0") {flag-done|clear <session>|list|jump [client-tty]|codex-session-start|codex-session-end}" >&2
        exit 1
        ;;
esac
