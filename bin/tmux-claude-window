#!/usr/bin/env bash

# The agent window bindings for the current project session. Bound directly
# in dots/tmux.conf: C-Space (toggle) and prefix+C (--extra).
#
# Which agent — claude or codex — is the session's @agent option, set when
# the session was built (see new_hub_session in tmux-claude-lib); the window
# is named after it, and typing the agent's name is what starts it.
#
# --extra names its new window "<agent>+": the trailing + is what keeps the
# toggle's by-name lookup from ever grabbing it. The attention layer finds
# agents by tty, so extra windows still reach the statusbar, dashboard and
# C-y with no wiring of their own.
#
# Both start the agent by typing into an initialized shell rather than
# running it as the window command: other/zshrc.local env (model, TLS, ...)
# must apply, and the window survives the agent exiting.

source ~/dotfiles/bin/tmux-claude-lib

session=$(tmux display-message -p '#S')
agent=$(session_agent "$session")
win_name=$(agent_window_name "$agent")

if [[ "${1:-}" == "--extra" ]]; then
    path=$(tmux display-message -p '#{pane_current_path}')
    new_win=$(tmux new-window -t "${session}:" -n "${win_name}+" -c "$path" -P -F '#{window_id}')
    tmux set-option -w -t "$new_win" automatic-rename off
    tmux send-keys -t "$new_win" "$agent" Enter
    exit 0
fi

agent_win=$(tmux list-windows -t "${session}:" -F '#{window_name} #{window_id}' 2>/dev/null \
    | awk -v n="$win_name" '$1 == n {print $2; exit}')

if [[ -n "$agent_win" ]]; then
    cur_win=$(tmux display-message -p '#{window_id}')
    if [[ "$cur_win" == "$agent_win" ]]; then
        tmux last-window 2>/dev/null || true
    else
        tmux select-window -t "$agent_win"
    fi
else
    path=$(tmux display-message -p '#{pane_current_path}')
    new_win=$(tmux new-window -t "${session}:" -n "$win_name" -c "$path" -P -F '#{window_id}')
    tmux set-option -w -t "$new_win" automatic-rename off
    tmux send-keys -t "$new_win" "$agent" Enter
fi
