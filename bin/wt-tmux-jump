#!/usr/bin/env bash
#
# wt-tmux-jump <worktree-path>
#
# worktrunk post-switch hook: land in a tmux session for the worktree
# instead of cd'ing the invoking pane (the wt() zsh wrapper passes
# --no-cd). Session naming matches tmux-sessionizer (bin/project-dirs-lib's
# session_name_for), so a `wt switch -c` sibling and an agent worktree for
# the same branch land on the same session. No-op outside tmux.

set -euo pipefail

path="${1:?usage: wt-tmux-jump <worktree-path>}"
[[ -n "${TMUX:-}" ]] || exit 0

source "$HOME/dotfiles/bin/project-dirs-lib"
session_name_for "$path"
name="$session_name"

if ! tmux has-session -t="$name" 2>/dev/null; then
    # standard hub layout ([claude,] nvim, zsh) — shared with tmux-sessionizer
    source "$HOME/dotfiles/bin/tmux-claude-lib"
    new_hub_session "$name" "$path"
fi
tmux switch-client -t "$name"
