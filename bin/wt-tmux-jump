#!/usr/bin/env bash
#
# wt-tmux-jump <worktree-path>
#
# worktrunk post-switch hook: land in a tmux session for the worktree instead
# of cd'ing the invoking pane (the wt() zsh wrapper passes --no-cd).
# `deck pick <path>` builds the session or wakes a parked one, then switches
# the caller's own client. Its naming is the same rule as bin/project-dirs-lib's
# session_name_for, which wt-tmux-cleanup uses to find the session again. No-op
# outside tmux and in agent shells (CLAUDECODE, see below).

set -euo pipefail

path="${1:?usage: wt-tmux-jump <worktree-path>}"
[[ -n "${TMUX:-}" ]] || exit 0
# Agent shells (Claude Code sets CLAUDECODE=1 for every Bash call) inherit
# TMUX too, and `wt switch -c` from one would otherwise auto-start a claude
# in a new session and switch-client the user's screen onto it. Ctrl+F (its
# Ctrl+W worktree view) still lists the worktree and builds its session.
[[ -n "${CLAUDECODE:-}" ]] && exit 0

exec deck pick "$path"
