#!/usr/bin/env bash

# Ambient attention layer for the tmux status bar.
# Called by tmux every status-interval (~5s) — must stay fast (<200ms).
# Output: "🔴N ✅N ●N " — zero-count segments are omitted entirely, and an
# all-zero result prints nothing (preserves the pre-existing empty
# status-right behavior when nothing needs attention).
#   🔴 permission — sessions waiting on a permission/plan prompt
#   ✅ done       — sessions finished since last visited (Stop hook flags,
#                   see bin/tmux-claude-attention)
#   ●  working    — sessions actively streaming output
#
# Scans ALL tmux sessions, not just claude-* popup sessions, so a headless
# project hub running claude directly (not in a floating popup) is counted
# too. All pane content is captured in a SINGLE chained tmux invocation
# (capture-pane + display-message separators for every session, one tmux
# client/server round trip total) rather than one tmux call per session —
# with more than a handful of sessions, per-session capture-pane calls
# alone blow the 200ms budget. Classification per pane reuses
# tmux-claude-lib's classify_pane_status (same heuristic as the dashboard),
# just fed from the batched capture instead of its own capture-pane call —
# gated by is_claude_pane_command against each pane's #{pane_current_command}
# (fetched in the same batched invocation) so a pane NOT running claude can
# never be misclassified as needing attention.

source ~/dotfiles/bin/tmux-claude-lib

sessions=()
while IFS= read -r s; do
    sessions+=("$s")
done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)

permission_count=0
working_count=0

if (( ${#sessions[@]} > 0 )); then
    # Randomized per-run so a pane line that happens to equal a fixed
    # separator literally (e.g. editing/catting these scripts themselves)
    # can't split a block early and miscount for a tick.
    sep="@@CLAUDE-ATTN-$$-${RANDOM}@@"
    # Distinct random tag prefixing each block's pane_current_command line
    # (fetched via the same batched invocation, no extra round trip) — used
    # to gate classification to panes actually running claude, see below.
    cmdtag="@@CLAUDE-ATTN-CMD-$$-${RANDOM}@@"
    args=()
    for s in "${sessions[@]}"; do
        args+=(display-message -t "${s}:1" -p "${cmdtag}#{pane_current_command}" \; capture-pane -t "${s}:1" -p -S -30 \; display-message -p "$sep" \;)
    done
    combined=$(tmux "${args[@]}" 2>/dev/null)

    block=""
    cmd=""
    have_cmd=0
    while IFS= read -r line; do
        if [[ "$line" == "$sep" ]]; then
            # Gate on the pane actually running claude — a vim buffer or
            # `git diff` showing this very script's "Yes"/"No"/"to
            # interrupt" literals must never count as permission/working
            # (round-1 finding: false positives from scanning ALL sessions
            # without an "is claude running here" check).
            if is_claude_pane_command "$cmd"; then
                case "$(classify_pane_status "$block")" in
                    permission) (( permission_count++ )) ;;
                    working)    (( working_count++ )) ;;
                esac
            fi
            block=""
            cmd=""
            have_cmd=0
        elif (( ! have_cmd )); then
            cmd="${line#$cmdtag}"
            have_cmd=1
        else
            block+="$line"$'\n'
        fi
    done <<< "$combined"
fi

done_count=$(~/dotfiles/bin/tmux-claude-attention list 2>/dev/null | grep -c .)

out=""
(( permission_count > 0 )) && out+="🔴${permission_count} "
(( done_count > 0 )) && out+="✅${done_count} "
(( working_count > 0 )) && out+="●${working_count} "

printf '%s' "$out"
