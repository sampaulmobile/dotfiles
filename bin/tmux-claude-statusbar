#!/usr/bin/env bash

# Ambient attention layer for the tmux status bar.
# Called by tmux every status-interval (~5s) — must stay fast (<200ms).
# Output: "🔴N ✅N ●N " — a zero-count segment is omitted, and an all-zero
# result prints nothing at all, leaving status-right empty.
#   🔴 permission — sessions waiting on a permission/plan prompt
#   ✅ done       — panes finished but unseen (bin/tmux-claude-attention)
#   ●  working    — sessions actively streaming output
#
# The scan is tmux-claude-lib's scan_agent_panes. 🔴/● count per session (a
# session with two working claudes is one ●); ✅ counts per pane, since each
# flag is an independent "go look at this".
#
# Side effects, every tick: ~/.cache/claude-attention/status.tsv (per-session
# "<session>\t<status>\t<pane>", the pane being the one exhibiting the worst
# status, rewritten atomically) for the sessionizer, and the @agent_status
# window option for the tab tint in dots/tmux.conf — deltas only, so a steady
# state writes nothing.

source ~/dotfiles/bin/tmux-claude-lib

STATUS_DIR="$HOME/.cache/claude-attention"

pane_lines=$(scan_agent_panes)
status_lines=$(aggregate_session_status "$pane_lines")

permission_count=0
working_count=0
if [[ -n "$status_lines" ]]; then
    # 3rd scan field (worst-status pane, for C-y's jump) is unused here
    while IFS=$'\t' read -r _name _status _; do
        case "$_status" in
            permission) (( permission_count++ )) ;;
            working)    (( working_count++ )) ;;
        esac
    done <<< "$status_lines"
fi

# Atomic (tmp + mv), and written even when empty so a consumer never acts on
# sessions that no longer run an agent. The sessionizer additionally ignores
# the file once its mtime is stale.
mkdir -p "$STATUS_DIR"
if { [[ -z "$status_lines" ]] || printf '%s\n' "$status_lines"; } > "${STATUS_DIR}/.status.$$.tmp" 2>/dev/null; then
    mv -f "${STATUS_DIR}/.status.$$.tmp" "${STATUS_DIR}/status.tsv"
fi

done_list=$(~/dotfiles/bin/tmux-claude-attention list 2>/dev/null)
done_count=$(printf '%s' "$done_list" | grep -c .)

want=$'\n'$(window_status_from_panes "$pane_lines" "$(printf '%s\n' "$done_list" | cut -f2)")$'\n'
opt_args=()
while IFS=$'\t' read -r _wid _cur; do
    [[ -z "$_wid" ]] && continue
    _rest="${want#*$'\n'"${_wid}"$'\t'}"
    if [[ "$_rest" == "$want" ]]; then
        [[ -n "$_cur" ]] && opt_args+=(set-option -wqu -t "$_wid" @agent_status \;)
    elif [[ "${_rest%%$'\n'*}" != "$_cur" ]]; then
        opt_args+=(set-option -wq -t "$_wid" @agent_status "${_rest%%$'\n'*}" \;)
    fi
done < <(tmux list-windows -a -F $'#{window_id}\t#{@agent_status}' 2>/dev/null)
(( ${#opt_args[@]} > 0 )) && tmux "${opt_args[@]}" 2>/dev/null

out=""
(( permission_count > 0 )) && out+="🔴${permission_count} "
(( done_count > 0 )) && out+="✅${done_count} "
(( working_count > 0 )) && out+="●${working_count} "

printf '%s' "$out"
