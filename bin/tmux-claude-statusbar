#!/usr/bin/env bash

# Called by tmux every status-interval (~5s) — must stay fast (<200ms).
#   🔴 permission — sessions waiting on a permission/plan prompt
#   ✅ done       — panes finished but unseen (bin/tmux-claude-attention)
#   ●  working    — sessions actively streaming output
#
# 🔴/● count per session (two working claudes in one session is one ●); ✅
# counts per pane, since each flag is an independent "go look at this".

source ~/dotfiles/bin/tmux-claude-lib
source ~/dotfiles/bin/hq-snapshot

pane_lines=$(scan_agent_panes)
status_lines=$(aggregate_session_status "$pane_lines")

permission_count=0
working_count=0
if [[ -n "$status_lines" ]]; then
    # 3rd scan field (worst-status pane, for C-y's jump) is unused here
    while IFS=$'\t' read -r _name _status _; do
        case "$_status" in
            permission) (( permission_count++ )) ;;
            working)    (( working_count++ )) ;;
        esac
    done <<< "$status_lines"
fi

# Written even when empty, so a consumer never sees a stale session as live.
{ [[ -z "$status_lines" ]] || printf '%s\n' "$status_lines"; } | snapshot_write sessions
{ [[ -z "$pane_lines" ]] || printf '%s\n' "$pane_lines"; } | snapshot_write panes
~/dotfiles/bin/hq-snapshot tick >/dev/null 2>&1 &

done_list=$(~/dotfiles/bin/tmux-claude-attention list 2>/dev/null)
done_count=$(printf '%s' "$done_list" | grep -c .)

want=$'\n'$(window_status_from_panes "$pane_lines" "$(printf '%s\n' "$done_list" | cut -f2)")$'\n'
opt_args=()
while IFS=$'\t' read -r _wid _cur; do
    [[ -z "$_wid" ]] && continue
    _rest="${want#*$'\n'"${_wid}"$'\t'}"
    if [[ "$_rest" == "$want" ]]; then
        [[ -n "$_cur" ]] && opt_args+=(set-option -wqu -t "$_wid" @agent_status \;)
    elif [[ "${_rest%%$'\n'*}" != "$_cur" ]]; then
        opt_args+=(set-option -wq -t "$_wid" @agent_status "${_rest%%$'\n'*}" \;)
    fi
done < <(tmux list-windows -a -F $'#{window_id}\t#{@agent_status}' 2>/dev/null)
(( ${#opt_args[@]} > 0 )) && tmux "${opt_args[@]}" 2>/dev/null

out=""
(( permission_count > 0 )) && out+="🔴${permission_count} "
(( done_count > 0 )) && out+="✅${done_count} "
(( working_count > 0 )) && out+="●${working_count} "

printf '%s' "$out"
