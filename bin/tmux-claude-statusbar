#!/usr/bin/env bash

# Ambient attention layer for the tmux status bar.
# Called by tmux every status-interval (~5s) — must stay fast (<200ms).
# Output: "🔴N ✅N ●N " — zero-count segments are omitted entirely, and an
# all-zero result prints nothing (preserves the pre-existing empty
# status-right behavior when nothing needs attention).
#   🔴 permission — sessions waiting on a permission/plan prompt
#   ✅ done       — claude PANES finished but not yet seen (Stop hook
#                   flags, per pane — see bin/tmux-claude-attention; two
#                   unseen claudes in one session count as ✅2)
#   ●  working    — sessions actively streaming output
#
# The scan itself lives in tmux-claude-lib's scan_claude_sessions: every
# pane owned by a live claude process (any window of any session — found by
# tty, because wrapper shells make pane_current_command lie) is captured in
# one batched tmux round trip and classified, aggregating worst-status per
# session (permission > working > idle). Non-claude panes are never
# captured, so a vim buffer or `git diff` showing this script's "Yes"/"No"/
# "to interrupt" literals can't false-positive by construction (the round-1
# finding that used to require an after-the-fact tty gate here). 🔴/● count
# per session (a session with two working claudes is one ●); ✅ counts per
# pane, since each flag is an independent "go look at this".
#
# Side effect: publishes per-session status to
# ~/.cache/claude-attention/status.tsv ("<session>\t<status>" per claude
# session, written atomically every tick). tmux-sessionizer reads it for its
# row colors instead of doing any pane scanning of its own at keypress time.

source ~/dotfiles/bin/tmux-claude-lib

STATUS_DIR="$HOME/.cache/claude-attention"

status_lines=$(scan_claude_sessions)

permission_count=0
working_count=0
if [[ -n "$status_lines" ]]; then
    while IFS=$'\t' read -r _name _status; do
        case "$_status" in
            permission) (( permission_count++ )) ;;
            working)    (( working_count++ )) ;;
        esac
    done <<< "$status_lines"
fi

# Publish the per-session status cache (atomic: tmp + mv). Written even when
# empty so a consumer never acts on sessions that no longer run claude; the
# sessionizer additionally ignores the file when its mtime is stale.
mkdir -p "$STATUS_DIR"
if { [[ -z "$status_lines" ]] || printf '%s\n' "$status_lines"; } > "${STATUS_DIR}/.status.$$.tmp" 2>/dev/null; then
    mv -f "${STATUS_DIR}/.status.$$.tmp" "${STATUS_DIR}/status.tsv"
fi

done_count=$(~/dotfiles/bin/tmux-claude-attention list 2>/dev/null | grep -c .)

out=""
(( permission_count > 0 )) && out+="🔴${permission_count} "
(( done_count > 0 )) && out+="✅${done_count} "
(( working_count > 0 )) && out+="●${working_count} "

printf '%s' "$out"
