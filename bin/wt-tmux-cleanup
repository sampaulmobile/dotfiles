#!/usr/bin/env bash
#
# wt-tmux-cleanup <worktree-path> <repo>
#
# worktrunk post-merge / post-remove hook: kill the removed worktree's
# tmux session. If we're currently inside it, switch to the repo's hub
# session first (creating it if needed) so the client isn't stranded.
# No-op outside tmux for the switching; still kills the stray session.

set -euo pipefail

path="${1:?usage: wt-tmux-cleanup <worktree-path> <repo>}"
repo="${2:?usage: wt-tmux-cleanup <worktree-path> <repo>}"

name=$(basename "$path" | tr . _)
hub=$(echo "$repo" | tr . _)
hub_path="$HOME/dev/$repo"

if [[ -n "${TMUX:-}" ]]; then
    current=$(tmux display-message -p '#S' 2>/dev/null || true)
    if [[ "$current" == "$name" ]]; then
        if ! tmux has-session -t="$hub" 2>/dev/null; then
            tmux new-session -ds "$hub" -c "$hub_path"
        fi
        tmux switch-client -t "$hub"
    fi
fi

tmux kill-session -t "$name" 2>/dev/null || true
exit 0
