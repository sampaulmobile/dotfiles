#!/usr/bin/env bash
# hq-snapshot — the collector behind the status screens: one TSV per source
# under ~/.local/state/hq/snapshot/.
#
# APPEND-ONLY: creates and overwrites its own files and REMOVES NOTHING
# under ~/.local/state/hq — not a stale snapshot, not its own failed
# <file>.tmp.<pid>. A failed write leaves the previous snapshot standing.

# Loaded twice in one process when something it sources sources it back
# (collect_pipelines -> bin/worktrees -> here): hand back the helpers
# already defined, else the BASH_SOURCE guard below misreads $0 as
# "executed" and runs the command line at the bottom again on the caller's $@.
if [[ -n "${HQ_SNAPSHOT_LOADED:-}" ]]; then
    return 0 2>/dev/null || true
fi
HQ_SNAPSHOT_LOADED=1

DOTFILES="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"

SNAPSHOT_DIR="${HQ_SNAPSHOT_DIR:-$HOME/.local/state/hq/snapshot}"

# INBOX_DIR's thread logs are appended to, never rewritten or removed.
INBOX_DIR="${HQ_INBOX_DIR:-$HOME/.local/state/hq/inbox}"

REAP_DIR="${HQ_REAP_DIR:-$HOME/.local/state/hq/reap}"
REAP_CADENCE=120

# <name>:<cadence seconds>. The cadence is both the tick interval a source is
# collected on and, times three, the age at which a reader stops trusting it.
# `all` walks this list BACKWARDS (slowest first), so a source that joins two
# others — inbox, over pipelines and prs — is listed before them to be
# collected after them.
SNAPSHOT_SOURCES="inbox:5 sessions:5 pipelines:5 worktrees:15 prs:30 turns:5 panes:5"

snapshot_file() { printf '%s/%s.tsv' "$SNAPSHOT_DIR" "$1"; }

# snapshot_cadence <source> — its cadence in seconds; 0 and exit 1 for a name
# that is not a source.
snapshot_cadence() {
    local s
    for s in $SNAPSHOT_SOURCES; do
        if [[ "${s%%:*}" == "$1" ]]; then printf '%s' "${s#*:}"; return 0; fi
    done
    printf '0'
    return 1
}

# snapshot_write <source> — stdin is the body. The file gets a
# `# generated <ISO time>` first line and lands with one mv, so a reader
# never sees a half-written snapshot.
snapshot_write() {
    local name="$1" f tmp
    f=$(snapshot_file "$name")
    tmp="$f.tmp.$$"
    mkdir -p "$SNAPSHOT_DIR" || return 1
    { printf '# generated %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"; cat; } > "$tmp" || return 1
    mv -f "$tmp" "$f"
}

# file_mtime <path> — its mtime in epoch seconds; exit 1 when absent.
file_mtime() {
    [[ -e "$1" ]] || return 1
    stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null
}

# snapshot_mtime <source> — its mtime in epoch seconds; exit 1 when absent.
snapshot_mtime() {
    local f
    f=$(snapshot_file "$1")
    [[ -f "$f" ]] || return 1
    file_mtime "$f"
}

# snapshot_age <source> — seconds since it was written, -1 when absent.
snapshot_age() {
    local m
    m=$(snapshot_mtime "$1") || { printf '%s' -1; return 0; }
    [[ -n "$m" ]] || { printf '%s' -1; return 0; }
    printf '%s' "$(( $(date +%s) - m ))"
}

# snapshot_verdict <age-seconds> <cadence-seconds> — fresh | stale | missing.
snapshot_verdict() {
    local age="$1" cadence="${2:-0}"
    [[ -n "$age" ]] || { printf 'missing'; return 0; }
    if (( age < 0 )); then printf 'missing'; return 0; fi
    if (( cadence > 0 )) && (( age > cadence * 3 )); then printf 'stale'; return 0; fi
    printf 'fresh'
}

fmt_secs() {
    local s="${1:-0}"
    if   (( s < 0 ));     then printf 'never'
    elif (( s < 60 ));    then printf '%ds' "$s"
    elif (( s < 3600 ));  then printf '%dm' $(( s / 60 ))
    elif (( s < 86400 )); then printf '%dh' $(( s / 3600 ))
    else                       printf '%dd' $(( s / 86400 ))
    fi
}

# snapshot_read <source> — the body, without the generated-at line. Exit 1
# when the file is not there to read.
snapshot_read() {
    local f line first=true
    f=$(snapshot_file "$1")
    [[ -r "$f" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$first" == true ]]; then
            first=false
            if [[ "$line" == '# generated '* ]]; then continue; fi
        fi
        [[ -n "$line" ]] && printf '%s\n' "$line"
    done < "$f"
    return 0
}

# inbox_slug <branch> — into $inbox_slug_out: / -> -, the same mapping
# session_name_for_branch uses, so a branch, its worktree and its thread
# agree. A thread's ONLY identity that survives
# a sweep — once the worktree is gone only the file name remains — so
# anything keyed per thread (inbox archive and seen marks included) keys by
# this, never by the real branch.
inbox_slug_out=""
inbox_slug() {
    inbox_slug_out="${1//\//-}"
}

inbox_thread_file_out=""
inbox_thread_file() {
    inbox_slug "$2"
    inbox_thread_file_out="$INBOX_DIR/$1/$inbox_slug_out.md"
}

# jsonl_last_line <file> — the last non-empty line, empty if absent or
# unreadable. Status records are append-only, so the last line is current.
jsonl_last_line() {
    local f="$1" l last=""
    [[ -r "$f" ]] || return 0
    while IFS= read -r l || [[ -n "$l" ]]; do
        [[ -n "$l" ]] && last="$l"
    done < "$f"
    printf '%s' "$last"
}

# json_field <json-line> <key> — a quoted string without its quotes, or a
# bare token as written; empty for an absent key and for null, which status
# records use for "not yet". Records are flat, one line, pipeline-written —
# a pattern match is the whole parser this needs.
json_field() {
    local line="$1" key="$2" re v
    re="\"$key\"[[:space:]]*:[[:space:]]*\"([^\"]*)\""
    if [[ "$line" =~ $re ]]; then printf '%s' "${BASH_REMATCH[1]}"; return 0; fi
    re="\"$key\"[[:space:]]*:[[:space:]]*([^,}[:space:]]+)"
    if [[ "$line" =~ $re ]]; then
        v="${BASH_REMATCH[1]}"
        [[ "$v" == null ]] || printf '%s' "$v"
    fi
    return 0
}

# pipeline_map_load — the pipelines source into the global $pipeline_map,
# one `<worktree>\t<state>` line per run in flight. Empty when never
# written; the CALLER decides whether a stale one is worth refreshing first.
pipeline_map=""
pipeline_map_load() {
    local path state
    pipeline_map=""
    while IFS=$'\t' read -r path _ _ _ state _; do
        [[ -n "$path" && -n "$state" ]] || continue
        pipeline_map+="${path}"$'\t'"${state}"$'\n'
    done < <(snapshot_read pipelines 2>/dev/null)
}

pipeline_for_cwd() {
    local cwd="$1" path state
    [[ -n "$cwd" && -n "$pipeline_map" ]] || return 0
    while IFS=$'\t' read -r path state; do
        [[ -n "$path" ]] || continue
        if [[ "$cwd" == "$path" || "$cwd" == "$path"/* ]]; then
            printf '%s' "$state"
            return 0
        fi
    done <<< "$pipeline_map"
    return 0
}

# turns_rows <pane-body> <pane-meta> <name-map> <prev-body>
#   Relies on tmux-claude-lib's find_pane_jsonl, codex_find_pane_jsonl,
#   _agent_file_mtime and get_last_exchange already being sourced (done by
#   collect_turns). <pane-body> is scan_agent_panes' line format: session,
#   pane, window_id, agent, status. Output, one line per input line:
#     session pane window agent status name mtime jsonl kind prompt from
#     reply tool pending cwd
#   (- for empty; leading fields never empty). <pane-meta> is
#   "pane_id\twindow_index\tcwd", <name-map> is "pane_num\tname" (no %),
#   <prev-body> is the previous turns snapshot's own body — all three
#   LEADING-newlined.
#
#   The mtime gate reuses a previous record's six exchange fields when a
#   pane's jsonl and mtime both match it, as ONE awk pass over <prev-body>:
#   a bash `${var#*pattern}` strip against a pane's up-to-32KB reply
#   measured SLOWER than re-parsing every transcript (same cost
#   get_agent_snippet documents for `${var//x/y}`).
turns_rows() {
    local pane_body="$1" pane_meta="$2" name_map="$3" prev_body="$4"
    local session pane _wid agent status
    local -a claude_lines=()
    while IFS=$'\t' read -r session pane _wid agent status; do
        [[ -n "$pane" ]] || continue

        local rest widx cwd name
        widx="-"; cwd="-"
        rest="${pane_meta#*$'\n'"${pane}"$'\t'}"
        if [[ "$rest" != "$pane_meta" ]]; then
            widx="${rest%%$'\t'*}"
            cwd="${rest#*$'\t'}"
            cwd="${cwd%%$'\n'*}"
            [[ -n "$widx" ]] || widx="-"
            [[ -n "$cwd" ]] || cwd="-"
        fi

        name="-"
        rest="${name_map#*$'\n'"${pane#%}"$'\t'}"
        if [[ "$rest" != "$name_map" ]]; then
            local nm="${rest%%$'\n'*}"
            [[ -n "$nm" && "$nm" != "-" && "$nm" != "$session" ]] && name="$nm"
        fi

        if [[ "$agent" == codex ]]; then
            local mtime="-" jsonl
            jsonl=$(codex_find_pane_jsonl "$pane" 2>/dev/null)
            [[ -n "$jsonl" ]] || jsonl="-"
            [[ "$jsonl" != "-" ]] && { mtime=$(_agent_file_mtime "$jsonl"); [[ -n "$mtime" ]] || mtime="-"; }
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t-\t-\t-\t-\t-\t-\t%s\n' \
                "$session" "$pane" "$widx" "$agent" "$status" "$name" "$mtime" "$jsonl" "$cwd"
        else
            local jsonl mtime="-"
            jsonl=$(find_pane_jsonl "$pane" 2>/dev/null)
            [[ -n "$jsonl" ]] || jsonl="-"
            if [[ "$jsonl" == "-" ]]; then
                printf '%s\t%s\t%s\t%s\t%s\t%s\t-\t-\t-\t-\t-\t-\t-\t-\t%s\n' \
                    "$session" "$pane" "$widx" "$agent" "$status" "$name" "$cwd"
            else
                mtime=$(_agent_file_mtime "$jsonl")
                [[ -n "$mtime" ]] || mtime="-"
                claude_lines+=("${session}"$'\t'"${pane}"$'\t'"${widx}"$'\t'"${agent}"$'\t'"${status}"$'\t'"${name}"$'\t'"${mtime}"$'\t'"${jsonl}"$'\t'"${cwd}")
            fi
        fi
    done <<< "$pane_body"

    (( ${#claude_lines[@]} == 0 )) && return 0

    local gated f1 rest15
    gated=$(awk -F'\t' -v OFS='\t' '
        FNR == NR { if ($0 != "") { prev[$1 SUBSEP $2] = $0 }; next }
        {
            key = $1 SUBSEP $2
            if ((key in prev)) {
                split(prev[key], pf, "\t")
                if (pf[7] == $7 && pf[8] == $8) {
                    print "REUSE", $1,$2,$3,$4,$5,$6,$7,$8,$9, pf[9],pf[10],pf[11],pf[12],pf[13],pf[14]
                    next
                }
            }
            print "PARSE", $1,$2,$3,$4,$5,$6,$7,$8,$9
        }
    ' <(printf '%s\n' "$prev_body") <(printf '%s\n' "${claude_lines[@]}"))

    snapshot_lines_preserve "$gated"
    local line
    for line in "${SPLIT_OUT[@]}"; do
        [[ -n "$line" ]] || continue
        f1="${line%%$'\t'*}"
        rest15="${line#*$'\t'}"
        if [[ "$f1" == REUSE ]]; then
            local session2 pane2 widx2 agent2 status2 name2 mtime2 jsonl2 cwd2 kind2 prompt2 from2 reply2 tool2 pending2
            IFS=$'\t' read -r session2 pane2 widx2 agent2 status2 name2 mtime2 jsonl2 cwd2 \
                kind2 prompt2 from2 reply2 tool2 pending2 <<< "$rest15"
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$session2" "$pane2" "$widx2" "$agent2" "$status2" "$name2" "$mtime2" "$jsonl2" \
                "$kind2" "$prompt2" "$from2" "$reply2" "$tool2" "$pending2" "$cwd2"
        else
            local session3 pane3 widx3 agent3 status3 name3 mtime3 jsonl3 cwd3
            IFS=$'\t' read -r session3 pane3 widx3 agent3 status3 name3 mtime3 jsonl3 cwd3 <<< "$rest15"
            local kind3 prompt3 from3 reply3 tool3 pending3
            IFS=$'\t' read -r kind3 prompt3 from3 reply3 tool3 pending3 < <(get_last_exchange "$jsonl3")
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$session3" "$pane3" "$widx3" "$agent3" "$status3" "$name3" "$mtime3" "$jsonl3" \
                "$kind3" "$prompt3" "$from3" "$reply3" "$tool3" "$pending3" "$cwd3"
        fi
    done
}

# snapshot_lines_preserve <text> — every line of <text>, including empty
# ones, into the global SPLIT_OUT array. No `<<<`/`< <(...)` on the result:
# bash 3.2 leaks their fd in the long-lived viewers that source this file.
snapshot_lines_preserve() {
    local text="$1" rest line
    SPLIT_OUT=()
    rest="$text"
    while :; do
        if [[ "$rest" == *$'\n'* ]]; then
            line="${rest%%$'\n'*}"
            rest="${rest#*$'\n'}"
        else
            line="$rest"
            rest=""
        fi
        SPLIT_OUT+=("$line")
        [[ -z "$rest" ]] && break
    done
}

# Nothing above this guard sets a shell option or collects anything, so a
# screen can source this file at any point.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0 2>/dev/null || true
fi

set -uo pipefail

usage() {
    cat <<'EOF'
usage: hq-snapshot <source>...      collect those sources now
       hq-snapshot all              collect every source
       hq-snapshot tick             the statusbar's entry (see below)
       hq-snapshot age [<source>]   seconds since each source was written
       hq-snapshot --check          doctor mode: every source present and fresh
                                    (inbox: present)

Sources and their cadence, one TSV each under ~/.local/state/hq/snapshot/
(override the directory with HQ_SNAPSHOT_DIR):
  sessions   5s   per-session agent status, for the sessionizer's row colors
  pipelines  5s   the last .feature/status.jsonl line of every worktree
  worktrees 15s   bin/worktrees' classification of every project
  prs       30s   bin/prs' GitHub search rows
  inbox      5s   bin/hq-inbox's threads: pipelines and prs joined to the
                  hub-written thread logs under ~/.local/state/hq/inbox
                  (override that directory with HQ_INBOX_DIR)
  turns      5s   bin/hq-feed's per-pane last exchange (prompt/reply/tool)
  panes      5s   bin/hq-feed's per-pane status, for turns to join against
                  with no second scan_agent_panes/get_claude_panes of its own

Every file starts with a `# generated <ISO time>` line. A reader treats a
snapshot older than three times its cadence as unusable and computes live.

tick is called by bin/tmux-claude-statusbar every ~5s: it collects pipelines
and turns inline and spawns the slower sources when they are due and not
already running; a tick that finds another one running exits at once. inbox
is not ticked: bin/hq-inbox recollects it when it is stale, so --check flags
it only when missing. sessions and panes are written by the statusbar
itself, which has just run the scan each publishes from — `hq-snapshot
sessions` / `hq-snapshot panes` are the standalone paths, for a machine
whose status bar is not ticking (collect_turns falls back to scanning
itself when the panes snapshot is stale or missing). tick also spawns
`hq-reap --apply` (its own last-run stamp under ~/.local/state/hq/reap gates
it, default every 120s) — hq-snapshot's own job stays collect-only; it kills
and removes nothing.

Nothing under ~/.local/state/hq is ever removed, by this script or any other.
A failed write leaves <file>.tmp.<pid> behind on purpose; to clear them, run
the deletion yourself.
EOF
}

# collect_sessions — "<session>\t<status>\t<pane>" per session with an
# agent in it.
collect_sessions() {
    # shellcheck source=/dev/null
    source "$DOTFILES/bin/tmux-claude-lib" || return 1
    scan_claude_sessions
}

# collect_panes — scan_agent_panes' own line, "<session>\t<pane>\t
# <window_id>\t<agent>\t<status>" per agent pane.
collect_panes() {
    # shellcheck source=/dev/null
    source "$DOTFILES/bin/tmux-claude-lib" || return 1
    scan_agent_panes
}

# collect_turns — joins the panes snapshot (or a live scan_agent_panes when
# stale/missing — never get_claude_panes or a second scan_agent_panes: both
# measured well over the 5s tick's ~50ms budget) to one tmux list-panes
# call for window_index/cwd.
#
# find_pane_jsonl's pane-exact lookup needs _CWD_MAP_FILE primed, else it
# falls through to a tmux display-message plus a jq scan PER CLAUDE PANE
# (measured ~150ms/pane live — the dominant cost, not get_last_exchange).
# Primed at a fixed path, replaced by mv, never removed.
collect_turns() {
    # shellcheck source=/dev/null
    source "$DOTFILES/bin/tmux-claude-lib" || return 1

    local pane_body verdict
    verdict=$(snapshot_verdict "$(snapshot_age panes)" "$(snapshot_cadence panes)")
    if [[ "$verdict" == fresh ]]; then
        pane_body=$(snapshot_read panes 2>/dev/null)
    else
        pane_body=$(scan_agent_panes)
    fi
    [[ -n "$pane_body" ]] || return 0

    _CWD_MAP_FILE="${TMPDIR:-/tmp}/hq-snapshot-cwd-map.tsv"
    jq -r '[((.tmux // "") | [scan("%[0-9]+$")] | .[0] // "-"), .cwd, .sessionId] | @tsv' \
        "${CLAUDE_SESSIONS_DIR}"/*.json 2>/dev/null > "${_CWD_MAP_FILE}.tmp.$$"
    mv -f "${_CWD_MAP_FILE}.tmp.$$" "$_CWD_MAP_FILE"

    local pane_meta name_map prev_body
    pane_meta=$'\n'"$(tmux list-panes -a -F $'#{pane_id}\t#{window_index}\t#{pane_current_path}' 2>/dev/null)"
    name_map=$'\n'"$(jq -r '[((.tmux // "") | [scan("%[0-9]+$")] | .[0] // "-"), (.name // "-")] | @tsv' \
        "${CLAUDE_SESSIONS_DIR}"/*.json 2>/dev/null)"
    prev_body=$'\n'"$(snapshot_read turns 2>/dev/null)"

    turns_rows "$pane_body" "$pane_meta" "$name_map" "$prev_body"
}

# collect_pipelines — one row per worktree running a /feature or
# /address-review pipeline:
#   <path> <session> <repo> <branch> <state> <pr> <updated>
# <state> is `<phase> r<round> <seat>`, from the LAST line of
# <path>/.feature/status.jsonl.
collect_pipelines() {
    local dir last state repo branch pr updated
    # shellcheck source=/dev/null
    source "$DOTFILES/bin/project-dirs-lib" || return 1
    # shellcheck source=/dev/null
    source "$DOTFILES/bin/worktrees" || return 1
    project_dirs
    (( ${#project_dirs_out[@]} )) || return 0
    for dir in "${project_dirs_out[@]}"; do
        state=$(pipeline_state "$dir")
        [[ -n "$state" ]] || continue
        last=$(jsonl_last_line "$dir/.feature/status.jsonl")
        worktree_branch "$dir"
        branch="$worktree_branch_out"
        repo="${worktree_repo_out:-$dir}"
        repo="${repo##*/}"
        session_name=""
        session_name_for "$dir"
        pr=$(json_field "$last" pr)
        updated=$(json_field "$last" updated)
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$dir" "$session_name" "$repo" "${branch:--}" "$state" "${pr:--}" "${updated:--}"
    done
}

collect_worktrees() {
    "$DOTFILES/bin/worktrees" --snapshot
}

collect_prs() {
    "$DOTFILES/bin/prs" --snapshot
}

# thread_facts <file> — one pass over a thread log into $thread_mtime,
# $thread_entries and $thread_headline; all three empty/0 when the file is
# not there. The headline is the first non-blank line after the LAST `## `
# header.
thread_mtime=""; thread_entries=0; thread_headline=""
thread_facts() {
    local f="$1" l want=0
    thread_mtime=""; thread_entries=0; thread_headline=""
    thread_mtime=$(file_mtime "$f") || { thread_mtime=""; return 0; }
    while IFS= read -r l || [[ -n "$l" ]]; do
        case "$l" in
            '## '*)
                thread_entries=$(( thread_entries + 1 ))
                thread_headline=""
                want=1
                ;;
            *)
                if (( want )) && [[ -n "${l//[[:space:]]/}" ]]; then
                    thread_headline="$l"
                    want=0
                fi
                ;;
        esac
    done < "$f"
    thread_headline="${thread_headline//$'\t'/ }"
}

# pr_row_tag <repo> <pr-field> <prs-map> — the bin/prs tag for the PR a
# pipelines row names, empty when the prs snapshot does not hold it.
# status.jsonl's `pr` is a URL by contract but a bare PR number in real
# data, so a number is matched too, scoped to its own repo.
pr_row_tag() {
    local repo="$1" pr="$2" map="$3" url slug num kind draft mergeable ci review
    [[ -n "$pr" && "$pr" != "-" && -n "$map" ]] || return 0
    while IFS=$'\t' read -r url slug num kind draft mergeable ci review; do
        [[ -n "$url" ]] || continue
        if [[ "$pr" != "$url" ]]; then
            [[ "$pr" == "$num" && "${slug##*/}" == "$repo" ]] || continue
        fi
        if [[ "$kind" == merged ]]; then printf 'merged'; else pr_tag "$draft" "$mergeable" "$ci" "$review"; fi
        return 0
    done <<< "$map"
    return 0
}

# collect_inbox — one row per thread, the unit bin/hq-inbox lists:
#   <worktree> <session> <repo> <branch> <state> <pr> <pr-tag>
#   <thread-mtime> <thread-entries> <headline>
# A thread log whose worktree has been swept keeps a row, with - in
# worktree, session and state, so it stays reachable until archived.
collect_inbox() {
    local line kind slug num draft mergeable ci review title url
    local path session repo branch state pr map="" tag seen=$'\n' d f b
    # shellcheck source=/dev/null
    source "$DOTFILES/bin/prs" || return 1
    while IFS= read -r line; do
        case "$line" in
            "open"$'\t'*)
                IFS=$'\t' read -r slug num draft mergeable ci review _ title url <<< "${line#open$'\t'}"
                map+="${url}"$'\t'"${slug}"$'\t'"${num}"$'\t'"open"$'\t'"${draft}"$'\t'"${mergeable}"$'\t'"${ci}"$'\t'"${review}"$'\n'
                ;;
            "merged"$'\t'*)
                IFS=$'\t' read -r slug num _ title url <<< "${line#merged$'\t'}"
                map+="${url}"$'\t'"${slug}"$'\t'"${num}"$'\t'"merged"$'\t-\t-\t-\t-'$'\n'
                ;;
        esac
    done < <(snapshot_read prs 2>/dev/null)

    while IFS=$'\t' read -r path session repo branch state pr _; do
        [[ -n "$path" && -n "$repo" ]] || continue
        [[ "$branch" == "-" ]] && branch=""
        thread_mtime=""; thread_entries=0; thread_headline=""
        if [[ -n "$branch" ]]; then
            inbox_thread_file "$repo" "$branch"
            thread_facts "$inbox_thread_file_out"
        fi
        tag=$(pr_row_tag "$repo" "$pr" "$map")
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$path" "${session:--}" "$repo" "${branch:--}" "${state:--}" \
            "${pr:--}" "${tag:--}" "${thread_mtime:--}" "$thread_entries" "${thread_headline:--}"
        inbox_slug "$branch"
        seen+="${repo}/${inbox_slug_out}"$'\n'
    done < <(snapshot_read pipelines 2>/dev/null)

    for d in "$INBOX_DIR"/*/; do
        [[ -d "$d" ]] || continue
        repo="${d%/}"; repo="${repo##*/}"
        [[ "$repo" == "_state" ]] && continue
        for f in "$d"*.md; do
            [[ -f "$f" ]] || continue
            b="${f##*/}"; b="${b%.md}"
            [[ "$seen" == *$'\n'"${repo}/${b}"$'\n'* ]] && continue
            thread_facts "$f"
            printf -- '-\t-\t%s\t%s\t-\t-\t-\t%s\t%s\t%s\n' \
                "$repo" "$b" "${thread_mtime:--}" "$thread_entries" "${thread_headline:--}"
        done
    done
}

# collect_one: the body is held in full first — a producer that fails must
# leave the previous snapshot alone rather than publish a truncated one.
collect_one() {
    local name="$1" out
    if ! declare -f "collect_$name" >/dev/null 2>&1; then
        echo "hq-snapshot: no such source: $name" >&2
        return 2
    fi
    out=$("collect_$name") || {
        echo "hq-snapshot: $name collection failed — previous snapshot left in place" >&2
        return 1
    }
    { [[ -z "$out" ]] || printf '%s\n' "$out"; } | snapshot_write "$name"
}

due() {
    local age cadence
    age=$(snapshot_age "$1")
    cadence=$(snapshot_cadence "$1") || return 0
    (( age < 0 )) && return 0
    (( age >= cadence ))
}

# already_running <source> — true when another hq-snapshot is collecting it.
# A process check, not a lock file: a lock under ~/.local/state/hq would have
# to be removed to be released, and nothing there is ever removed.
already_running() {
    pgrep -f "hq-snapshot $1\$" >/dev/null 2>&1
}

shorten_home() {
    local p="$1"
    [[ "$p" == "$HOME/"* ]] && p="~/${p#"$HOME"/}"
    printf '%s' "$p"
}

rc=0
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --check)
        miss=""
        for s in $SNAPSHOT_SOURCES; do
            name="${s%%:*}"
            v=$(snapshot_verdict "$(snapshot_age "$name")" "${s#*:}")
            [[ "$name" == inbox && "$v" == stale ]] && continue
            [[ "$v" == fresh ]] || miss+="  $name: $v"$'\n'
        done
        if [[ -n "$miss" ]]; then
            printf 'snapshot (%s) not current:\n%s' "$(shorten_home "$SNAPSHOT_DIR")" "$miss"
            echo "  fix: bin/hq-snapshot all   (the status bar keeps it current once tmux is running)"
            exit 1
        fi
        echo "snapshot: all sources fresh"
        exit 0
        ;;
    age)
        shift
        names="$*"
        if [[ -z "$names" ]]; then
            for s in $SNAPSHOT_SOURCES; do names+="${s%%:*} "; done
        fi
        for name in $names; do
            printf '%-10s %s\n' "$name" "$(fmt_secs "$(snapshot_age "$name")")"
        done
        exit 0
        ;;
    all)
        rev=""
        for s in $SNAPSHOT_SOURCES; do rev="$s $rev"; done
        for s in $rev; do
            collect_one "${s%%:*}" || rc=1
        done
        exit "$rc"
        ;;
    tick)
        # One tick at a time: a tick that finds the lock held exits at once.
        # lockf's lock dies with its process, and -k keeps the file, so
        # nothing is ever removed to release it.
        if [[ -z "${HQ_SNAPSHOT_TICK_LOCKED:-}" ]]; then
            HQ_SNAPSHOT_TICK_LOCKED=1 exec lockf -k -s -t 0 \
                "${TMPDIR:-/tmp}/hq-snapshot-tick.lock" "$0" tick
        fi
        collect_one pipelines || rc=1
        collect_one turns || rc=1
        for s in worktrees prs; do
            declare -f "collect_$s" >/dev/null 2>&1 || continue
            due "$s" || continue
            already_running "$s" && continue
            ( "$0" "$s" >/dev/null 2>&1 & )
        done
        # hq-reap takes its own lock, so a tick overlapping an already-running
        # reap is a no-op, not a second pass.
        reap_mtime=$(file_mtime "$REAP_DIR/last-run") || reap_mtime=-1
        if [[ "$reap_mtime" == -1 ]] || (( $(date +%s) - reap_mtime >= REAP_CADENCE )); then
            ( "$DOTFILES/bin/hq-reap" --apply >/dev/null 2>&1 & )
        fi
        exit "$rc"
        ;;
    "")
        usage >&2
        exit 2
        ;;
esac

for name in "$@"; do
    collect_one "$name" || rc=1
done
exit "$rc"
