# ===== HISTORY =====

HISTFILE=$HOME/.zsh_history

# if were running in docker (dev)
if [ ! -z "$DOCKER_DEV" ]; then
    hist_dir="$HOME/zsh_history"
    [ ! -d $hist_dir ] && mkdir $hist_dir

    HISTFILE="$hist_dir/.zsh_history"
    RG_HISTFILE="$hist_dir/.zsh_history"
fi

if [ -d "$HOME/dropbox/!public" ]; then
    hist_dir="${HOME}/dropbox/!public/history"
    [ ! -d $hist_dir ] && mkdir $hist_dir

    HOSTNAME_SHORT=$(hostname -s)
    HISTFILE="${hist_dir}/$(date -u +%Y-%m-%d.%H.%M.%S)_${HOSTNAME_SHORT}_$$"
fi

HISTSIZE=100000
SAVEHIST=100000

# Overwrite ZSH's history to show timestamps
alias history='fc -i -l 1'

# keep dupes in the flat $HISTFILE fallback (harmless; atuin does its own ranking)
unsetopt HIST_IGNORE_DUPS
unsetopt HIST_EXPIRE_DUPS_FIRST
# setopt HIST_IGNORE_ALL_DUPS
# setopt HIST_REDUCE_BLANKS
# setopt HIST_SAVE_NO_DUPS
# setopt HIST_FIND_NO_DUPS

# When executing a hist entry, fill in the line before executing
setopt HIST_VERIFY

# If a line starts with a space, don't save it.
setopt HIST_IGNORE_SPACE
setopt HIST_NO_STORE

# Most of these are covered by ZSH already
# setopt APPEND_HISTORY
# setopt SHARE_HISTORY # share history between multiple shells
# setopt INC_APPEND_HISTORY
# setopt EXTENDED_HISTORY


# ===== atuin — sqlite-backed history + Ctrl+R (replaces the old fzf picker) =====
# atuin records into ~/.local/share/atuin (append-only, so a stray
# truncation can't wipe history the way the flat file could) and binds
# Ctrl+R to its fuzzy search. Config: ~/.config/atuin/config.toml (local
# only, no sync). --disable-up-arrow keeps zsh's native up-arrow — atuin
# takes only Ctrl+R. The flat $HISTFILE above stays as a plaintext fallback
# and as atuin's import source.
if command -v atuin &>/dev/null; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi
