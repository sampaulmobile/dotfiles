{
  "description": "tmux attention layer: flag finished turns for deck's Feed (see notes/codex.md)",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dotfiles/bin/tmux-claude-attention flag-done",
            "async": true
          }
        ]
      }
    ]
  }
}
