{
  "description": "deck's hook events: done (the Feed lists the pane DONE until its window is visited) and permission (the bell and notification); see notes/codex.md",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deck hook done",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "deck hook permission",
            "async": true
          }
        ]
      }
    ]
  }
}
