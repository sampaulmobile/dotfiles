###### ===== THE BEST ZSHRC FILE EVER by Sam Paul ===== ######
DOTFILES=$HOME/dotfiles
DOTS=$DOTFILES/dots
SOURCES=$DOTFILES/sources
NOT_PUBLIC=$HOME/Dropbox/!Public
typeset -U path

# ===== HOMBREW ========
[[ -f "/opt/homebrew/bin/brew" ]] && eval $(/opt/homebrew/bin/brew shellenv)

# auto-launch tmux
if [[ -z $TMUX ]]; then
    tmux new-session -A -s base && return
fi

# ===== OH-MY-ZSH ========
ZSH=$HOME/.oh-my-zsh

# ZSH_THEME="sampaul"
# so oh-my-zsh doesnt complain about zsh perms
ZSH_DISABLE_COMPFIX=true
plugins=( 
    zsh-syntax-highlighting
    # zsh-autosuggestions
)
# bindkey '^ ' autosuggest-accept
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source $ZSH/oh-my-zsh.sh

# ===== SHELL GIT-STATUS =====
# [[ -d "$HOME/.zsh-git-prompt" ]] && source $HOME/.zsh-git-prompt/zshrc.sh
# [[ -d "$HOME/.zsh-git-prompt/.stack-work" ]] && GIT_PROMPT_EXECUTABLE="haskell"
# ZSH_THEME_GIT_PROMPT_CHANGED="%{$FG[009]%}%{✚%G%}"

# ===== PYENV =====
[[ -d "$HOME/.pyenv" ]] && eval "$(pyenv init --path)"
[[ $(command -v pyenv-virtualenv) ]] && eval "$(pyenv virtualenv-init -)"

# ===== FZF =====
set -o vi
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_OPTS='--height 40% --reverse'

# ===== VI-MODE =====
bindkey -v
bindkey -M viins 'jj' vi-cmd-mode #map jj to exit (mimic ESC)
# backspace and ^h working even after returning from command mode
bindkey '^?' backward-delete-char
bindkey '^h' backward-delete-char
# fix multiline prompt redraw on mode switch
function zle-keymap-select {
  zle reset-prompt
  zle -R
}
zle -N zle-keymap-select

# ===== HISTORY =====
[[ -f "$SOURCES/history" ]] && source $SOURCES/history

# ===== ALIASES =====
[[ -f "$SOURCES/aliases" ]] && source $SOURCES/aliases

# ===== MACHINE-LOCAL ALIASES (untracked — see other/README.md) =====
[[ -f "$DOTFILES/other/aliases.local" ]] && source "$DOTFILES/other/aliases.local"

# ===== EXPORTS (/PATH) =====
export PATH="$HOME/dotfiles/bin:$PATH"

# ===== FNM =====
command -v fnm &>/dev/null && eval "$(fnm env)"

# ===== WORKTRUNK =====
# Session-jump semantics: `wt switch` never cd's this pane — the
# post-switch hook (see dots/worktrunk.toml) lands us in the worktree's
# tmux session instead. --no-cd suppresses worktrunk's own navigation.
# NOTE: new branches base off LOCAL main — `git pull` the hub first,
# same discipline as plain `git checkout -b`.
if command -v wt &>/dev/null; then
    wt() {
        if [[ "$1" == "switch" ]]; then
            shift
            command wt switch --no-cd "$@"
        else
            command wt "$@"
        fi
    }
fi

# run starship
eval "$(starship init zsh)"

# Add RVM to PATH for scripting. Make sure this is the last PATH variable change.
# export PATH="$PATH:$HOME/.rvm/bin"

# rbenv setup
if command -v rbenv &>/dev/null; then
  export PATH="$HOME/.rbenv/bin:$PATH"
  eval "$(rbenv init - zsh)"
fi

# Add FVM to PATH
[[ -d "$HOME/fvm/default/bin" ]] && export PATH="$HOME/fvm/default/bin:$PATH"

# OpenClaw Completion
[[ -f "$HOME/.openclaw/completions/openclaw.zsh" ]] && source "$HOME/.openclaw/completions/openclaw.zsh"

# ===== MACHINE-LOCAL OVERRIDES =====
# untracked, lives in other/ — see other/README.md. Keep last so it can
# override anything above.
[[ -f "$DOTFILES/other/zshrc.local" ]] && source "$DOTFILES/other/zshrc.local"

